{
  "name": "molumen-website",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Mo Lumen Astrology — static site built with Astro, deployed on Cloudflare Pages.",
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node scripts/gen-page-dates.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:links": "linkinator ./dist --recurse --silent",
    "test:a11y": "pa11y-ci",
    "audit": "node scripts/audit.mjs",
    "audit:a11y": "node scripts/axe-sweep.mjs",
    "audit:lh": "node scripts/lh-audit.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^5.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.0",
    "axe-core": "^4.12.1",
    "lighthouse": "^13.4.1",
    "playwright": "^1.62.1",
    "potrace": "^2.1.8",
    "prettier": "^3.0.0",
    "prettier-plugin-astro": "^0.14.0",
    "svgo": "^4.0.2",
    "typescript": "^5.5.0"
  }
}
