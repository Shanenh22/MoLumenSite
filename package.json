{
  "name": "molumen-website",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Mo Lumen Astrology — static site built with Astro, deployed on Cloudflare Pages.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
