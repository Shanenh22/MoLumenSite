---
import Icon from './Icon.astro';
interface Props {
  heading?: string;
  body?: string;
  buttonLabel?: string;
  buttonHref?: string;
  /** Accessible name when the visible primary label needs more context. */
  buttonAriaLabel?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
  secondary?: boolean;
}

const path = Astro.url.pathname;

/**
 * The closer should match the visitor's likely intent, not treat every page as
 * the last step before checkout. Explicit props always win; these are only the
 * defaults for pages that use the shared band without choosing their own next
 * step.
 */
const defaults = (() => {
  if (path === '/explore/') {
    return {
      heading: 'Not sure where to begin?',
      body: 'Start with the foundations, then follow whatever makes you curious. The pieces are learnable; the whole becomes meaningful in relationship.',
      buttonLabel: 'Start Here',
      buttonHref: '/start-here/',
      secondaryLabel: 'Or look at what is happening now',
      secondaryHref: '/current-sky/',
    };
  }

  if (path.startsWith('/explore/') || path === '/start-here/' || path.startsWith('/tools/')) {
    return {
      heading: 'Keep following the thread',
      body: 'One placement or technique is a beginning. Explore how the pieces relate before asking any one of them to explain the whole chart.',
      buttonLabel: 'Explore Astrology',
      buttonHref: '/explore/',
      secondaryLabel: 'See how Mo looks at the current sky',
      secondaryHref: '/current-sky/',
    };
  }

  if (path === '/current-sky/calendar/') {
    return {
      heading: 'Want the story behind the dates?',
      body: 'The calendar gives you the timing. Current Sky adds the pattern, the questions it raises, and the distinction between shared symbolism and personal interpretation.',
      buttonLabel: 'Read Current Sky',
      buttonHref: '/current-sky/',
      secondaryLabel: "Get Mo's monthly note",
      secondaryHref: '/newsletter/',
    };
  }

  if (path.startsWith('/current-sky/') || path === '/horoscopes/') {
    return {
      heading: 'Keep following the sky',
      body: 'Notice the pattern, learn the cycle, and keep your own chart and circumstances in the conversation.',
      buttonLabel: 'See the Sky Calendar',
      buttonHref: '/current-sky/calendar/',
      secondaryLabel: "Get Mo's monthly note",
      secondaryHref: '/newsletter/',
    };
  }

  if (
    path === '/about/' ||
    path === '/approach/' ||
    path === '/credentials/' ||
    path === '/testimonials/'
  ) {
    return {
      heading: 'Want to know what a reading actually feels like?',
      body: 'The next useful step is not checkout. See how Mo prepares, what happens in the conversation, and where your own experience enters the interpretation.',
      buttonLabel: 'How Readings Work',
      buttonHref: '/how-readings-work/',
      secondaryLabel: 'Not sure what would fit? Try the Reading Finder',
      secondaryHref: '/reading-finder/',
    };
  }

  return {
    heading: 'Ready to see your chart in a new light?',
    body: 'Sessions are one-on-one with Mo. Choose a reading, pick a time, and come with your questions.',
    buttonLabel: 'Book a Reading',
    buttonHref: '/book/',
    secondaryLabel: 'Not sure which one? Find your reading',
    secondaryHref: '/reading-finder/',
  };
})();

const props = Astro.props as Props;
const heading = props.heading ?? defaults.heading;
const body = props.body ?? defaults.body;
const buttonLabel = props.buttonLabel ?? defaults.buttonLabel;
const buttonHref = props.buttonHref ?? defaults.buttonHref;
const buttonAriaLabel = props.buttonAriaLabel;
const secondaryLabel = props.secondaryLabel ?? defaults.secondaryLabel;
const secondaryHref = props.secondaryHref ?? defaults.secondaryHref;
const secondary = props.secondary ?? true;

const sameTarget = secondaryHref === buttonHref;
const showSecondary = secondary && !sameTarget;
---

<section class="section section--night center">
  <div class="container flow">
    <div class="divider"><Icon name="star" size={18} /></div>
    <h2>{heading}</h2>
    <p class="lede" style="margin-inline: auto; color: var(--color-stone);">{body}</p>
    <p class="cta-band__primary">
      <a class="btn btn--accent" href={buttonHref} aria-label={buttonAriaLabel}>{buttonLabel}</a>
    </p>
    {
      showSecondary && (
        <p class="cta-band__secondary">
          <a href={secondaryHref}>{secondaryLabel} →</a>
        </p>
      )
    }
  </div>
</section>

<style>
  .cta-band__secondary a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  @media (max-width: 480px) {
    .cta-band__primary .btn {
      width: 100%;
    }

    .cta-band__secondary a {
      padding-block: var(--space-2);
    }
  }
</style>
