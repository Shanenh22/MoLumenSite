---
/**
 * The next few lunations, with whole-sign-house guidance for each rising sign.
 *
 * Nothing here is new content. `houseFor()` is arithmetic on whole-sign houses
 * and the passages are the same guidance used on the individual event pages.
 * All twelve signs remain server-rendered; the picker only changes what is most
 * useful to see first, and on mobile it keeps the chosen sign in view without a
 * long twelve-card scroll.
 */
import { getCollection } from 'astro:content';
import { guidanceForEvent, ordinal } from '../data/lunation-guidance';
import { isSkyEventPublished } from '../lib/sky-publishing';
import RisingSignPicker from './RisingSignPicker.astro';

const now = new Date();
const upcoming = (await getCollection('skyEvents'))
  .filter(
    (e) =>
      isSkyEventPublished(e.data, now) &&
      (e.data.eventType === 'lunation' || e.data.eventType === 'eclipse') &&
      e.data.start >= now
  )
  .sort((a, b) => a.data.start.valueOf() - b.data.start.valueOf())
  .slice(0, 3)
  .map((e) => ({
    slug: e.id.replace(/\.mdx?$/, ''),
    title: e.data.title,
    start: e.data.start,
    guidance: guidanceForEvent(e.data.eventType, e.data.title, e.data.sign),
  }))
  .filter((e) => e.guidance.length > 0);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
---

{
  upcoming.length > 0 && (
    <section class="section section--sea" id="whats-coming-for-you">
      <div class="container">
        <div class="prose flow" style="margin-bottom: var(--space-6);">
          <h2>Where the next lunations fall for your rising sign</h2>
          <p>
            Choose your rising sign to see the whole-sign house each upcoming lunation occupies and
            the life area that house describes.
          </p>
          <p class="card__meta">
            This is a broad structural lens, not a personal forecast. The rest of your chart, the
            exact contacts involved, other timing factors, and your lived circumstances can change
            the meaning considerably.
          </p>
        </div>

        <RisingSignPicker context="horoscopes" />

        {upcoming.map((e) => (
          <div class="next-lunation">
            <h3>
              <a href={`/current-sky/events/${e.slug}/`}>{e.title}</a>
            </h3>
            <p class="card__meta">{fmt(e.start)}</p>
            <div class="grid grid--3" data-rising-grid>
              {e.guidance.map((g, i) => (
                <article class="card" data-sign={g.slug} data-order={i}>
                  <p class="card__yours" data-yours-badge hidden>
                    Yours
                  </p>
                  <p class="card__meta" style="margin: 0;">
                    {ordinal(g.house)} house, {g.arena}
                  </p>
                  <h4 style="font-size: var(--text-lg); margin: 0;">
                    <a href={`/explore/signs/${g.slug}/`}>{g.sign} rising</a>
                  </h4>
                  <p style="margin: 0;">{g.text}</p>
                </article>
              ))}
            </div>
          </div>
        ))}

        <p class="card__meta" style="margin-top: var(--space-8);">
          If one of these patterns has raised a real personal question, the
          <a href="/reading-finder/">Reading Finder</a> can help you decide whether a reading fits
          and which kind would be useful.
        </p>
      </div>
    </section>
  )
}
