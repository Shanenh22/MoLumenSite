---
import { footerNav, policyNav } from '../config/navigation';
import { site } from '../config/site';
import NewsletterForm from './NewsletterForm.astro';
import LogoMark from './LogoMark.astro';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <p style="margin: 0 0 var(--space-4);">
          <LogoMark height={52} tone="gold" />
        </p>
        <p style="max-width: 34ch; color: var(--color-stone);">
          {site.description}
        </p>
        {/*
          A location in the footer, on every page. The E-E-A-T audit scored
          Trustworthiness down because nothing on the site told a visitor where
          this practice operates from — the strongest signal available to a
          one-person online business short of a street address, which a
          home-based practice should not publish.
        */}
        <p>
          <a href={`mailto:${site.email}`}>{site.email}</a><br />
          <span style="color: var(--color-stone);">Based in the Dallas–Fort Worth Metroplex</span
          ><br />
          <a href={site.social.instagram} rel="noopener">Instagram</a> ·
          <a href={site.social.facebook} rel="noopener">Facebook</a>
        </p>
        <h2 id="footer-newsletter">A monthly note from Mo</h2>
        <p style="color: var(--color-stone); max-width: 38ch;">
          The current sky is one part of it. I also write about questions, patterns, and whatever
          has made me stop and look more closely that month.
        </p>
        <NewsletterForm source="footer" dark labelledby="footer-newsletter" />
      </div>
      {
        Object.entries(footerNav).map(([heading, links]) => (
          <nav class="footer-nav-desktop" aria-label={`Footer: ${heading}`}>
            <h3>{heading}</h3>
            <ul>
              {links.map((link) => (
                <li>
                  <a href={link.href}>{link.label}</a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    {/*
      On phones, four fully expanded footer groups made the bottom of every
      page another long navigation screen after the reader had already reached
      the end of the content. The primary mobile menu already exposes the main
      architecture. These disclosures keep the footer destinations available
      without making every visitor scroll through all of them.

      Desktop keeps the existing four-column navigation unchanged.
    */}
    <nav class="footer-nav-mobile" aria-label="Footer navigation">
      {
        Object.entries(footerNav).map(([heading, links]) => (
          <details>
            <summary>{heading}</summary>
            <ul>
              {links.map((link) => (
                <li>
                  <a href={link.href}>{link.label}</a>
                </li>
              ))}
            </ul>
          </details>
        ))
      }
    </nav>

    <div class="footer-legal">
      <nav aria-label="Policies">
        <ul class="footer-policies">
          {policyNav.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))}
          {/*
            A consent choice you cannot revisit is not a choice. This sits in
            the policy row on every page and reopens the banner in place.
            Rendered only when analytics is configured, so it never advertises
            a control that would do nothing. ConsentBanner.astro binds it by
            the data attribute and returns focus here on close.
          */}
          {site.integrations.ga4Id && (
            <li>
              <button class="consent-reopen" type="button" data-consent-reopen>
                Cookie choices
              </button>
            </li>
          )}
        </ul>
      </nav>
      <p>
        © {year}
        {site.legalName}. Astrology offers perspective, not certainty. See the
        <a href="/disclaimer/">disclaimer</a>. Readings are not medical, psychological, legal, or
        financial advice. For adults 18+.
      </p>
    </div>
  </div>
</footer>

<style>
  .footer-nav-mobile {
    display: none;
  }

  @media (max-width: 767px) {
    .footer-nav-desktop {
      display: none;
    }

    .footer-nav-mobile {
      display: block;
      margin-top: var(--space-8);
      border-top: 1px solid rgb(250 246 238 / 0.15);
    }

    .footer-nav-mobile details {
      border-bottom: 1px solid rgb(250 246 238 / 0.15);
    }

    .footer-nav-mobile summary {
      display: flex;
      align-items: center;
      justify-content: space-between;
      min-height: 52px;
      padding-block: var(--space-3);
      cursor: pointer;
      color: var(--color-ivory);
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      list-style: none;
    }

    .footer-nav-mobile summary::-webkit-details-marker {
      display: none;
    }

    .footer-nav-mobile summary::after {
      content: '+';
      font-size: 1.25rem;
      font-weight: 400;
      color: var(--color-gold-soft);
    }

    .footer-nav-mobile details[open] summary::after {
      content: '−';
    }

    .footer-nav-mobile ul {
      list-style: none;
      margin: 0;
      padding: 0 0 var(--space-3);
      display: grid;
      gap: var(--space-1);
    }

    .footer-nav-mobile li {
      margin: 0;
    }

    .footer-nav-mobile a {
      display: flex;
      align-items: center;
      min-height: 44px;
      padding-inline: var(--space-2);
    }
  }
</style>
