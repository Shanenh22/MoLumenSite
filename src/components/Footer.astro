---
import { footerNav, policyNav } from '../config/navigation';
import { site } from '../config/site';
import NewsletterForm from './NewsletterForm.astro';
import LogoMark from './LogoMark.astro';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <p style="margin: 0 0 var(--space-4);">
          <LogoMark height={52} tone="gold" />
        </p>
        <p style="max-width: 34ch; color: var(--color-stone);">
          {site.description}
        </p>
        {/*
          A location in the footer, on every page. The E-E-A-T audit scored
          Trustworthiness down because nothing on the site told a visitor where
          this practice operates from — the strongest signal available to a
          one-person online business short of a street address, which a
          home-based practice should not publish.
        */}
        <p>
          <a href={`mailto:${site.email}`}>{site.email}</a><br />
          <span style="color: var(--color-stone);">Based in the Dallas–Fort Worth Metroplex</span
          ><br />
          <a href={site.social.instagram} rel="noopener">Instagram</a> ·
          <a href={site.social.facebook} rel="noopener">Facebook</a>
        </p>
        <h2 id="footer-newsletter">The Sky This Month — free newsletter</h2>
        <p style="color: var(--color-stone); max-width: 38ch;">
          What's moving overhead, what it means, and one practical thing to do about it. No spam,
          ever.
        </p>
        <NewsletterForm source="footer" dark labelledby="footer-newsletter" />
      </div>
      {
        Object.entries(footerNav).map(([heading, links]) => (
          <nav aria-label={`Footer: ${heading}`}>
            <h3>{heading}</h3>
            <ul>
              {links.map((link) => (
                <li>
                  <a href={link.href}>{link.label}</a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>
    <div class="footer-legal">
      <nav aria-label="Policies">
        <ul class="footer-policies">
          {policyNav.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))}
          {/*
            A consent choice you cannot revisit is not a choice. This sits in
            the policy row on every page and reopens the banner in place.
            Rendered only when analytics is configured, so it never advertises
            a control that would do nothing. ConsentBanner.astro binds it by
            the data attribute and returns focus here on close.
          */}
          {site.integrations.ga4Id && (
            <li>
              <button class="consent-reopen" type="button" data-consent-reopen>
                Cookie choices
              </button>
            </li>
          )}
        </ul>
      </nav>
      <p>
        © {year}
        {site.legalName}. Astrology offers perspective, not certainty — see the
        <a href="/disclaimer/">disclaimer</a>. Readings are not medical, psychological, legal, or
        financial advice. For adults 18+.
      </p>
    </div>
  </div>
</footer>
