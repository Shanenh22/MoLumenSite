---
/**
 * Reusable newsletter signup using Kit.
 *
 * Kit recommends its JavaScript embed for normal website use. Because this
 * component can appear more than once on a generated page, the small loader
 * below initializes the real Kit form only once per document. Any secondary
 * instance remains an accessible CTA to /newsletter/ instead of executing the
 * same third-party embed repeatedly.
 *
 * The `source` value is used only for analytics (no personal data).
 */
import { site } from '../config/site';
interface Props {
  source: string;
  dark?: boolean;
  labelledby?: string;
}
const { source, labelledby } = Astro.props;
const uid = site.integrations.kitFormUid;
const scriptUrl = site.integrations.kitFormScriptUrl;
---

<div
  class="newsletter-form newsletter-form--kit"
  data-newsletter
  data-source={source}
  data-kit-form-host
  aria-labelledby={labelledby}
>
  <p class="kit-form-fallback">
    <a class="btn btn--accent" href="/newsletter/">Join the newsletter</a>
  </p>
</div>

<script is:inline define:vars={{ uid, scriptUrl, source }}>
  (() => {
    const current = document.currentScript;
    const host = current?.previousElementSibling;
    if (!(host instanceof HTMLElement) || !host.matches('[data-kit-form-host]')) return;

    /**
     * Analytics is attached per instance, before the single-load guard below,
     * because every instance is a real conversion surface: the one that renders
     * the Kit form and the ones that stay a link to /newsletter/. Measuring only
     * the first would attribute all newsletter interest to whichever block
     * happens to appear earliest in the DOM.
     *
     * `submit` is delegated on the host rather than bound to the form, because
     * Kit injects its markup asynchronously and there is nothing to bind to
     * yet. Nothing about the subscriber is captured — only which block on which
     * page prompted it. The email never leaves the form, and mlTrack's
     * sanitiser would drop it even if a future edit tried to pass it.
     */
    host.addEventListener('click', (e) => {
      if (e.target instanceof Element && e.target.closest('.kit-form-fallback a')) {
        window.mlTrack?.('newsletter_cta_click', { source });
      }
    });
    host.addEventListener(
      'submit',
      () => window.mlTrack?.('newsletter_signup_intent', { source }),
      true
    );

    if (window.__molumenKitFormLoaded) return;
    window.__molumenKitFormLoaded = true;

    const fallback = host.querySelector('.kit-form-fallback');
    if (fallback) fallback.remove();

    const embed = document.createElement('script');
    embed.async = true;
    embed.dataset.uid = uid;
    embed.src = scriptUrl;
    embed.addEventListener('error', () => {
      host.innerHTML = '<p class="kit-form-fallback"><a class="btn btn--accent" href="/newsletter/">Join the newsletter</a></p>';
    });
    host.appendChild(embed);
  })();
</script>

<style is:global>
  .newsletter-form--kit .kit-form-fallback {
    margin: 0;
  }

  .newsletter-form--kit .formkit-form {
    width: 100%;
    max-width: none;
    margin: 0;
  }

  .newsletter-form--kit .formkit-fields {
    display: flex;
    gap: var(--space-2, 0.75rem);
    align-items: stretch;
    flex-wrap: wrap;
  }

  .newsletter-form--kit .formkit-field {
    flex: 1 1 14rem;
    margin: 0;
  }

  .newsletter-form--kit .formkit-input {
    width: 100%;
    min-height: 2.75rem;
    font: inherit;
  }

  .newsletter-form--kit .formkit-submit {
    min-height: 2.75rem;
    cursor: pointer;
  }
</style>
