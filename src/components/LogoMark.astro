---
/**
 * Mo Lumen Astrology logo lockup using the owner-supplied SVG artwork.
 *
 * The source artwork arrived on a large transparent square. The committed SVG
 * uses a tight viewBox, so the same visual height takes substantially less
 * horizontal space in the sticky header and remains comfortable on phones.
 */
interface Props {
  /** Overall rendered height in px of the lockup */
  height?: number;
  tone?: 'ink' | 'gold' | 'ivory';
  class?: string;
}
const { height = 48, tone = 'ink', class: className } = Astro.props;
const aspectRatio = 175 / 69;
const width = Math.round(height * aspectRatio);
---

<span
  class:list={['logo-lockup', `logo-lockup--${tone}`, className]}
  style={`--logo-width: ${width}px; --logo-height: ${height}px;`}
>
  <img
    src="/images/mo-lumen-logo.svg"
    alt="Mo Lumen Astrology"
    width={175}
    height={69}
    decoding="async"
  />
</span>

<style>
  .logo-lockup {
    display: inline-flex;
    width: var(--logo-width);
    max-width: 100%;
    line-height: 0;
  }

  .logo-lockup img {
    display: block;
    width: 100%;
    height: auto;
    max-height: var(--logo-height);
  }

  /* The supplied blue artwork belongs on the light site header. On the dark
     mobile menu and footer, a neutral ivory treatment keeps the same artwork
     legible without introducing a new visual accent or changing those surfaces. */
  .logo-lockup--gold img,
  .logo-lockup--ivory img {
    filter: brightness(0) invert(1);
    opacity: 0.96;
  }
</style>
