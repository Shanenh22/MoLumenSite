---
/**
 * Hand-drawn-style celestial line icons, original artwork in the brand's
 * moodboard spirit. Stroke inherits currentColor; sized via `size` prop.
 */
interface Props {
  name: keyof typeof paths;
  size?: number;
  class?: string;
  label?: string; // provide for meaningful icons; omit = decorative
}
const { name, size = 28, label, class: className } = Astro.props;

const paths: Record<string, string> = {
  // sun with rays
  sun: 'M16 9.5a6.5 6.5 0 1 1 0 13 6.5 6.5 0 0 1 0-13Zm0-7v4M16 25.5v4M2.5 16h4M25.5 16h4M6.5 6.5l2.8 2.8M22.7 22.7l2.8 2.8M25.5 6.5l-2.8 2.8M9.3 22.7l-2.8 2.8',
  // crescent moon + star
  moon: 'M20.5 3.5a11.5 11.5 0 1 0 8 19.7A12.6 12.6 0 0 1 16 11.4c0-3 1.7-6 4.5-7.9ZM24 6l.9 2.3L27 9l-2.1.9L24 12l-.9-2.1L21 9l2.1-.7L24 6Z',
  // ringed planet
  planet: 'M16 8a8 8 0 1 1 0 16 8 8 0 0 1 0-16Zm12-2c2 3-4.5 8.5-11 12S4.5 23 2.7 20M28 6c-1.5-2.2-6 .3-7.5 1.3',
  // four-point star
  star: 'M16 3l2.6 8.4L27 14l-8.4 2.6L16 25l-2.6-8.4L5 14l8.4-2.6L16 3Z',
  // chart wheel
  chart: 'M16 3a13 13 0 1 1 0 26 13 13 0 0 1 0-26Zm0 5a8 8 0 1 1 0 16 8 8 0 0 1 0-16Zm-13 8h5m16 0h5M16 3v5m0 16v5M6.8 6.8l3.5 3.5m11.4 11.4 3.5 3.5m0-18.4-3.5 3.5M10.3 21.7l-3.5 3.5',
  // heart
  heart: 'M16 27S4 19.5 4 11.7C4 7.4 7.2 4.5 10.7 4.5c2.2 0 4.2 1.1 5.3 3 1.1-1.9 3.1-3 5.3-3 3.5 0 6.7 2.9 6.7 7.2C28 19.5 16 27 16 27Z',
  // compass / direction
  compass: 'M16 3a13 13 0 1 1 0 26 13 13 0 0 1 0-26Zm5.5 7.5-3.2 8.2-8.2 3.2 3.2-8.2 8.2-3.2Zm-5.5 5a.6.6 0 1 1 0 1.2.6.6 0 0 1 0-1.2Z',
  // calendar / timing
  calendar: 'M5 7h22v20H5V7Zm0 6h22M10 3v6m12-6v6m-9 8 2.5 2.5L21 20',
  // clock
  clock: 'M16 3a13 13 0 1 1 0 26 13 13 0 0 1 0-26Zm0 5v8l5.5 3.5',
  // sprouting leaf / growth
  leaf: 'M16 28V14m0 0C16 8 20 4 27 4c0 7-4 11-11 10Zm0 4c0-4.5-3-7.5-8.5-7.5C7.5 15 10.5 18 16 18Z',
  // mountains / journey
  mountains: 'M2 25 11 9l5 8 4-6 8 14H2Zm13-8 3 4M20 11l1.6-2.4',
  // open letter
  letter: 'M4 11 16 4l12 7v14H4V11Zm0 0 12 8 12-8M4 25l9-8m15 8-9-8',
  // play / video
  video: 'M16 3a13 13 0 1 1 0 26 13 13 0 0 1 0-26Zm-3 8 8 5-8 5V11Z',
  // spark / insight
  spark: 'M16 4v7m0 10v7M4 16h7m10 0h7M9 9l4 4m6 6 4 4m0-14-4 4m-6 6-4 4',
  // two figures / relationship
  people: 'M11 8.5a3.8 3.8 0 1 1 0 7.6 3.8 3.8 0 0 1 0-7.6Zm10 2a3.2 3.2 0 1 1 0 6.4 3.2 3.2 0 0 1 0-6.4ZM3.5 26c0-4.4 3.3-7.5 7.5-7.5s7.5 3.1 7.5 7.5M17.7 20.4c1-.9 2.2-1.4 3.8-1.4 3.6 0 6 2.6 6 6',
  // open book / learning
  book: 'M16 7c-2.5-2-6-3-11-3v20c5 0 8.5 1 11 3 2.5-2 6-3 11-3V4c-5 0-8.5 1-11 3Zm0 0v20',
  // hand holding star / choice
  choice: 'M16 3l1.8 4.6L22.5 9l-4.7 1.4L16 15l-1.8-4.6L9.5 9l4.7-1.4L16 3ZM5 20c3-2 6-2 8.5-.5L18 22c1.5.8 1.5 2.5-.5 3l-4 1M27 20c-2 3-5 6-9.5 6.5L13 27',
};
const d = paths[name] ?? paths.star;
---

<svg
  class:list={['icon', className]}
  width={size}
  height={size}
  viewBox="0 0 32 32"
  fill="none"
  stroke="currentColor"
  stroke-width="1.7"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
>
  <path d={d}></path>
</svg>
