---
interface Item {
  label: string;
  href: string;
  note?: string;
}

interface Props {
  heading?: string;
  items: Item[];
}

const { heading = 'Go straight to what you need', items } = Astro.props;
---

<nav class="page-jumps" aria-label={heading}>
  <p class="page-jumps__heading">{heading}</p>
  <div class="page-jumps__grid">
    {items.map((item) => (
      <a class="page-jumps__item" href={item.href}>
        <strong>{item.label}</strong>
        {item.note && <span>{item.note}</span>}
      </a>
    ))}
  </div>
</nav>

<style>
  .page-jumps {
    margin-block: var(--space-8);
  }

  .page-jumps__heading {
    margin: 0 0 var(--space-4);
    font-weight: 700;
  }

  .page-jumps__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
  }

  .page-jumps__item {
    display: flex;
    min-height: 4.75rem;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-1);
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--border-color, currentColor);
    border-radius: var(--radius-lg, 1rem);
    text-decoration: none;
  }

  .page-jumps__item span {
    font-size: var(--text-sm);
  }

  @media (min-width: 640px) {
    .page-jumps__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 960px) {
    .page-jumps__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
