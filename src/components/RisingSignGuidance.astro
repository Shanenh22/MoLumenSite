---
/**
 * Rising-sign guidance for a lunation or eclipse — all twelve signs.
 *
 * The house placement is calculated with whole-sign houses. The page states
 * that method clearly so this layer is presented for what it is: a broad
 * house-based lens, not a bespoke personal forecast.
 *
 * Renders nothing for retrogrades and other event types that do not have a
 * lunation sign to map through the twelve houses.
 */
import { guidanceForEvent, ordinal } from '../data/lunation-guidance';
import RisingSignPicker from './RisingSignPicker.astro';

interface Props {
  eventType: string;
  title: string;
  sign?: string;
}
const { eventType, title, sign } = Astro.props;
const guidance = guidanceForEvent(eventType, title, sign);
const isEclipse = eventType === 'eclipse';
---

{
  guidance.length > 0 && (
    <section class="section section--sea" id="by-rising-sign">
      <div class="container">
        <div class="prose flow" style="margin-bottom: var(--space-8);">
          <p class="eyebrow">A rising-sign lens</p>
          <h2>Where this falls by rising sign</h2>
          <p>
            Your <strong>rising sign</strong> places this {isEclipse ? 'eclipse' : 'lunation'} in a
            particular whole-sign house, showing a broad area of life to watch. I keep the guidance
            broad on purpose so you can recognize the symbolism within your own circumstances rather
            than assigning everyone with the same rising sign the same specific experience.
          </p>
          <p>
            Choose your rising sign below. Don't know it? <a href="/birth-time/">Start with your birth time</a>.
          </p>
        </div>

        <RisingSignPicker context="event" />

        <div class="grid grid--3" data-rising-grid>
          {guidance.map((g, i) => (
            <article class="card" data-sign={g.slug} data-order={i}>
              <p class="card__yours" data-yours-badge hidden>
                Yours
              </p>
              <p class="card__meta" style="margin: 0;">
                {ordinal(g.house)} house: {g.arena}
              </p>
              <h3 style="font-size: var(--text-lg); margin: 0;">
                <a href={`/explore/signs/${g.slug}/`}>{g.sign} rising</a>
              </h3>
              <p style="margin: 0;">{g.text}</p>
            </article>
          ))}
        </div>

        <p class="card__meta" style="margin-top: var(--space-6);">
          This is a broad <a href="/explore/house-systems/">whole-sign-house</a> lens, not a personal
          forecast. The house shows an area of life; it does not tell us the specific event that will
          happen there or how important this event will be in your chart. Exact contacts, other timing
          factors, and your lived circumstances add the specificity. If this has raised a real question,
          the <a href="/reading-finder/">Reading Finder</a> can help you decide whether a reading fits.
        </p>
      </div>
    </section>
  )
}
