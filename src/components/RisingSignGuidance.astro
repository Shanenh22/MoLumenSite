---
/**
 * Rising-sign guidance for a lunation or eclipse — all twelve signs.
 *
 * The house placement is calculated with whole-sign houses. The page states
 * that method clearly so this layer is presented for what it is: a broad
 * house-based lens, not a bespoke personal forecast.
 *
 * Renders nothing for retrogrades and other event types that do not have a
 * lunation sign to map through the twelve houses.
 */
import { guidanceForEvent, ordinal } from '../data/lunation-guidance';
import RisingSignPicker from './RisingSignPicker.astro';

interface Props {
  eventType: string;
  title: string;
  sign?: string;
}
const { eventType, title, sign } = Astro.props;
const guidance = guidanceForEvent(eventType, title, sign);
const isEclipse = eventType === 'eclipse';
---

{
  guidance.length > 0 && (
    <section class="section section--sea" id="by-rising-sign">
      <div class="container">
        <div class="prose flow" style="margin-bottom: var(--space-8);">
          <h2>A rising-sign lens</h2>
          <p>
            Choose your <strong>rising sign</strong> below to see which whole-sign house contains
            this {isEclipse ? 'eclipse' : 'lunation'}. If you don't know your rising sign, it
            depends on an accurate birth time, and
            <a href="/prepare-for-your-reading/"> here's how to track that down</a>.
          </p>
          <p class="card__meta">
            This is intentionally broad. I use <a href="/explore/house-systems/">whole-sign houses</a>
            for this public rising-sign layer, which lets us identify the life area emphasized by
            the sign of the {isEclipse ? 'eclipse' : 'lunation'}. It does not tell me what will
            happen to you, whether the event will be important, or how the rest of your chart
            changes the picture. You can also read your Sun sign as a secondary symbolic lens, but
            the house placement shown here is calculated from the rising sign.
          </p>
        </div>

        <RisingSignPicker context="event" />

        <div class="grid grid--3" data-rising-grid>
          {guidance.map((g, i) => (
            <article class="card" data-sign={g.slug} data-order={i}>
              <p class="card__yours" data-yours-badge hidden>
                Yours
              </p>
              <p class="card__meta" style="margin: 0;">
                {ordinal(g.house)} house: {g.arena}
              </p>
              <h3 style="font-size: var(--text-lg); margin: 0;">
                <a href={`/explore/signs/${g.slug}/`}>{g.sign} rising</a>
              </h3>
              <p style="margin: 0;">{g.text}</p>
            </article>
          ))}
        </div>

        <p class="card__meta" style="margin-top: var(--space-6);">
          This layer stops at the house. A personal reading adds the exact degree, natal contacts,
          other timing factors, and the life you are actually living. If that is what you need, a
          <a href="/readings/monthly-transits/"> personal transits reading</a> goes further.
        </p>
      </div>
    </section>
  )
}
