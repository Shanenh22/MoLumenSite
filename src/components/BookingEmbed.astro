---
/**
 * Cal.com booking embed.
 *
 * Three deliberate choices:
 *
 * 1. The embed loads ONLY when the visitor asks for it. Cal.com's script is a
 *    third party; loading it on page view would put a tracker-capable script on
 *    the page for everyone who merely reads the booking page, and would cost
 *    the LCP/CLS numbers the rest of the site works to protect. Same pattern as
 *    the video embeds.
 * 2. Nothing sensitive is ever put in the embed URL. No birth date, no birth
 *    time, no birthplace, no name, no email. Those are collected by Cal.com's
 *    own intake form over HTTPS. The project brief forbids birth data in URLs
 *    and this is the one component where it would be tempting.
 * 3. It degrades in three steps: inline embed → direct Cal.com link in a new
 *    tab → plain email to Mo. Every step is reachable by keyboard, and the
 *    email path is visible before anything loads, because referral clients
 *    often prefer it.
 */
import { site } from '../config/site';

interface Bookable {
  key: string;
  name: string;
  duration: string;
  price: string | null;
  event: string;
}

interface Props {
  calUser: string;
  services: Record<string, Bookable>;
}
const { calUser, services } = Astro.props;
const configured = calUser.trim().length > 0;
---

<div class="booking-pane">
  <h2 id="pick-a-time">Pick a time</h2>

  {
    configured ? (
      <div class="booking-embed" data-embed-root data-cal-user={calUser}>
        <div class="booking-embed__prompt" data-embed-prompt>
          <p>
            Choose your reading on the left, then load the calendar to see Mo's available times in
            your own time zone. Payment is taken at booking.
          </p>
          <button class="btn btn--accent" type="button" data-load-embed aria-controls="cal-mount">
            Show available times
          </button>
          <p class="card__meta" style="margin-top: var(--space-3);">
            Loads Cal.com, which handles scheduling and payment. Nothing loads until you press the
            button.
          </p>
        </div>
        <div id="cal-mount" data-cal-mount aria-live="polite" />
      </div>
    ) : (
      <div class="card booking-embed__pending">
        <p>
          <strong>Online scheduling is being set up.</strong> Until it's live, email Mo and she'll
          find a time with you — usually within a day.
        </p>
        <p style="margin: 0;">
          <a class="btn btn--accent" href={`mailto:${site.email}?subject=Booking%20a%20reading`}>
            Email {site.email}
          </a>
        </p>
      </div>
    )
  }

  <p class="card__meta booking-pane__note">
    {configured && (
      <>
        If the calendar doesn't load,{' '}
        <a data-booking-fallback href={`https://cal.com/${calUser}`} rel="noopener" target="_blank">
          open the booking page in a new tab
        </a>
        .{' '}
      </>
    )}
    Prefer to talk first? Referral clients often do — just <a href={`mailto:${site.email}`}>email Mo</a>{' '}
    and she'll take it from there.
  </p>
</div>

<script>
  type Bookable = { key: string; name: string; event: string };

  const root = document.querySelector<HTMLElement>('[data-embed-root]');
  const radios = document.querySelectorAll<HTMLInputElement>('input[name="booking-service"]');
  const fallback = document.querySelector<HTMLAnchorElement>('[data-booking-fallback]');
  const servicesEl = document.querySelector<HTMLElement>('[data-services]');
  const bookables: Record<string, Bookable> = JSON.parse(servicesEl?.dataset.services || '{}');
  const calUser = root?.dataset.calUser || '';

  const track = (event: string, params: Record<string, string> = {}) =>
    (window as any).gtag?.('event', event, params);

  function selectedKey(): string {
    const checked = document.querySelector<HTMLInputElement>(
      'input[name="booking-service"]:checked',
    );
    return checked?.value || Object.keys(bookables)[0] || '';
  }

  /** Cal.com event slug for the current choice. One radio == one event type. */
  function selectedEvent(): string {
    const key = selectedKey();
    return bookables[key]?.event || key;
  }

  function updateFallback() {
    if (fallback && calUser) fallback.href = `https://cal.com/${calUser}/${selectedEvent()}`;
  }

  /**
   * Cal.com's official loader stub. This has to exist BEFORE embed.js runs:
   * embed.js does not define `window.Cal` itself, it drains a queue that this
   * stub creates. Loading the script on its own — which an earlier version of
   * this file did — leaves `window.Cal` undefined and the calendar never
   * appears. Taken from Cal.com's documented embed snippet.
   */
  function ensureCalLoader() {
    (function (C: any, A: string, L: string) {
      const p = (a: any, ar: any) => {
        a.q.push(ar);
      };
      const d = C.document;
      C.Cal =
        C.Cal ||
        function (...args: any[]) {
          const cal = C.Cal;
          if (!cal.loaded) {
            cal.ns = {};
            cal.q = cal.q || [];
            d.head.appendChild(d.createElement('script')).src = A;
            cal.loaded = true;
          }
          if (args[0] === L) {
            const api: any = function (...a: any[]) {
              p(api, a);
            };
            const namespace = args[1];
            api.q = api.q || [];
            if (typeof namespace === 'string') {
              cal.ns[namespace] = api;
              p(api, args);
            } else {
              p(cal, args);
            }
            return;
          }
          p(cal, args);
        };
    })(window as any, 'https://app.cal.com/embed/embed.js', 'init');
  }

  function showEmbedFailure(mount: HTMLElement) {
    mount.innerHTML = '';
    const p = document.createElement('p');
    p.className = 'card__meta';
    p.textContent = 'The calendar could not load. ';
    const a = document.createElement('a');
    a.href = calUser ? `https://cal.com/${calUser}/${selectedEvent()}` : 'mailto:mo@molumen.com';
    a.target = '_blank';
    a.rel = 'noopener';
    a.textContent = 'Open the booking page in a new tab';
    p.appendChild(a);
    mount.appendChild(p);
    track('booking_embed_failed', { service: selectedKey() });
  }

  let calLoaded = false;
  let failureTimer = 0;

  function mountEmbed() {
    const mount = document.querySelector<HTMLElement>('[data-cal-mount]');
    const prompt = document.querySelector<HTMLElement>('[data-embed-prompt]');
    if (!mount || !calUser) return;

    mount.classList.add('is-loading');
    mount.textContent = 'Loading available times…';

    ensureCalLoader();
    const Cal = (window as any).Cal;
    if (typeof Cal !== 'function') {
      showEmbedFailure(mount);
      return;
    }

    mount.innerHTML = '';
    try {
      Cal('init', { origin: 'https://cal.com' });
      Cal('inline', {
        elementOrSelector: '#cal-mount',
        calLink: `${calUser}/${selectedEvent()}`,
        layout: 'month_view',
      });
      // Match the site's accent so the calendar doesn't read as a bolted-on
      // third-party widget.
      Cal('ui', {
        theme: 'light',
        styles: { branding: { brandColor: '#0f6e6b' } },
        hideEventTypeDetails: false,
        layout: 'month_view',
      });
    } catch {
      showEmbedFailure(mount);
      return;
    }

    calLoaded = true;
    if (prompt) prompt.hidden = true;
    mount.classList.remove('is-loading');
    track('booking_embed_open', { service: selectedKey() });

    // Cal renders asynchronously. Give it room, then check something arrived
    // rather than leaving the visitor staring at an empty box.
    window.clearTimeout(failureTimer);
    failureTimer = window.setTimeout(() => {
      if (mount.childElementCount === 0) showEmbedFailure(mount);
    }, 15000);
  }

  // Pre-select from ?service= (set by CTAs on the service pages). Accepts the
  // event key, and falls back to the first choice belonging to a service slug.
  const requested = new URLSearchParams(location.search).get('service');
  if (requested) {
    const match = bookables[requested]
      ? requested
      : Object.keys(bookables).find((k) => k.startsWith(requested));
    if (match) radios.forEach((r) => (r.checked = r.value === match));
  }

  updateFallback();
  track('booking_start');

  radios.forEach((r) =>
    r.addEventListener('change', () => {
      updateFallback();
      if (calLoaded) mountEmbed(); // reload the calendar for the new reading
    }),
  );

  document.querySelector('[data-load-embed]')?.addEventListener('click', () => mountEmbed());
  fallback?.addEventListener('click', () => track('booking_external_fallback'));
</script>
