---
import { primaryNav, ctaNav } from '../config/navigation';
import Icon from './Icon.astro';
import LogoMark from './LogoMark.astro';
const current = Astro.url.pathname;
const isWithin = (href?: string) =>
  Boolean(href && (current === href || (href !== '/' && current.startsWith(href))));
const navState = (href?: string) =>
  href && current === href ? 'page' : isWithin(href) ? 'location' : undefined;
const groupIsCurrent = (group: (typeof primaryNav)[number]) =>
  isWithin(group.href) || Boolean(group.children?.some((link) => isWithin(link.href)));
const navIcons: Record<string, string> = {
  Readings: 'chart',
  'Explore Astrology': 'book',
  'Current Sky': 'moon',
  'From Mo': 'sun',
  Search: 'search',
};
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href="/" aria-label="Mo Lumen Astrology, home">
      <LogoMark height={46} tone="ink" />
    </a>

    <nav class="nav-desktop" aria-label="Primary">
      <ul>
        {
          primaryNav.map((group) =>
            group.children ? (
              <li data-nav-group data-current={groupIsCurrent(group) ? 'true' : undefined}>
                <button type="button" aria-expanded="false">
                  {group.label}
                  <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true">
                    <path d="M1 3l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" />
                  </svg>
                </button>
                <ul class="submenu">
                  {group.children.map((link) => (
                    <li>
                      <a href={link.href} aria-current={navState(link.href)}>{link.label}</a>
                    </li>
                  ))}
                </ul>
              </li>
            ) : (
              <li data-current={groupIsCurrent(group) ? 'true' : undefined}>
                <a href={group.href} aria-current={navState(group.href)}>{group.label}</a>
              </li>
            )
          )
        }
      </ul>
    </nav>

    <a class="btn btn--accent header-cta" href={ctaNav.href} aria-label={ctaNav.label}>
      <span class="header-cta__long">{ctaNav.label}</span>
      <span class="header-cta__short">Book</span>
    </a>

    <button class="nav-toggle" type="button" aria-haspopup="dialog" data-open-mobile-nav>
      <svg width="20" height="14" viewBox="0 0 20 14" aria-hidden="true">
        <path d="M0 1h20M0 7h20M0 13h20" stroke="currentColor" stroke-width="2" />
      </svg>
      Menu
    </button>
  </div>

  <dialog class="mobile-nav" aria-label="Site navigation">
    <div class="mobile-nav__inner">
      <div class="mobile-nav__top">
        <a class="brand" href="/" aria-label="Mo Lumen Astrology, home">
          <LogoMark height={44} tone="gold" />
        </a>
        <button class="nav-toggle" type="button" data-close-mobile-nav>
          <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
            <path d="M2 2l12 12M14 2L2 14" stroke="currentColor" stroke-width="2" />
          </svg>
          Close
        </button>
      </div>
      <nav aria-label="Mobile">
        <ul>
          {
            primaryNav.map((group, i) => {
              const active = groupIsCurrent(group);
              return group.children ? (
                <li data-current={active ? 'true' : undefined}>
                  <button
                    type="button"
                    class="mobile-group"
                    aria-expanded={active}
                    aria-controls={`mnav-${i}`}
                  >
                    <span class="mobile-nav__label">
                      <span class="nav-icon"><Icon name={navIcons[group.label] as any} size={22} /></span>
                      {group.label}
                    </span>
                    <svg width="14" height="14" viewBox="0 0 10 10" aria-hidden="true">
                      <path d="M1 3l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" />
                    </svg>
                  </button>
                  <ul class="submenu-mobile" id={`mnav-${i}`} hidden={!active}>
                    {group.children.map((link) => (
                      <li>
                        <a href={link.href} aria-current={navState(link.href)}>{link.label}</a>
                      </li>
                    ))}
                  </ul>
                </li>
              ) : (
                <li data-current={active ? 'true' : undefined}>
                  <a href={group.href} aria-current={navState(group.href)}>
                    <span class="mobile-nav__label">
                      <span class="nav-icon"><Icon name={navIcons[group.label] as any} size={22} /></span>
                      {group.label}
                    </span>
                  </a>
                </li>
              );
            })
          }
        </ul>
      </nav>
      <a class="btn btn--accent mobile-nav__book" href={ctaNav.href}>{ctaNav.label}</a>
    </div>
  </dialog>
</header>

<script>
  // Desktop dropdowns: one section at a time, Escape/outside-click to close.
  const groups = document.querySelectorAll<HTMLElement>('[data-nav-group]');
  groups.forEach((li) => {
    const btn = li.querySelector('button')!;
    btn.addEventListener('click', () => {
      const open = li.dataset.open === 'true';
      groups.forEach((g) => {
        g.dataset.open = 'false';
        g.querySelector('button')!.setAttribute('aria-expanded', 'false');
      });
      li.dataset.open = String(!open);
      btn.setAttribute('aria-expanded', String(!open));
    });
  });
  document.addEventListener('click', (e) => {
    if (!(e.target as Element).closest('[data-nav-group]')) {
      groups.forEach((g) => {
        g.dataset.open = 'false';
        g.querySelector('button')!.setAttribute('aria-expanded', 'false');
      });
    }
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      groups.forEach((g) => {
        g.dataset.open = 'false';
        g.querySelector('button')!.setAttribute('aria-expanded', 'false');
      });
    }
  });

  // Mobile nav uses <dialog>. Keep it accordion-like so opening Current Sky,
  // Explore, or Readings does not turn a phone menu into several screens of
  // simultaneous submenus. The current section still opens by default.
  const dialog = document.querySelector<HTMLDialogElement>('.mobile-nav');
  const opener = document.querySelector<HTMLButtonElement>('[data-open-mobile-nav]');
  if (dialog && opener) {
    opener.addEventListener('click', () => {
      dialog.showModal();
      dialog.scrollTop = 0;
      document.documentElement.style.overflow = 'hidden';
    });
    dialog.addEventListener('close', () => {
      document.documentElement.style.overflow = '';
      opener.focus();
    });
    dialog.querySelector('[data-close-mobile-nav]')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
    dialog.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => dialog.close()));

    const mobileGroups = [...dialog.querySelectorAll<HTMLButtonElement>('.mobile-group')];
    mobileGroups.forEach((btn) => {
      btn.addEventListener('click', () => {
        const expanded = btn.getAttribute('aria-expanded') === 'true';

        mobileGroups.forEach((other) => {
          if (other === btn) return;
          other.setAttribute('aria-expanded', 'false');
          const otherPanel = document.getElementById(other.getAttribute('aria-controls')!);
          if (otherPanel) otherPanel.hidden = true;
        });

        btn.setAttribute('aria-expanded', String(!expanded));
        const panel = document.getElementById(btn.getAttribute('aria-controls')!);
        if (panel) panel.hidden = expanded;
      });
    });
  }
</script>
