---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CTABand from '../../components/CTABand.astro';

const articles = (await getCollection('articles'))
  .filter((a) => !a.data.draft)
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const crumbs = [{ label: 'Articles', href: '/articles/' }];
---

<BaseLayout
  title="Articles"
  description="Essays and guides from Mo Lumen Astrology: choosing an astrologer, understanding readings, and living thoughtfully with a chart."
  path="/articles/"
  breadcrumbs={crumbs}
>
  <Breadcrumbs crumbs={crumbs} />
  <section class="hero">
    <div class="container">
      <p class="eyebrow">Essays & guides</p>
      <h1>Articles</h1>
      <p class="lede">Longer-form writing: the questions behind the readings.</p>
    </div>
  </section>
  <section class="section">
    <div class="container">
      {
        articles.length > 0 ? (
          <div class="grid grid--2">
            {articles.map((a) => (
              <article class="card">
                <p class="card__meta" style="margin: 0;">
                  {fmt(a.data.publishDate)} · {a.data.category}
                </p>
                <h2 style="font-size: var(--text-xl); margin: 0;">
                  <a href={`/articles/${a.id.replace(/\.mdx?$/, '')}/`}>{a.data.title}</a>
                </h2>
                <p style="margin: 0;">{a.data.description}</p>
              </article>
            ))
          }
          </div>
        ) : (
          <p>
            First essays are in the works. Meanwhile, the
            <a href="/explore/">Explore Astrology</a> hub and
            <a href="/current-sky/">Current Sky</a> are full of reading.
          </p>
        )
      }
    </div>
  </section>
  <CTABand />
</BaseLayout>
