---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import CTABand from '../../../components/CTABand.astro';
import Layers from '../../../components/Layers.astro';
import SeaBreak from '../../../components/SeaBreak.astro';
import { bandFor } from '../../../config/images';
import { planets } from '../../../data/planets';

export function getStaticPaths() {
  return planets.map((p) => ({ params: { slug: p.slug }, props: { planet: p } }));
}
const { planet: p } = Astro.props;
const i = planets.findIndex((x) => x.slug === p.slug);
const prev = planets[(i + planets.length - 1) % planets.length];
const next = planets[(i + 1) % planets.length];
const crumbs = [
  { label: 'Explore Astrology', href: '/explore/' },
  { label: 'The Planets', href: '/explore/planets/' },
  { label: p.name, href: `/explore/planets/${p.slug}/` },
];
const heroImage = bandFor(p.slug);
const breakImage = bandFor(p.slug, 5);
---

<BaseLayout
  title={`${p.name} in Astrology: meaning, dignities, and cycle`}
  description={`${p.name}: ${p.drive.slice(0, 120)} Traditional and modern perspectives, dignities, cycle, and how this planetary function changes in context.`}
  path={`/explore/planets/${p.slug}/`}
  breadcrumbs={crumbs}
>
  <Breadcrumbs crumbs={crumbs} />
  <section class="hero hero--split">
    <div class="container">
      <div>
        <p class="eyebrow">The Planets</p>
        <h1><span aria-hidden="true">{p.glyph}</span> {p.name}</h1>
        <p class="lede">{p.drive}</p>
      </div>
      <img class="hero__img" src={heroImage.src} srcset={heroImage.srcset} sizes="100vw" alt={heroImage.alt} width={heroImage.width} height={heroImage.height} fetchpriority="high" />
    </div>
  </section>

  <section class="section">
    <div class="container prose flow">
      <p>
        Start with the planet's function, then resist the temptation to stop there. A planet changes
        expression through its sign, house, aspects, rulerships, condition, and relationship to the
        rest of the chart. The material below gives you the vocabulary; the chart supplies the context.
      </p>
      <h2>At a glance</h2>
      <table class="ref-table">
        <caption class="visually-hidden">Attributes of {p.name}</caption>
        <tbody>
          <tr><th scope="row">Type</th><td>{p.classification}</td></tr>
          <tr><th scope="row">Cycle</th><td>{p.cycle}</td></tr>
          <tr><th scope="row">Retrograde</th><td>{p.retrograde}</td></tr>
          {p.sect && <tr><th scope="row">Sect</th><td>{p.sect}</td></tr>}
          <tr><th scope="row">Rules</th><td>{p.rules}</td></tr>
          {p.exaltation && <tr><th scope="row">Exaltation</th><td>{p.exaltation}</td></tr>}
          {p.detriment && <tr><th scope="row">Detriment</th><td>{p.detriment}</td></tr>}
          {p.fall && <tr><th scope="row">Fall</th><td>{p.fall}</td></tr>}
          {p.joy && <tr><th scope="row">Joy</th><td>{p.joy}</td></tr>}
          <tr><th scope="row">Glyph</th><td><span class="glyph-cell" aria-hidden="true">{p.glyph}</span>: {p.glyphMeaning}</td></tr>
        </tbody>
      </table>
      <p class="card__meta">
        Cycle figures are astronomical approximations. Dignities follow the Ptolemaic tables.
        See <a href="/explore/dignities/">essential dignities</a>. "Joy" refers to a traditional
        house association for the planet.
      </p>
    </div>
  </section>

  <SeaBreak image={breakImage} />

  <section class="section section--sea">
    <div class="container prose flow">
      <Layers kind="traditional"><p>{p.traditional}</p></Layers>
      <Layers kind="modern"><p>{p.modern}</p></Layers>
      <Layers kind="mo"><p>{p.mo}</p></Layers>
      {p.differs && <Layers kind="differs"><p>{p.differs}</p></Layers>}
      <Layers kind="misconception"><p set:html={p.misconception} /></Layers>
    </div>
  </section>

  <section class="section">
    <div class="container prose flow">
      <h2>In your chart</h2>
      <p>{p.inYourChart}</p>
      <h2>When this function is emphasized</h2>
      <p>{p.whenItLeads}</p>
      <h2>Working with it</h2>
      <p>{p.workingWithIt}</p>
      <p>
        The useful next question is always contextual: what sign is {p.name} in, which house does it
        occupy, what <a href="/explore/aspects/">aspects</a> does it make, what does it rule, and
        what else is happening in the chart? No planet means the same thing in every life.
      </p>

      <nav aria-label="More planets" class="reference-pager">
        <a href={`/explore/planets/${prev.slug}/`}>← {prev.name}</a>
        <a href={`/explore/planets/${next.slug}/`}>{next.name} →</a>
      </nav>
    </div>
  </section>

  <CTABand
    heading={`Keep ${p.name.replace('The ', '')} in the whole chart`}
    body="You now have one piece of the vocabulary. Keep learning how planets, signs, houses, and aspects modify one another before turning a single placement into a conclusion."
    buttonLabel="Explore the Planets"
    buttonHref="/explore/planets/"
    secondaryLabel="See how the pieces fit together"
    secondaryHref="/explore/birth-chart-basics/"
  />
</BaseLayout>
