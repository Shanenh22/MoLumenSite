---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ocean } from '../../config/images';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CTABand from '../../components/CTABand.astro';

const terms = (await getCollection('glossary')).sort((a, b) =>
  a.data.term.localeCompare(b.data.term)
);
const letters = [...new Set(terms.map((t) => t.data.term.charAt(0).toUpperCase()))];
const termsByLetter = letters.map((letter) => ({
  letter,
  terms: terms.filter((term) => term.data.term.charAt(0).toUpperCase() === letter),
}));
const crumbs = [
  { label: 'Explore Astrology', href: '/explore/' },
  { label: 'Glossary', href: '/explore/glossary/' },
];
---

<BaseLayout
  title="Astrology Glossary: plain-language definitions"
  description="Every astrology term used on this site, defined in plain language: ascendant, aspects, houses, lunations, retrogrades, synastry, transits, and more."
  path="/explore/glossary/"
  breadcrumbs={crumbs}
>
  <Breadcrumbs crumbs={crumbs} />
  <section class="hero hero--split">
    <div class="container">
      <div>
        <p class="eyebrow">Reference</p>
        <h1>Glossary</h1>
        <p class="lede">
          Astrology has a large vocabulary. Use this page when a term interrupts your reading; you
          do not need to memorize the language before you can understand the idea. {terms.length}
          terms and growing.
        </p>
      </div>
      <img
        class="hero__img"
        src={ocean.shellsBeforeTide.src}
        srcset={ocean.shellsBeforeTide.srcset}
        sizes="100vw"
        alt={ocean.shellsBeforeTide.alt}
        width={ocean.shellsBeforeTide.width}
        height={ocean.shellsBeforeTide.height}
        fetchpriority="high"
      />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="card flow" style="margin-bottom: var(--space-8);">
        <p class="eyebrow">Find a term</p>
        <label for="glossary-search"><strong>Search the glossary</strong></label>
        <input
          id="glossary-search"
          type="search"
          placeholder="Try ascendant, transit, synastry…"
          autocomplete="off"
          data-glossary-search
          style="width: 100%; max-width: 38rem;"
        />
        <p class="card__meta" data-glossary-status aria-live="polite">
          Showing all {terms.length} terms.
        </p>
        <nav aria-label="Glossary letters" style="display: flex; flex-wrap: wrap; gap: var(--space-2);">
          {letters.map((letter) => (
            <a class="btn btn--ghost" style="padding: .45rem .7rem;" href={`#letter-${letter}`}>
              {letter}
            </a>
          ))}
        </nav>
        <noscript>
          <p class="card__meta">Search needs JavaScript; the full alphabetical glossary remains below.</p>
        </noscript>
      </div>

      <div class="prose" data-glossary-list>
        {
          termsByLetter.map(({ letter, terms: letterTerms }) => (
            <section data-glossary-letter>
              <p id={`letter-${letter}`} class="eyebrow" style="padding-top: var(--space-4);">
                {letter}
              </p>
              <dl>
                {letterTerms.map((t) => (
                  <div
                    id={t.data.id}
                    data-glossary-term
                    data-search={`${t.data.term} ${t.data.definition}`.toLowerCase()}
                    style="margin-bottom: var(--space-6);"
                  >
                    <dt style="font-family: var(--font-serif); font-size: var(--text-lg); font-weight: 600;">
                      {t.data.term}
                    </dt>
                    <dd style="margin: var(--space-2) 0 0;">
                      {t.data.definition}
                      {t.data.learnLink && (
                        <>
                          {' '}
                          <a href={t.data.learnLink}>See it in context →</a>
                        </>
                      )}
                    </dd>
                  </div>
                ))}
              </dl>
            </section>
          ))
        }
        <p data-glossary-empty hidden>
          I do not have that term in the glossary yet. Try a shorter word, or use
          <a href="/explore/"> Explore Astrology</a> to browse by topic.
        </p>
      </div>
    </div>
  </section>

  <CTABand
    heading="A definition is the beginning, not the interpretation."
    body="When you know the word, follow it into the larger system. Explore Astrology connects the terms to the relationships that make a chart meaningful."
    buttonLabel="Explore by Topic"
    buttonHref="/explore/"
    secondaryLabel="Start with chart structure"
    secondaryHref="/explore/birth-chart-basics/"
  />

  <script>
    const input = document.querySelector('[data-glossary-search]');
    const rows = [...document.querySelectorAll('[data-glossary-term]')];
    const letterGroups = [...document.querySelectorAll('[data-glossary-letter]')];
    const status = document.querySelector('[data-glossary-status]');
    const empty = document.querySelector('[data-glossary-empty]');

    if (input instanceof HTMLInputElement && status && empty) {
      input.addEventListener('input', () => {
        const query = input.value.trim().toLowerCase();
        let visible = 0;
        rows.forEach((row) => {
          const match = !query || (row.getAttribute('data-search') || '').includes(query);
          row.toggleAttribute('hidden', !match);
          if (match) visible += 1;
        });
        letterGroups.forEach((group) => {
          const hasVisibleTerm = [...group.querySelectorAll('[data-glossary-term]')].some(
            (row) => !row.hasAttribute('hidden')
          );
          group.toggleAttribute('hidden', !hasVisibleTerm);
        });
        empty.toggleAttribute('hidden', visible !== 0);
        status.textContent = query
          ? `${visible} ${visible === 1 ? 'term' : 'terms'} match “${input.value.trim()}”.`
          : `Showing all ${rows.length} terms.`;
      });
    }
  </script>
</BaseLayout>