---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { photos, scenes } from '../../../config/images';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { signs } from '../../../data/signs';
const crumbs = [
  { label: 'Explore Astrology', href: '/explore/' },
  { label: 'The 12 Signs', href: '/explore/signs/' },
];
---

<BaseLayout
  title="The 12 Zodiac Signs — styles of expression"
  description="The twelve zodiac signs are styles, not verdicts: how planets express themselves. Elements, modalities, rulers, and honest strengths and growth edges for every sign."
  path="/explore/signs/"
  breadcrumbs={crumbs}
>
  <Breadcrumbs crumbs={crumbs} />
  <section class="hero hero--split">
    <div class="container">
      <div>
      <p class="eyebrow">Explore Astrology</p>
      <h1>The 12 signs</h1>
      <p class="lede">
        Signs are styles of expression — the "how" of the chart. You aren't just one sign; every
        chart contains all twelve, each coloring whatever planets and houses fall within it. The
        signs organize by element (fire, earth, air, water) and modality (cardinal, fixed,
        mutable) — two grids worth learning once, useful forever.
      </p>
      </div>
      <img
        class="hero__img"
        src={scenes.signs.src}
        srcset={scenes.signs.srcset}
        sizes="100vw"
        alt={scenes.signs.alt}
        width={scenes.signs.width}
        height={scenes.signs.height}
        fetchpriority="high"
      />
    </div>
  </section>

  <section class="section">
    <div class="container grid grid--3">
      {
        signs.map((s) => (
          <article class="card">
            <span class="glyph" aria-hidden="true">{s.glyph}</span>
            <h2 style="font-size: var(--text-xl); margin: 0;">
              <a href={`/explore/signs/${s.slug}/`}>{s.name}</a>
            </h2>
            <p class="card__meta">
              {s.element} · {s.modality} · ruled by {s.ruler}
            </p>
            <p style="margin: 0;">{s.keywords.join(' · ')}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section section--alt">
    <div class="container prose flow">
      <h2>Related</h2>
      <p>
        The twelve signs are generated by two simple grids —
        <a href="/explore/elements-and-modalities/">elements and modalities</a>. From there, see
        which <a href="/explore/planets/">planets</a> rule and are exalted in each sign on the
        <a href="/explore/dignities/">essential dignities</a> page, or start with
        <a href="/explore/the-big-three/">the big three</a> if you're new.
      </p>
    </div>
  </section>
</BaseLayout>
