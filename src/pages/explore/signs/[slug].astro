---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import CTABand from '../../../components/CTABand.astro';
import Layers from '../../../components/Layers.astro';
import SeaBreak from '../../../components/SeaBreak.astro';
import { bandFor } from '../../../config/images';
import { signs } from '../../../data/signs';

export function getStaticPaths() {
  return signs.map((s) => ({ params: { slug: s.slug }, props: { sign: s } }));
}
const { sign: s } = Astro.props;
const i = signs.findIndex((x) => x.slug === s.slug);
const prev = signs[(i + signs.length - 1) % signs.length];
const next = signs[(i + 1) % signs.length];
const opposite = signs.find((x) => x.name === s.opposite);
const crumbs = [
  { label: 'Explore Astrology', href: '/explore/' },
  { label: 'The 12 Signs', href: '/explore/signs/' },
  { label: s.name, href: `/explore/signs/${s.slug}/` },
];
const heroImage = bandFor(s.slug);
const breakImage = bandFor(s.slug, 5);
---

<BaseLayout
  title={`${s.name}: meaning, dignities, and how to read it`}
  description={`${s.name} in astrology: ${s.element}, ${s.modality}, ruled by ${s.ruler}. Learn the sign as a style of expression and how its meaning changes by planet, house, and chart context.`}
  path={`/explore/signs/${s.slug}/`}
  breadcrumbs={crumbs}
>
  <Breadcrumbs crumbs={crumbs} />
  <section class="hero hero--split">
    <div class="container">
      <div>
        <p class="eyebrow">The 12 Signs</p>
        <h1><span aria-hidden="true">{s.glyph}</span> {s.name}</h1>
        <p class="lede">{s.keywords.join(' · ')}</p>
      </div>
      <img class="hero__img" src={heroImage.src} srcset={heroImage.srcset} sizes="100vw" alt={heroImage.alt} width={heroImage.width} height={heroImage.height} fetchpriority="high" />
    </div>
  </section>

  <section class="section">
    <div class="container prose flow">
      <p>
        A sign describes a style, not a complete person. {s.name} changes meaning depending on which
        planet is expressing through it, which house it occupies, what rules that house, and what
        relationships connect it to the rest of the chart. Use the page as a vocabulary guide, not a personality test.
      </p>
      <h2>At a glance</h2>
      <table class="ref-table">
        <caption class="visually-hidden">Structural attributes of {s.name}</caption>
        <tbody>
          <tr><th scope="row">Element</th><td>{s.element}</td></tr>
          <tr><th scope="row">Modality</th><td>{s.modality}</td></tr>
          <tr><th scope="row">Polarity</th><td>{s.polarity}</td></tr>
          <tr><th scope="row">Ruler</th><td>{s.ruler}{s.modernRuler ? ` (traditional) · ${s.modernRuler} (modern)` : ''}</td></tr>
          {s.exaltation && <tr><th scope="row">Exaltation</th><td>{s.exaltation}</td></tr>}
          <tr><th scope="row">Detriment</th><td>{s.detriment}</td></tr>
          {s.fall && <tr><th scope="row">Fall</th><td>{s.fall}</td></tr>}
          <tr><th scope="row">Opposite sign</th><td>{opposite ? <a href={`/explore/signs/${opposite.slug}/`}>{s.opposite}</a> : s.opposite}</td></tr>
          <tr><th scope="row">Sun season</th><td>{s.dates}</td></tr>
          <tr><th scope="row">Glyph</th><td><span class="glyph-cell" aria-hidden="true">{s.glyph}</span>, {s.glyphMeaning}</td></tr>
        </tbody>
      </table>
      <p class="card__meta">
        Dignities follow the Ptolemaic tables used in traditional astrology. See
        <a href="/explore/dignities/">essential dignities explained</a>.
      </p>
    </div>
  </section>

  <SeaBreak image={breakImage} />

  <section class="section section--sea">
    <div class="container prose flow">
      <h2>The style</h2>
      <p>{s.style}</p>
      <p>{s.season}</p>
      <Layers kind="traditional"><p>{s.traditional}</p></Layers>
      <Layers kind="modern"><p>{s.modern}</p></Layers>
      <Layers kind="mo"><p>{s.mo}</p></Layers>
      {s.differs && <Layers kind="differs"><p>{s.differs}</p></Layers>}
      <Layers kind="misconception"><p>{s.misconception}</p></Layers>
    </div>
  </section>

  <section class="section">
    <div class="container prose flow">
      <h2>Possible strengths</h2>
      <p>{s.strengths}</p>
      <h2>Possible tension or growth edge</h2>
      <p>{s.watchFor}</p>
      <h2>In relationship</h2>
      <p>{s.inRelationship}</p>
      <h2>At work</h2>
      <p>{s.atWork}</p>

      <div class="callout">
        <p style="margin: 0;">
          <strong>Keep the sign in context.</strong> Saying you "are {s.name}" usually means the Sun
          was in {s.name} when you were born. Your Moon, rising sign, and every planet have signs of
          their own, and each placement is modified by house, aspect, rulership, and the rest of the
          chart. See <a href="/explore/the-big-three/">the Big Three</a>.
        </p>
      </div>

      <nav aria-label="More signs" class="reference-pager">
        <a href={`/explore/signs/${prev.slug}/`}>← {prev.name}</a>
        <a href={`/explore/signs/${next.slug}/`}>{next.name} →</a>
      </nav>
    </div>
  </section>

  <CTABand
    heading={`${s.name} is a style, not a whole person`}
    body="Keep going until you can see what is expressing through the sign, where it is operating, and how it relates to the rest of the chart."
    buttonLabel="Explore the Signs"
    buttonHref="/explore/signs/"
    secondaryLabel="See how the Big Three work together"
    secondaryHref="/explore/the-big-three/"
  />
</BaseLayout>
