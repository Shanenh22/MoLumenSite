---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ocean } from '../../config/images';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CTABand from '../../components/CTABand.astro';
const crumbs = [{ label: 'Explore Astrology', href: '/explore/' }];
const foundations = [
  ['Birth Chart Basics', '/explore/birth-chart-basics/', 'What a chart actually is, and how its pieces fit together. Start here.'],
  ['The Four Angles', '/explore/angles/', 'Ascendant, Descendant, Midheaven, IC, the frame everything sits in.'],
  ['The Big Three', '/explore/the-big-three/', 'Sun, Moon, and rising, what each one really governs.'],
  ['Elements & Modalities', '/explore/elements-and-modalities/', 'The two grids that generate all twelve signs.'],
  ['The Planets', '/explore/planets/', 'Ten drives every chart contains: the Sun’s purpose to Pluto’s transformations.'],
  ['The 12 Signs', '/explore/signs/', 'Styles of expression: how each sign colors the planets within it.'],
  ['The 12 Houses', '/explore/houses/', 'Areas of experience: where in life each part of your chart plays out.'],
  ['Aspects', '/explore/aspects/', 'The geometry of the chart: how planets support, strain, and balance each other.'],
  ['Chart Patterns', '/explore/chart-patterns/', 'Stelliums, grand trines, T-squares: configurations that define a chart.'],
  ['Essential Dignities', '/explore/dignities/', 'The traditional measure of whether a planet can do its job.'],
  ['House Systems', '/explore/house-systems/', 'Whole sign, Placidus, equal, what changes, and what does not.'],
  ['Schools & Traditions', '/explore/schools/', 'Hellenistic to modern to Vedic, and what to ask an astrologer.'],
];
const timing = [
  ['Transits', '/explore/transits/', 'How the moving sky activates your chart, the astrology of timing.'],
  ['Retrogrades', '/explore/retrogrades/', 'What retrograde motion is, and what it honestly isn’t.'],
  ['Eclipses', '/explore/eclipses/', 'Why they come in seasons, and what they actually mark.'],
  ['The Lunar Nodes', '/explore/lunar-nodes/', 'The growth axis, and why eclipses happen there.'],
  ['Moon Phases', '/explore/moon-phases/', 'Working with the 29.5-day cycle, without the rulebook.'],
  ['The Saturn Return', '/explore/saturn-return/', 'What arrives around 29 and 58: minus the doom.'],
];
const life = [
  ['Relationship Astrology', '/explore/relationships/', 'Synastry and composite charts: how two people’s charts interact.'],
  ['Personal Purpose', '/explore/personal-purpose/', 'What a chart can (and can’t) say about vocation and direction.'],
  ['Questions to Bring', '/explore/questions-to-bring/', 'The questions that make a reading genuinely useful.'],
  ['Common Misconceptions', '/explore/misconceptions/', 'Twelve things people believe that astrologers don’t.'],
  ['Glossary', '/explore/glossary/', 'Plain-language definitions for every term on this site.'],
];
---

<BaseLayout
  title="Explore Astrology, learn the real thing"
  description="A free, plain-language astrology education hub by Mo Lumen: birth chart basics, planets, signs, houses, aspects, transits, and relationship astrology, no doom, no jargon."
  path="/explore/"
  breadcrumbs={crumbs}
>
  <Breadcrumbs crumbs={crumbs} />
  <section class="hero hero--split">
    <div class="container">
      <div>
      <p class="eyebrow">Learn</p>
      <h1>Explore astrology</h1>
      <p class="lede">
        Astrology is a language, and languages are learnable. These pages teach it the way I do in
        readings: plain words first, technical terms second, and your own agency at the center of
        every interpretation. Welcome to the study, take your time.
      </p>
      </div>
      <img
        class="hero__img"
        src={ocean.lightRays.src}
        srcset={ocean.lightRays.srcset}
        sizes="100vw"
        alt={ocean.lightRays.alt}
        width={ocean.lightRays.width}
        height={ocean.lightRays.height}
        fetchpriority="high"
      />
    </div>
  </section>

  <section class="section section--night center">
    <div class="container flow" style="max-width: 44rem;">
      <p class="eyebrow">New to all this?</p>
      <h2>There's an order that makes this easy</h2>
      <p class="lede" style="margin-inline: auto;">
        Nine steps, about an hour of reading, no jargon left unexplained. The sequence I'd teach
        it in if you were sitting across from me.
      </p>
      <p><a class="btn btn--accent" href="/start-here/">Start here</a></p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">Foundations</p>
      <h2>How a chart is built</h2>
      <div class="grid grid--3" style="margin-top: var(--space-6);">
        {
          foundations.map(([title, href, desc]) => (
            <article class="card">
              <h3 style="font-size: var(--text-lg); margin: 0;">
                <a href={href}>{title}</a>
              </h3>
              <p style="margin: 0;">{desc}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <p class="eyebrow">Timing</p>
      <h2>How the sky moves</h2>
      <div class="grid grid--3" style="margin-top: var(--space-6);">
        {
          timing.map(([title, href, desc]) => (
            <article class="card">
              <h3 style="font-size: var(--text-lg); margin: 0;">
                <a href={href}>{title}</a>
              </h3>
              <p style="margin: 0;">{desc}</p>
            </article>
          ))
        }
      </div>
      <p style="margin-top: var(--space-6);">
        <a href="/current-sky/the-sky-in-2026/">What's shifting in the sky this year →</a>
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">Living with it</p>
      <h2>Astrology in practice</h2>
      <div class="grid grid--3" style="margin-top: var(--space-6);">
        {
          life.map(([title, href, desc]) => (
            <article class="card">
              <h3 style="font-size: var(--text-lg); margin: 0;">
                <a href={href}>{title}</a>
              </h3>
              <p style="margin: 0;">{desc}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container grid grid--2">
      <div class="flow">
        <h2>Prefer to learn by doing?</h2>
        <p>
          The <a href="/tools/explore-your-chart/">Explore Your Chart</a> tool lets you click
          around an interactive chart wheel and see how planets, signs, and houses combine, no
          birth data needed.
        </p>
      </div>
      <div class="flow">
        <h2>Prefer to watch?</h2>
        <p>
          I teach on <a href="/videos/">YouTube and Instagram</a>, short, clear videos on the
          current sky and the fundamentals.
        </p>
      </div>
    </div>
  </section>

  <CTABand
    heading="Reading about charts is good. Sitting with yours is better."
    body="When you're ready to see how all of this lives in your own chart, that's what readings are for."
  />
</BaseLayout>
