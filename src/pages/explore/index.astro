---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ocean } from '../../config/images';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CTABand from '../../components/CTABand.astro';
const crumbs = [{ label: 'Explore Astrology', href: '/explore/' }];
const foundations = [
  ['Birth Chart Basics', '/explore/birth-chart-basics/', 'What a chart is, the four main vocabularies inside it, and why the relationships among them matter. Start here.'],
  ['The Four Angles', '/explore/angles/', 'Ascendant, Descendant, Midheaven, and IC: four points that help orient the whole chart.'],
  ['The Big Three', '/explore/the-big-three/', 'Sun, Moon, and rising: three important parts of a chart, but never the whole person.'],
  ['Elements & Modalities', '/explore/elements-and-modalities/', 'Two ways of organizing the signs that reveal recurring patterns across the zodiac.'],
  ['The Planets', '/explore/planets/', 'Different drives and functions within the chart, each shaped by sign, house, aspects, and context.'],
  ['The 12 Signs', '/explore/signs/', 'Styles of expression: how signs shape the way a planet tends to operate.'],
  ['The 12 Houses', '/explore/houses/', 'Areas of experience: where different parts of the chart are most likely to show themselves.'],
  ['Aspects', '/explore/aspects/', 'The relationships among planets: where different parts of the chart reinforce, challenge, or complicate one another.'],
  ['Chart Patterns', '/explore/chart-patterns/', 'Stelliums, grand trines, T-squares, and other configurations that become meaningful through the larger chart.'],
  ['Essential Dignities', '/explore/dignities/', 'A traditional framework for considering how comfortably or effectively a planet may operate.'],
  ['House Systems', '/explore/house-systems/', 'Whole sign, Placidus, equal, and why astrologers can use different systems without reading entirely different skies.'],
  ['Schools & Traditions', '/explore/schools/', 'Some of the major astrological traditions, and why many astrologers study across more than one.'],
];
const timing = [
  ['Transits', '/explore/transits/', 'How the moving sky forms new relationships with a natal chart, one of astrology’s central approaches to timing.'],
  ['Retrogrades', '/explore/retrogrades/', 'What retrograde motion is astronomically, and how astrologers interpret it without turning it into a scapegoat.'],
  ['Eclipses', '/explore/eclipses/', 'Why eclipses arrive in seasons, what makes them astronomically remarkable, and how astrology approaches them.'],
  ['The Lunar Nodes', '/explore/lunar-nodes/', 'The points where the Moon’s path crosses the Sun’s apparent path, and why eclipses gather around them.'],
  ['Moon Phases', '/explore/moon-phases/', 'The familiar 29.5-day cycle as both an astronomical rhythm and an astrological one.'],
  ['The Saturn Return', '/explore/saturn-return/', 'What is happening astrologically around ages 29 and 58, without treating it as a sentence or a crisis by definition.'],
];
const life = [
  ['Relationship Astrology', '/explore/relationships/', 'How two charts can be compared without reducing either person to a compatibility score.'],
  ['Personal Purpose', '/explore/personal-purpose/', 'What a chart can contribute to questions of vocation and direction, and what it cannot decide for you.'],
  ['Questions to Bring', '/explore/questions-to-bring/', 'How a good question gives an astrological conversation somewhere meaningful to begin.'],
  ['Common Misconceptions', '/explore/misconceptions/', 'Some of the assumptions about astrology that deserve a closer look.'],
  ['Glossary', '/explore/glossary/', 'Plain-language definitions for the terms used throughout this site.'],
];
---

<BaseLayout
  title="Explore Astrology, learn how the pieces fit"
  description="A free astrology learning hub by Mo Lumen: birth charts, planets, signs, houses, aspects, timing, and the relationships among them, explained in plain language."
  path="/explore/"
  breadcrumbs={crumbs}
>
  <Breadcrumbs crumbs={crumbs} />
  <section class="hero hero--split">
    <div class="container">
      <div>
      <p class="eyebrow">Learn</p>
      <h1>Explore astrology</h1>
      <p class="lede">
        Astrology gives us many pieces to study, but very few of them mean much in isolation. These
        pages teach the vocabulary first, then keep asking the more interesting question: how do
        the pieces relate to one another? That is where a chart begins to become a whole.
      </p>
      </div>
      <img
        class="hero__img"
        src={ocean.lightRays.src}
        srcset={ocean.lightRays.srcset}
        sizes="100vw"
        alt={ocean.lightRays.alt}
        width={ocean.lightRays.width}
        height={ocean.lightRays.height}
        fetchpriority="high"
      />
    </div>
  </section>

  <section class="section section--night center">
    <div class="container flow" style="max-width: 44rem;">
      <p class="eyebrow">New to all this?</p>
      <h2>There is an order that makes this easier</h2>
      <p class="lede" style="margin-inline: auto;">
        Nine steps, about an hour of reading, no prior knowledge required. It is the sequence I
        would use if we were sitting together and you asked me to show you how a chart works.
      </p>
      <p><a class="btn btn--accent" href="/start-here/">Start here</a></p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">Foundations</p>
      <h2>Learn the parts, then look at the relationships</h2>
      <div class="grid grid--3" style="margin-top: var(--space-6);">
        {
          foundations.map(([title, href, desc]) => (
            <article class="card">
              <h3 style="font-size: var(--text-lg); margin: 0;">
                <a href={href}>{title}</a>
              </h3>
              <p style="margin: 0;">{desc}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <p class="eyebrow">Timing</p>
      <h2>Watch the sky keep moving</h2>
      <p class="lede">
        A natal chart is calculated for one moment. The planets do not stop there. Timing techniques
        look at the continuing cycles and the new relationships they form with the natal chart.
      </p>
      <div class="grid grid--3" style="margin-top: var(--space-6);">
        {
          timing.map(([title, href, desc]) => (
            <article class="card">
              <h3 style="font-size: var(--text-lg); margin: 0;">
                <a href={href}>{title}</a>
              </h3>
              <p style="margin: 0;">{desc}</p>
            </article>
          ))
        }
      </div>
      <p style="margin-top: var(--space-6);">
        <a href="/current-sky/the-sky-in-2026/">What's shifting in the sky this year →</a>
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">Living with it</p>
      <h2>Bring astrology back to an actual life</h2>
      <p class="lede">
        General meanings are useful. A person is more complicated. These pages look at some of the
        places where astrology becomes most useful when it stays curious about the life being lived.
      </p>
      <div class="grid grid--3" style="margin-top: var(--space-6);">
        {
          life.map(([title, href, desc]) => (
            <article class="card">
              <h3 style="font-size: var(--text-lg); margin: 0;">
                <a href={href}>{title}</a>
              </h3>
              <p style="margin: 0;">{desc}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container grid grid--2">
      <div class="flow">
        <h2>Prefer to learn by doing?</h2>
        <p>
          The <a href="/tools/explore-your-chart/">Explore Your Chart</a> tool lets you click
          around an interactive chart wheel and see how planets, signs, houses, and aspects relate,
          with no birth data required. It teaches how charts work; it does not try to tell you what
          yours means.
        </p>
      </div>
      <div class="flow">
        <h2>Prefer to watch?</h2>
        <p>
          I also teach through <a href="/videos/">video</a>, where there is room to look at a
          concept, a cycle, or something in the current sky together.
        </p>
      </div>
    </div>
  </section>

  <CTABand
    heading="Ready to see the language in motion?"
    body="Current Sky is where I use these ideas to look at the cycles overhead without turning a shared pattern into a personal prediction."
    buttonLabel="See Current Sky"
    buttonHref="/current-sky/"
    secondaryLabel="Start from the beginning"
    secondaryHref="/start-here/"
  />
</BaseLayout>
