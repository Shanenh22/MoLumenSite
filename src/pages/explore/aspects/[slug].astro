---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import CTABand from '../../../components/CTABand.astro';
import Layers from '../../../components/Layers.astro';
import SeaBreak from '../../../components/SeaBreak.astro';
import ReferencePager from '../../../components/ReferencePager.astro';
import { bandFor } from '../../../config/images';
import { aspects } from '../../../data/aspects';

export function getStaticPaths() {
  return aspects.map((a) => ({ params: { slug: a.slug }, props: { aspect: a } }));
}
const { aspect: a } = Astro.props;
const i = aspects.findIndex((x) => x.slug === a.slug);
const prev = aspects[(i + aspects.length - 1) % aspects.length];
const next = aspects[(i + 1) % aspects.length];
const crumbs = [
  { label: 'Explore Astrology', href: '/explore/' },
  { label: 'Aspects', href: '/explore/aspects/' },
  { label: a.name, href: `/explore/aspects/${a.slug}/` },
];
const heroImage = bandFor(a.slug);
const breakImage = bandFor(a.slug, 5);
---

<BaseLayout
  title={`The ${a.name}: aspect meaning, angle, and orb`}
  description={`The ${a.name.toLowerCase()} aspect (${a.angle}): ${a.nature} Learn the geometry, traditional and modern perspectives, and why no aspect should be read outside the whole chart.`}
  path={`/explore/aspects/${a.slug}/`}
  breadcrumbs={crumbs}
>
  <Breadcrumbs crumbs={crumbs} />
  <section class="hero hero--split">
    <div class="container">
      <div>
        <p class="eyebrow">Aspects</p>
        <h1><span aria-hidden="true">{a.glyph}</span> {a.name}</h1>
        <p class="lede">{a.angle}, {a.nature}</p>
      </div>
      <img class="hero__img" src={heroImage.src} srcset={heroImage.srcset} sizes="100vw" alt={heroImage.alt} width={heroImage.width} height={heroImage.height} fetchpriority="high" />
    </div>
  </section>

  <section class="section">
    <div class="container prose flow">
      <p>
        An aspect describes a relationship between chart factors. It does not tell us the outcome of
        that relationship by itself. Which planets are involved, how exact the aspect is, what those
        planets rule, and what else they connect to can change the interpretation substantially.
      </p>
      <h2>At a glance</h2>
      <table class="ref-table">
        <caption class="visually-hidden">Attributes of the {a.name}</caption>
        <tbody>
          <tr><th scope="row">Exact angle</th><td>{a.degrees}°</td></tr>
          <tr><th scope="row">Typical orb</th><td>{a.typicalOrb}</td></tr>
          <tr><th scope="row">Sign relationship</th><td>{a.signRelationship}</td></tr>
          <tr><th scope="row">Nature</th><td>{a.nature}</td></tr>
        </tbody>
      </table>
      <p class="card__meta">
        Orb is the allowance within which an aspect is considered operative. There is no single
        universal standard: astrologers vary by technique, school, planet, and context. In general,
        tighter aspects are given more weight.
      </p>
    </div>
  </section>

  <SeaBreak image={breakImage} />

  <section class="section section--sea">
    <div class="container prose flow">
      <h2>The relationship</h2>
      <p>{a.relationship}</p>
      <Layers kind="traditional"><p>{a.traditional}</p></Layers>
      <Layers kind="modern"><p>{a.modern}</p></Layers>
      <Layers kind="mo"><p>{a.mo}</p></Layers>
      <Layers kind="misconception"><p>{a.misconception}</p></Layers>
    </div>
  </section>

  <section class="section">
    <div class="container prose flow">
      <h2>How it can feel to live with</h2>
      <p>{a.livedExperience}</p>
      <h2>Working with it</h2>
      <p>{a.workingWithIt}</p>

      <div class="callout">
        <p style="margin: 0;">
          <strong>Applying or separating?</strong> An aspect is <em>applying</em> when the faster
          factor is moving toward exactness and <em>separating</em> after exactness has passed.
          Traditional techniques may give that distinction substantial weight, especially in horary
          and timing work. In natal interpretation, it is one more piece of context rather than a
          stand-alone verdict.
        </p>
      </div>

      <ReferencePager
        ariaLabel="More aspects"
        prevHref={`/explore/aspects/${prev.slug}/`}
        prevLabel={prev.name}
        nextHref={`/explore/aspects/${next.slug}/`}
        nextLabel={next.name}
      />
    </div>
  </section>

  <CTABand
    heading={`The ${a.name} is one relationship in a larger system`}
    body="Keep asking which planets are involved, what they rule, how exact the contact is, and what else connects to them before turning the aspect into a story."
    buttonLabel="Explore the Aspects"
    buttonHref="/explore/aspects/"
    secondaryLabel="See how the whole chart fits together"
    secondaryHref="/explore/birth-chart-basics/"
  />
</BaseLayout>
