---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import CTABand from '../../../components/CTABand.astro';
import Layers from '../../../components/Layers.astro';
import SeaBreak from '../../../components/SeaBreak.astro';
import { bandFor } from '../../../config/images';
import { aspects } from '../../../data/aspects';

export function getStaticPaths() {
  return aspects.map((a) => ({ params: { slug: a.slug }, props: { aspect: a } }));
}
const { aspect: a } = Astro.props;
const i = aspects.findIndex((x) => x.slug === a.slug);
const prev = aspects[(i + aspects.length - 1) % aspects.length];
const next = aspects[(i + 1) % aspects.length];
const crumbs = [
  { label: 'Explore Astrology', href: '/explore/' },
  { label: 'Aspects', href: '/explore/aspects/' },
  { label: a.name, href: `/explore/aspects/${a.slug}/` },
];
/* No image at all on these five before. */
const heroImage = bandFor(a.slug);
const breakImage = bandFor(a.slug, 5);
---

<BaseLayout
  title={`The ${a.name} — aspect meaning, angle, and orb`}
  description={`The ${a.name.toLowerCase()} aspect (${a.angle}): ${a.nature} Traditional and modern readings, typical orbs, and how to work with it.`}
  path={`/explore/aspects/${a.slug}/`}
  breadcrumbs={crumbs}
>
  <Breadcrumbs crumbs={crumbs} />
  <section class="hero hero--split">
    <div class="container">
      <div>
        <p class="eyebrow">Aspects</p>
        <h1><span aria-hidden="true">{a.glyph}</span> {a.name}</h1>
        <p class="lede">{a.angle} — {a.nature}</p>
      </div>
      <img
        class="hero__img"
        src={heroImage.src}
        srcset={heroImage.srcset}
        sizes="100vw"
        alt={heroImage.alt}
        width={heroImage.width}
        height={heroImage.height}
        fetchpriority="high"
      />
    </div>
  </section>

  <section class="section">
    <div class="container prose flow">
      <h2>At a glance</h2>
      <table class="ref-table">
        <caption class="visually-hidden">Attributes of the {a.name}</caption>
        <tbody>
          <tr><th scope="row">Exact angle</th><td>{a.degrees}°</td></tr>
          <tr><th scope="row">Typical orb</th><td>{a.typicalOrb}</td></tr>
          <tr><th scope="row">Sign relationship</th><td>{a.signRelationship}</td></tr>
          <tr><th scope="row">Nature</th><td>{a.nature}</td></tr>
        </tbody>
      </table>
      <p class="card__meta">
        Orb is the allowance within which an aspect still counts. There is no universal standard —
        orbs vary by astrologer, by school, and by the planets involved. Tighter aspects are
        stronger.
      </p>

    </div>
  </section>

  <SeaBreak image={breakImage} />

  <section class="section section--sea">
    <div class="container prose flow">
      <h2>The relationship</h2>
      <p>{a.relationship}</p>

      <Layers kind="traditional"><p>{a.traditional}</p></Layers>
      <Layers kind="modern"><p>{a.modern}</p></Layers>
      <Layers kind="mo"><p>{a.mo}</p></Layers>
      <Layers kind="misconception"><p>{a.misconception}</p></Layers>

    </div>
  </section>

  <section class="section">
    <div class="container prose flow">
      <h2>How it feels to live with</h2>
      <p>{a.livedExperience}</p>
      <h2>Working with it</h2>
      <p>{a.workingWithIt}</p>

      <div class="callout">
        <p style="margin: 0;">
          <strong>Applying or separating?</strong> An aspect is <em>applying</em> when the faster
          planet is still moving toward exactness, and <em>separating</em> once it has passed.
          Traditional astrology treats applying aspects as the ones still to unfold, and separating
          ones as already spent — a distinction that matters a great deal in
          <a href="/explore/transits/">timing work</a>.
        </p>
      </div>

      <nav aria-label="More aspects" style="display: flex; justify-content: space-between; gap: var(--space-4);">
        <a href={`/explore/aspects/${prev.slug}/`}>← {prev.name}</a>
        <a href={`/explore/aspects/${next.slug}/`}>{next.name} →</a>
      </nav>
    </div>
  </section>

  <CTABand />
</BaseLayout>
