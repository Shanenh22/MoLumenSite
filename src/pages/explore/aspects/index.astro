---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { scenes } from '../../../config/images';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { aspects } from '../../../data/aspects';
const crumbs = [
  { label: 'Explore Astrology', href: '/explore/' },
  { label: 'Aspects', href: '/explore/aspects/' },
];
---

<BaseLayout
  title="Aspects — the geometry of the chart"
  description="Aspects are meaningful angles between planets: conjunction, sextile, square, trine, opposition. Learn what each one means — and why 'hard' aspects build your best skills."
  path="/explore/aspects/"
  breadcrumbs={crumbs}
>
  <Breadcrumbs crumbs={crumbs} />
  <section class="hero hero--split">
    <div class="container">
      <div>
      <p class="eyebrow">Explore Astrology</p>
      <h1>Aspects</h1>
      <p class="lede">
        Aspects are relationships between chart factors — the angles planets make to one another.
        They tell you which of your drives cooperate, which argue, and which are fused for life.
        One reframe before you start: "hard" aspects aren't bad. They're engines.
      </p>
      </div>
      <img
        class="hero__img"
        src={scenes.aspects.src}
        srcset={scenes.aspects.srcset}
        sizes="100vw"
        alt={scenes.aspects.alt}
        width={scenes.aspects.width}
        height={scenes.aspects.height}
        fetchpriority="high"
      />
    </div>
  </section>

  <section class="section">
    <div class="container grid grid--3">
      {
        aspects.map((a) => (
          <article class="card">
            <span class="glyph" aria-hidden="true">{a.glyph}</span>
            <h2 style="font-size: var(--text-xl); margin: 0;">
              <a href={`/explore/aspects/${a.slug}/`}>{a.name}</a>
            </h2>
            <p class="card__meta">{a.angle}</p>
            <p style="margin: 0;">{a.nature}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section section--alt">
    <div class="container prose flow">
      <h2>Related</h2>
      <p>
        When three or more planets lock together they form
        <a href="/explore/chart-patterns/">chart patterns</a> — stelliums, grand trines,
        T-squares — which often define a chart more than any single aspect does. Aspects also
        drive <a href="/explore/transits/">timing</a>, and their geometry follows from
        <a href="/explore/elements-and-modalities/">elements and modalities</a>.
      </p>
    </div>
  </section>
</BaseLayout>
