---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CTABand from '../../components/CTABand.astro';
import { site } from '../../config/site';
import { scenes } from '../../config/images';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter((p) => !p.data.draft);
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.mdx?$/, '') },
    props: { post },
  }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const d = post.data;
const slug = post.id.replace(/\.mdx?$/, '');

const all = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
const related = all
  .filter((p) => p.id !== post.id)
  .sort((a, b) => Number(b.data.category === d.category) - Number(a.data.category === d.category))
  .slice(0, 2);

const fmt = (dt: Date) =>
  dt.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const hero =
  (d.heroImage && (scenes as Record<string, (typeof scenes)['natal']>)[d.heroImage]) ||
  scenes.newsletterLetters;
const crumbs = [
  { label: 'Blog', href: '/blog/' },
  { label: d.title, href: `/blog/${slug}/` },
];
/** Reading time from the real word count at 220 wpm, rounded up. */
const readingMinutes = Math.max(1, Math.ceil((post.body ?? '').split(/\s+/).filter(Boolean).length / 220));

/**
 * A blog article should not assume that finishing an article means the reader
 * is ready to buy. The closer follows the intent implied by the article's
 * category instead:
 *
 * - learning articles keep teaching;
 * - timing/misconception articles move into the live sky;
 * - reading-decision articles help the visitor choose a service.
 *
 * The quieter second link leaves an adjacent route available without making
 * every educational page end in the same Book button.
 */
const nextStepByCategory: Record<
  string,
  {
    heading: string;
    body: string;
    buttonLabel: string;
    buttonHref: string;
    secondaryLabel: string;
    secondaryHref: string;
  }
> = {
  'Chart Basics': {
    heading: 'Want to keep building the chart?',
    body: 'Move from one idea into the larger structure: planets, signs, houses, aspects, and how they begin to work together.',
    buttonLabel: 'Explore Astrology',
    buttonHref: '/explore/',
    secondaryLabel: 'Start from the beginning',
    secondaryHref: '/start-here/',
  },
  Technique: {
    heading: 'Ready for the next layer?',
    body: 'Technique becomes useful when it is connected to the rest of the chart. Continue into the reference library and keep the pieces in context.',
    buttonLabel: 'Explore the Techniques',
    buttonHref: '/explore/',
    secondaryLabel: 'Browse the glossary',
    secondaryHref: '/explore/glossary/',
  },
  Timing: {
    heading: 'See the timing in the sky now',
    body: 'Current Sky follows the actual planetary cycles and separates what is happening overhead from what would require your personal chart to interpret.',
    buttonLabel: 'Go to Current Sky',
    buttonHref: '/current-sky/',
    secondaryLabel: 'Explore transits',
    secondaryHref: '/explore/transits/',
  },
  Misconceptions: {
    heading: 'Keep the astrology in context',
    body: 'Explore the underlying techniques, or look at the current sky without the doom, hype, or one-size-fits-all predictions.',
    buttonLabel: 'Explore Astrology',
    buttonHref: '/explore/',
    secondaryLabel: 'See Current Sky',
    secondaryHref: '/current-sky/',
  },
  'Understanding Readings': {
    heading: 'Have a personal question in mind?',
    body: 'The Reading Finder listens for what you are actually asking, explains which reading fits, and leaves the final choice with you.',
    buttonLabel: 'Find My Reading',
    buttonHref: '/reading-finder/',
    secondaryLabel: 'Compare all readings',
    secondaryHref: '/readings/',
  },
  'Choosing a Reading': {
    heading: 'Not sure what fits yet?',
    body: 'Use five quick questions to narrow the options, see why a reading is being suggested, and decide whether you want to book at all.',
    buttonLabel: 'Use the Reading Finder',
    buttonHref: '/reading-finder/',
    secondaryLabel: 'Compare all readings',
    secondaryHref: '/readings/',
  },
};
const nextStep = nextStepByCategory[d.category] ?? {
  heading: 'Where would you like to go next?',
  body: 'Keep learning in the astrology library, or move toward a reading only if your question has become personal.',
  buttonLabel: 'Explore Astrology',
  buttonHref: '/explore/',
  secondaryLabel: 'Find a reading',
  secondaryHref: '/reading-finder/',
};

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: d.title,
    description: d.description,
    datePublished: d.publishDate.toISOString(),
    ...(d.updatedDate ? { dateModified: d.updatedDate.toISOString() } : {}),
    author: { '@type': 'Person', name: 'Mo Lumen', url: `${site.url}/about/` },
    publisher: { '@type': 'Organization', name: site.name },
    mainEntityOfPage: `${site.url}/blog/${slug}/`,
  },
];
---

<BaseLayout
  title={d.title}
  description={d.description}
  path={`/blog/${slug}/`}
  breadcrumbs={crumbs}
  ogType="article"
  publishedDate={d.publishDate}
  updatedDate={d.updatedDate}
  schema={schema}
  shareImage={hero.src}
>
  <Breadcrumbs crumbs={crumbs} />
  <article>
    <section class="hero hero--split">
      <div class="container">
        <div>
          <p class="eyebrow">{d.category}</p>
          <h1>{d.title}</h1>
          <p class="lede">{d.description}</p>
          <ul class="hero__meta" aria-label="Article details">
            <li>{fmt(d.publishDate)}</li>
            <li>{readingMinutes} min read</li>
            {d.updatedDate && <li>Updated {fmt(d.updatedDate)}</li>}
          </ul>
          <p class="card__meta">
            By <a href="/about/">Mo Lumen</a> · <a href="/credentials/">Credentials</a>
          </p>
        </div>
        <img
          class="hero__img"
          src={hero.src}
          srcset={hero.srcset}
          sizes="100vw"
          alt=""
          width={hero.width}
          height={hero.height}
          fetchpriority="high"
        />
      </div>
    </section>

    <section class="section">
      <div class="container prose flow">
        <Content />
        {
          d.tags.length > 0 && (
            <p style="margin-top: var(--space-8);">
              {d.tags.map((t) => (
                <span class="tag" style="margin-right: var(--space-2);">
                  {t}
                </span>
              ))}
            </p>
          )
        }
      </div>
    </section>
  </article>

  {
    related.length > 0 && (
      <section class="section section--alt">
        <div class="container">
          <h2>More from the blog</h2>
          <div class="grid grid--2" style="margin-top: var(--space-6);">
            {related.map((p) => (
              <article class="card">
                <p class="card__meta" style="margin: 0;">
                  {fmt(p.data.publishDate)} · {p.data.category}
                </p>
                <h3 style="margin: 0;">
                  <a href={`/blog/${p.id.replace(/\.mdx?$/, '')}/`}>{p.data.title}</a>
                </h3>
                <p style="margin: 0;">{p.data.description}</p>
              </article>
            ))}
          </div>
          <p style="margin-top: var(--space-6);">
            <a href="/blog/">All posts →</a>
          </p>
        </div>
      </section>
    )
  }

  <CTABand
    heading={nextStep.heading}
    body={nextStep.body}
    buttonLabel={nextStep.buttonLabel}
    buttonHref={nextStep.buttonHref}
    secondaryLabel={nextStep.secondaryLabel}
    secondaryHref={nextStep.secondaryHref}
  />
</BaseLayout>
