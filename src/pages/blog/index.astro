---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CTABand from '../../components/CTABand.astro';
import NewsletterForm from '../../components/NewsletterForm.astro';
import { scenes } from '../../config/images';
import { site } from '../../config/site';

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

const categories = [...new Set(posts.map((p) => p.data.category))].sort();
const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const slugOf = (id: string) => id.replace(/\.mdx?$/, '');
const heroFor = (key?: string) =>
  (key && (scenes as Record<string, (typeof scenes)['natal']>)[key]) || scenes.newsletterLetters;

const crumbs = [{ label: 'Blog', href: '/blog/' }];
const schema =
  posts.length > 0
    ? [
        {
          '@context': 'https://schema.org',
          '@type': 'Blog',
          name: `${site.name}: Blog`,
          url: `${site.url}/blog/`,
          blogPost: posts.slice(0, 10).map((p) => ({
            '@type': 'BlogPosting',
            headline: p.data.title,
            datePublished: p.data.publishDate.toISOString(),
            url: `${site.url}/blog/${slugOf(p.id)}/`,
          })),
        },
      ]
    : [];
---

<BaseLayout
  title="Blog"
  description="Think with Mo about astrology: how the techniques work, where their limits are, what makes a reading useful, and the questions that keep opening as you learn."
  path="/blog/"
  breadcrumbs={crumbs}
  schema={schema}
>
  <Breadcrumbs crumbs={crumbs} />
  <section class="hero hero--split">
    <div class="container">
      <div>
        <p class="eyebrow">Think with Mo</p>
        <h1>Blog</h1>
        <p class="lede">
          This is where I follow the questions that do not fit neatly into a definition or a sky
          update: how astrologers know what they know, where a technique has limits, what makes a
          reading useful, and what gets more interesting the longer you look.
        </p>
      </div>
      <img
        class="hero__img"
        src={scenes.newsletterLetters.src}
        srcset={scenes.newsletterLetters.srcset}
        sizes="100vw"
        alt={scenes.newsletterLetters.alt}
        width={scenes.newsletterLetters.width}
        height={scenes.newsletterLetters.height}
        fetchpriority="high"
      />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="prose flow" style="margin-bottom: var(--space-8);">
        <p>
          If you are deciding whether a reading is right for you, start with
          <a href="/blog/what-astrology-can-and-cannot-do/">what a reading can and cannot do</a> or
          <a href="/blog/how-to-choose-an-astrologer/">how to choose an astrologer</a>. If you are
          here to learn the language itself, the <a href="/start-here/">Start Here path</a> and
          <a href="/explore/">Explore Astrology</a> are the more systematic route. The blog is less
          textbook and more conversation.
        </p>
      </div>
      {
        posts.length > 0 ? (
          <>
            {categories.length > 1 && (
              <div class="filter-bar" role="group" aria-label="Filter posts by category" data-blog-filters>
                <button type="button" aria-pressed="true" data-filter="all">
                  All posts
                </button>
                {categories.map((c) => (
                  <button type="button" aria-pressed="false" data-filter={c}>
                    {c}
                  </button>
                ))}
              </div>
            )}
            <p class="visually-hidden" aria-live="polite" data-blog-status />

            <div class="grid grid--3">
              {posts.map((p) => {
                const im = heroFor(p.data.heroImage);
                return (
                  <article class="card card--img" data-post-category={p.data.category}>
                    <img src={im.src} alt="" width={im.width} height={im.height} loading="lazy" />
                    <div class="card__body">
                      <p class="card__meta" style="margin: 0;">
                        {fmt(p.data.publishDate)} · {p.data.category}
                      </p>
                      <h2 style="font-size: var(--text-xl); margin: 0;">
                        <a href={`/blog/${slugOf(p.id)}/`}>{p.data.title}</a>
                      </h2>
                      <p style="margin: 0;">{p.data.description}</p>
                      <p style="margin-top: auto; margin-bottom: 0;">
                        <a href={`/blog/${slugOf(p.id)}/`}>Read the post →</a>
                      </p>
                    </div>
                  </article>
                );
              })}
            </div>
          </>
        ) : (
          <div class="prose flow">
            <h2>Posts are on their way</h2>
            <p>
              Mo's writing is being gathered and will appear here shortly. In the meantime, the
              <a href="/explore/">Explore Astrology</a> library and the
              <a href="/current-sky/">Current Sky</a> letters are full of reading.
            </p>
          </div>
        )
      }
    </div>
  </section>

  <section class="section section--alt">
    <div class="container feature-split">
      <div class="flow">
        <p class="eyebrow">A monthly note from Mo</p>
        <h2 id="blog-newsletter">Keep the conversation going</h2>
        <p>
          My monthly note brings together what I have been noticing, a look at the sky, new writing,
          and the questions I am still turning over. It is correspondence, not another feed to keep
          up with.
        </p>
        <NewsletterForm source="blog" labelledby="blog-newsletter" />
        <p class="card__meta">
          Prefer a reader? <a href="/rss.xml">Subscribe by RSS</a>.
        </p>
      </div>
      <div class="flow">
        <h2>Choose the next path</h2>
        <ul>
          <li><a href="/readings/">Readings</a>, when a real question needs individual synthesis</li>
          <li><a href="/current-sky/">Current Sky</a>, to follow the cycles moving overhead</li>
          <li><a href="/start-here/">Start Here</a>, for a guided introduction to chart language</li>
          <li><a href="/explore/">Explore Astrology</a>, for the full reference library</li>
        </ul>
      </div>
    </div>
  </section>

  <CTABand />
</BaseLayout>

<script>
  const bar = document.querySelector<HTMLElement>('[data-blog-filters]');
  if (bar) {
    const buttons = bar.querySelectorAll<HTMLButtonElement>('button');
    const cards = document.querySelectorAll<HTMLElement>('[data-post-category]');
    const status = document.querySelector<HTMLElement>('[data-blog-status]');
    buttons.forEach((btn) =>
      btn.addEventListener('click', () => {
        const f = btn.dataset.filter!;
        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        let shown = 0;
        cards.forEach((c) => {
          const show = f === 'all' || c.dataset.postCategory === f;
          c.hidden = !show;
          if (show) shown++;
        });
        if (status) status.textContent = `${shown} post${shown === 1 ? '' : 's'} shown`;
      })
    );
  }
</script>
