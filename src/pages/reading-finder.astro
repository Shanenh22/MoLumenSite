---
import { getCollection } from 'astro:content';
import { photos, scenes } from '../config/images';
import { site } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import { bookingActions, finalCtaAction } from '../config/booking.ts';

const services = await getCollection('services');

/**
 * Booking targets are resolved HERE, on the server, and handed to the script.
 *
 * The finder used to build `/book/?service=${book ?? p.slug}` in the browser.
 * For every recommendation carrying an explicit `book` event that was correct,
 * but the ones that fall back to the SERVICE slug went through /book/'s
 * `serviceToEvent` map — which resolves `want-more-clarity` to `clarity-3mo`,
 * the $100 rate that only applies within three months of a natal reading.
 *
 * The finder never asks how long ago that reading was, so it was quietly
 * routing every "go deeper" recommendation to a discounted rate the visitor may
 * not qualify for. Exactly the defect `finalCtaAction` exists to prevent, in the
 * one tool on the site whose whole job is to recommend honestly.
 *
 * So each service now carries the href and label `finalCtaAction` produces, and
 * `eventHrefs` covers the explicit event keys the finder chooses itself (the
 * natal 60/90 split, which IS a real visitor answer to a real question). No URL
 * is assembled in the browser any more.
 */
const bySlug = Object.fromEntries(
  services.map((s) => {
    const cta = finalCtaAction(s.data, `/readings/${s.data.slug}/#options`);
    return [
      s.data.slug,
      {
        name: s.data.name,
        slug: s.data.slug,
        duration: s.data.durationLabel,
        price:
          s.data.priceConfirmed && s.data.price
            ? (s.data.priceLabel ?? `$${s.data.price}`)
            : 'confirmed at booking',
        birth:
          s.data.birthDataRequired === 'none'
            ? 'No birth data needed'
            : s.data.birthDataRequired === 'both'
              ? 'Birth data for both people'
              : 'Your birth date, time, and place',
        purpose: s.data.purpose,
        /** Where "Book this reading" should actually go for this service. */
        bookHref: cta.href,
        /** "Book this reading", or "Review booking options" when the options
            differ by an eligibility condition the finder has not asked about. */
        bookLabel: cta.kind === 'choose' ? 'Review booking options' : 'Book this reading',
      },
    ];
  })
);

/** Every bookable Cal.com event key -> its /book/ deep link. */
const eventHrefs = Object.fromEntries(
  services.flatMap((s) => bookingActions(s.data).map((a) => [a.event, a.href]))
);

const crumbs = [{ label: 'Reading Finder', href: '/reading-finder/' }];
---

<BaseLayout
  title="Reading Finder — which astrology reading fits you?"
  description="Answer five quick questions in plain language and get a straight read on which astrology reading fits your situation. No account, nothing stored, no pressure."
  path="/reading-finder/"
  breadcrumbs={crumbs}
>
  <Breadcrumbs crumbs={crumbs} />
  <section class="hero hero--split">
    <div class="container">
      <div>
      <p class="eyebrow">A little help choosing</p>
      <h1>Find your reading</h1>
      <p class="lede">
        Five quick questions, plain language, and a straight answer at the end — not just a product
        name, but what I'd actually suggest and why. Your answers stay in your browser; nothing is
        stored, and nothing is sent to me unless you choose to send it.
      </p>
      </div>
      <img
        class="hero__img"
        src={scenes.moreClarity.src}
        srcset={scenes.moreClarity.srcset}
        sizes="100vw"
        alt={scenes.moreClarity.alt}
        width={scenes.moreClarity.width}
        height={scenes.moreClarity.height}
        fetchpriority="high"
      />
    </div>
  </section>

  <section class="section">
    <div class="container" style="max-width: 46rem;">
      <div
        class="finder"
        data-finder
        data-services={JSON.stringify(bySlug)}
        data-event-hrefs={JSON.stringify(eventHrefs)}
        data-email={site.email}
      >
        <form>
          {/*
            Question order is deliberate. The old finder opened with "have you
            had a reading before?" — administratively useful and emotionally
            flat. It now opens with what brought them here, because the first
            question sets whether this feels like a form or like the start of a
            conversation, and that decides completion.

            Only `focus` (relationship) and `depth` / `est-need` change the
            recommendation. `birthtime` and `when` exist to make the readback
            specific and to route the right closing action — they earn their
            place by what the reader gets back, not by segmenting them.
          */}
          <div data-step="focus">
            <fieldset>
              <legend>What's bringing you here right now?</legend>
              <label class="choice"
                ><input type="radio" name="focus" value="crossroads" required />
                <span>I'm at a crossroads, and the timing matters</span></label
              >
              <label class="choice"
                ><input type="radio" name="focus" value="patterns" />
                <span>I want to understand myself — why I keep doing what I do</span></label
              >
              <label class="choice"
                ><input type="radio" name="focus" value="relationship" />
                <span>It's about a relationship between two people</span></label
              >
              <label class="choice"
                ><input type="radio" name="focus" value="season" />
                <span>I'm in a hard season and want to make sense of it</span></label
              >
              <label class="choice"
                ><input type="radio" name="focus" value="curious" />
                <span>Honest answer: I'm curious, and I want a good first look</span></label
              >
            </fieldset>
          </div>

          <div data-step="who" hidden>
            <fieldset>
              <legend>Have we worked together before?</legend>
              <label class="choice"
                ><input type="radio" name="who" value="new" />
                <span>No — this would be my first reading with you</span></label
              >
              <label class="choice"
                ><input type="radio" name="who" value="established" />
                <span>Yes — I've had my natal reading and I'm back for more</span></label
              >
            </fieldset>
          </div>

          <div data-step="depth" hidden>
            <fieldset>
              <legend>How much time feels right?</legend>
              <label class="choice"
                ><input type="radio" name="depth" value="full" />
                <span>Give me the full tour — I'd rather not rush it (90 minutes)</span></label
              >
              <label class="choice"
                ><input type="radio" name="depth" value="focused" />
                <span>A solid first look is plenty for now (60 minutes)</span></label
              >
              <label class="choice"
                ><input type="radio" name="depth" value="unsure" />
                <span>I genuinely don't know — tell me what you'd suggest</span></label
              >
            </fieldset>
          </div>

          <div data-step="est-need" hidden>
            <fieldset>
              <legend>What do you need right now?</legend>
              <label class="choice"
                ><input type="radio" name="est-need" value="deeper" />
                <span>To go deeper into parts of my chart or what's ahead</span></label
              >
              <label class="choice"
                ><input type="radio" name="est-need" value="year" />
                <span>My year ahead — it's near my birthday</span></label
              >
              <label class="choice"
                ><input type="radio" name="est-need" value="change" />
                <span>I'm navigating a change: job, home, direction</span></label
              >
              <label class="choice"
                ><input type="radio" name="est-need" value="monthly" />
                <span>Ongoing guidance — a monthly rhythm sounds right</span></label
              >
              <label class="choice"
                ><input type="radio" name="est-need" value="one-topic" />
                <span>One specific topic that needs attention now</span></label
              >
              <label class="choice"
                ><input type="radio" name="est-need" value="relationship" />
                <span>A relationship between two people</span></label
              >
            </fieldset>
          </div>

          {/*
            The birth-time question earns its place twice over. It is the single
            biggest piece of friction in this funnel — there is a whole page
            about tracking one down — and asking here turns a silent drop-off
            into a moment of help. It also genuinely changes what I'd say.

            Deliberately yes / no / not sure. Never the actual time: birth data
            stays out of analytics, URLs and email, per the site's own rule.
          */}
          <div data-step="birthtime" hidden>
            <fieldset>
              <legend>Do you know your birth time?</legend>
              <label class="choice"
                ><input type="radio" name="birthtime" value="yes" />
                <span>Yes — I have it from a certificate or a reliable record</span></label
              >
              <label class="choice"
                ><input type="radio" name="birthtime" value="approx" />
                <span>Roughly — I know the part of the day, not the minute</span></label
              >
              <label class="choice"
                ><input type="radio" name="birthtime" value="no" />
                <span>No, and I'm not sure where to find it</span></label
              >
            </fieldset>
          </div>

          <div data-step="when" hidden>
            <fieldset>
              <legend>When are you hoping to do this?</legend>
              <label class="choice"
                ><input type="radio" name="when" value="soon" />
                <span>Soon — in the next few weeks</span></label
              >
              <label class="choice"
                ><input type="radio" name="when" value="months" />
                <span>Sometime in the next few months</span></label
              >
              <label class="choice"
                ><input type="radio" name="when" value="exploring" />
                <span>No timeline — I'm still working out whether this is for me</span></label
              >
            </fieldset>
          </div>

          <div class="finder__controls">
            <button type="button" class="btn btn--ghost" data-back hidden>Back</button>
            <button type="button" class="btn btn--primary" data-next>Next</button>
            <button type="button" class="btn btn--ghost" data-restart hidden>Start over</button>
            <span class="finder__progress" data-progress>Question 1 of 5</span>
          </div>
        </form>

        <div data-result hidden aria-live="polite"></div>

        <noscript>
          <p>
            The finder needs JavaScript — but choosing is simple: first reading with Mo → the
            <a href="/readings/natal/">Natal Chart Reading</a> (60 or 90 minutes); two people →
            the <a href="/readings/relationship/">Relationship Consultation</a>. Already an
            established client? See the follow-ups on the
            <a href="/readings/">readings page</a>: Want More Clarity, Solar Return, Life
            Changes, Monthly Transits, or a Quick Check-In.
          </p>
        </noscript>
      </div>
      <p class="card__meta" style="margin-top: var(--space-4);">
        The suggestion is exactly that — a suggestion. Every reading is open to you, and
        <a href="/contact/">I'm happy to advise</a> if you're torn.
      </p>

      {/*
        The nurture exit, for the people who answer "no timeline — I'm still
        working out whether this is for me".

        It ships in the markup and hidden, revealed by the result renderer only
        for that answer, because the finder's result is built with innerHTML
        and a Kit embed cannot survive that. It is never a gate: the
        recommendation, the price and all three booking exits are already on
        screen above it by the time this appears, and answering the finder
        never requires an email address.

        This does not replace the free paths that answer already offers — the
        sky letter and the reference library are still named first, and still
        free with no email required. This is one more thing to do, for someone
        who has just told us they are not buying today and would otherwise
        leave with nothing.
      */}
      <div class="finder__nurture" data-finder-nurture hidden>
        <h2 id="finder-newsletter">No rush — shall I keep you posted?</h2>
        <p>
          The Sky This Month is one email a month: what's moving overhead, what it means, and one
          practical thing to do about it. Five minutes to read, unsubscribe anytime. It's the
          easiest way to get a feel for how I think before you spend anything.
        </p>
        <NewsletterForm source="reading-finder" labelledby="finder-newsletter" />
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const root = document.querySelector<HTMLElement>('[data-finder]');
  if (root) {
    const services = JSON.parse(root.dataset.services || '{}');
    // Server-resolved booking targets. Nothing here builds a /book/ URL.
    const eventHrefs = JSON.parse(root.dataset.eventHrefs || '{}');
    const MO_EMAIL = root.dataset.email || '';
    const stepEls: Record<string, HTMLElement> = {};
    root.querySelectorAll<HTMLElement>('[data-step]').forEach((el) => {
      stepEls[el.dataset.step!] = el;
    });
    const backBtn = root.querySelector<HTMLButtonElement>('[data-back]')!;
    const nextBtn = root.querySelector<HTMLButtonElement>('[data-next]')!;
    const restartBtn = root.querySelector<HTMLButtonElement>('[data-restart]')!;
    const progress = root.querySelector<HTMLElement>('[data-progress]')!;
    const result = root.querySelector<HTMLElement>('[data-result]')!;
    const form = root.querySelector('form')!;
    let path: string[] = ['focus'];

    // Shared helper from BaseLayout. These four events existed and fired into
    // nothing for months because gtag was never defined — the optional call
    // made a missing integration indistinguishable from a working one.
    const track = (event: string, params: Record<string, string> = {}) =>
      (window as any).mlTrack?.(event, params);
    track('reading_finder_start');

    const answer = (name: string) =>
      form.querySelector<HTMLInputElement>(`input[name="${name}"]:checked`)?.value ?? null;

    /**
     * Five steps for everyone. The third differs by whether they're an existing
     * client, so the count stays predictable and the progress indicator never
     * lies — a bar that jumps from "3 of 4" to "4 of 5" reads as a trick.
     */
    function nextStepId(): string | null {
      const current = path[path.length - 1];
      if (current === 'focus') return 'who';
      if (current === 'who') return answer('who') === 'established' ? 'est-need' : 'depth';
      if (current === 'depth' || current === 'est-need') return 'birthtime';
      if (current === 'birthtime') return 'when';
      return null; // `when` produces the result
    }

    /**
     * `primary` is a SERVICE slug — it indexes the `services` map and builds
     * /readings/<slug>/ links. `book` is a Cal.com EVENT key and only ever goes
     * into /book/?service=. They are different vocabularies that have drifted
     * apart before (see the vocabulary-drift note in docs/session-handoff.md),
     * so they are separate fields here rather than one value used for both.
     * When they happen to match, `book` is simply omitted.
     */
    function recommend(): {
      primary: string;
      book?: string;
      alt: string | null;
      why: string;
    } {
      const who = answer('who');
      const focus = answer('focus');

      // A relationship question routes the same way whoever is asking.
      if (focus === 'relationship')
        return {
          primary: 'relationship',
          alt: who === 'new' ? 'natal' : 'want-more-clarity',
          why: "I'd read both natal charts together — where affinity flows, where friction lives, and how each of you communicates and feels cared for. It works best with both of you there. If it turns out the real question is about your own patterns in relationships rather than this particular pairing, say so and we'll start with your chart instead.",
        };

      if (who === 'new') {
        const depth = answer('depth');
        if (depth === 'focused')
          return {
            primary: 'natal',
            book: 'natal-60',
            alt: null,
            why: "We start where I start with everyone: your whole birth chart. Sixty minutes is a real reading — enough to lay out the shape of the chart and connect it to what's actually going on for you. If you find yourself with more questions afterwards, that's what the follow-up is for.",
          };
        if (depth === 'full')
          return {
            primary: 'natal',
            book: 'natal-90',
            alt: null,
            why: "Ninety minutes is the full tour: the whole chart, the patterns running through it, and what the current sky is stirring — with room for your questions as we go rather than crammed into the last five minutes. It's the foundation every other reading builds on.",
          };
        return {
          primary: 'natal',
          book: 'natal-90',
          alt: null,
          why: "Since you asked what I'd suggest: take the ninety. People who arrive with a real question almost always want more time than they expect, and the extra half hour is where the conversation usually gets useful. Sixty is a genuine reading too if you'd rather start smaller — both are on the booking page.",
        };
      }
      const need = answer('est-need');
      if (need === 'year')
        return {
          primary: 'solar-return',
          alt: 'monthly-transits',
          why: 'The Solar Return Reading is the yearly check-in: when the Sun returns to its birth position, the rest of the sky has moved, and your new year has its own themes. Book it near your birthday.',
        };
      if (need === 'change')
        return {
          primary: 'life-changes',
          alt: 'want-more-clarity',
          why: "The Life Changes Consultation reads the current sky against your natal chart, focused on the transition you're in — which areas are being influenced, and the themes emerging.",
        };
      if (need === 'monthly')
        return {
          primary: 'monthly-transits',
          alt: 'solar-return',
          why: "Monthly Personal Transits is a standing 30-minute Zoom each month on how the month's movements resonate with your chart specifically — individualized, not a general forecast.",
        };
      if (need === 'one-topic')
        return {
          primary: 'quick-check-in',
          alt: 'want-more-clarity',
          why: 'The Quick Check-In takes one named topic — the suddenly-chaotic area, or the one place you want to grow — and spends thirty focused minutes on how your current influences are affecting it.',
        };
      if (need === 'relationship')
        return {
          primary: 'relationship',
          alt: null,
          why: "The Relationship Consultation reads both natal charts together — affinities, frictions, communication styles, and what helps each of you feel secure. Both people's presence is preferred.",
        };
      return {
        primary: 'want-more-clarity',
        alt: 'quick-check-in',
        why: "Want More Clarity is exactly this: a full hour to go deeper into parts of your chart or future aspects — $100 if it's within three months of your natal reading, $130 after.",
      };
    }

    /**
     * Per-step progression, so the length of this finder can be argued about
     * with evidence instead of with CRO folklore.
     *
     * It went from two questions to five deliberately — the readback is the
     * whole point and it needs the answers — but nobody has ever been able to
     * see what that cost, because the only events were start and complete.
     * A drop-off concentrated on one question is a fixable question; an even
     * bleed across five is an argument for a shorter finder. Those look
     * identical from start/complete alone.
     *
     * The step id and its number, and nothing else. Never the answer: two of
     * these questions are about birth time and personal circumstance, and the
     * site's rule is that none of that reaches analytics. `reading_finder_intent`
     * already reports the timing answer, which is the one enumerated label
     * that says who to book and who to keep warm.
     */
    const seenSteps = new Set<string>();
    function trackStep(stepId: string, index: number) {
      if (seenSteps.has(stepId)) return; // going Back must not re-report
      seenSteps.add(stepId);
      track('reading_finder_step', { step: stepId, number: String(index + 1) });
    }
    trackStep('focus', 0);

    function show(stepId: string) {
      Object.values(stepEls).forEach((el) => (el.hidden = true));
      stepEls[stepId].hidden = false;
      result.hidden = true;
      nextBtn.hidden = false;
      const idx = path.indexOf(stepId);
      backBtn.hidden = idx === 0;
      restartBtn.hidden = idx === 0;
      nextBtn.textContent = stepId === 'when' ? 'Show me what you’d suggest' : 'Next';
      progress.textContent = `Question ${idx + 1} of 5`;
      trackStep(stepId, idx);
      stepEls[stepId].querySelector<HTMLInputElement>('input')?.focus();
    }

    /**
     * The readback — "here's what I'm hearing" — in Mo's voice.
     *
     * This is the point of asking five questions instead of two. A bare product
     * name is a vending machine; reflecting someone's own situation back to them
     * before naming a price is how you demonstrate you were listening, and it is
     * the closest a website gets to how the actual reading opens. It also makes
     * the "send this to Mo" option honest — there is something worth sending.
     */
    const ESC: Record<string, string> = {
      '&': '&amp;',
      '<': '&lt;',
      '>': '&gt;',
      '"': '&quot;',
    };
    const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ESC[c]);

    const FOCUS_LINE: Record<string, string> = {
      crossroads: "you're at a crossroads where the timing matters",
      patterns: 'you want to understand your own patterns',
      relationship: "you're asking about a relationship between two people",
      season: "you're in a hard season and want to make sense of it",
      curious: "you're curious and want a good first look",
    };
    /**
     * The handoff to the Birth Time Confidence check runs in ONE direction:
     * from here to there, never back.
     *
     * This finder already asks the birth-time question, and it is the right
     * place for it — it is the biggest piece of friction in this funnel and
     * asking here turns a silent drop-off into a moment of help. What it must
     * not do is compete. The confidence check grades evidence quality and never
     * recommends a reading; this finder recommends a reading and does not grade
     * anything. Two tools answering the same question in different shapes is
     * worse than either alone, so `approx` and `no` point at the check and the
     * check points back at nothing.
     */
    const BIRTH_LINE: Record<string, string> = {
      yes: "You have your birth time, which matters more than people expect — it's what gives us your rising sign and your houses, and that's the difference between a chart that's yours and one that could belong to anybody born that day.",
      approx:
        "You know roughly when you were born. That's usually workable — I can often narrow it from the part of the day, and I'll tell you honestly if it's too wide to trust the houses. <a href=\"/birth-time-toolkit/#confidence-check\">Three questions will tell you how much weight your time can carry</a>, and <a href=\"/birth-time/\">here's where people usually find the exact one</a>.",
      no: "You don't have your birth time, and I want to say plainly: that is not a dealbreaker. Your Sun and almost always your Moon are still solid. What we'd be guessing at is the rising sign and the houses, so I'd rather tell you that up front than pretend otherwise. <a href=\"/birth-time/\">Here's where to look for it</a> — a birth certificate is the usual answer — and <a href=\"/birth-time-toolkit/#confidence-check\">this will tell you what you're working with</a> in the meantime.",
    };

    function readback(): string {
      const focus = answer('focus');
      const who = answer('who');
      const bits: string[] = [];
      if (focus && FOCUS_LINE[focus]) bits.push(FOCUS_LINE[focus]);
      bits.push(
        who === 'established'
          ? "we've worked together before"
          : 'this would be your first reading with me',
      );
      return `${bits.join(', and ')}.`;
    }

    function showResult() {
      const { primary, book, alt, why } = recommend();
      const p = services[primary];
      const a = alt ? services[alt] : null;
      // An explicit `book` is an event the finder chose from a real answer
      // (the natal 60/90 question). Otherwise take the service's own
      // resolved target, which is a booking link when the reading has one
      // obvious option and a link to its priced options when it does not.
      const bookHref = (book && eventHrefs[book]) || p.bookHref;
      const bookLabel = book ? 'Book this reading' : p.bookLabel;
      const when = answer('when');
      const birth = answer('birthtime');

      track('reading_finder_complete', { recommendation: primary });
      track('reading_recommendation_view', { service: primary });
      // Intent is the one answer worth reporting: it says who to book and who to
      // keep warm. No birth data is ever tracked, sent, or put in a URL.
      if (when) track('reading_finder_intent', { intent: when });

      Object.values(stepEls).forEach((el) => (el.hidden = true));
      result.hidden = false;
      backBtn.hidden = false;
      restartBtn.hidden = false;
      nextBtn.hidden = true;
      progress.textContent = 'Here’s what I’d suggest';

      /**
       * Three exits, weighted by the timing answer. One button assumes everyone
       * is ready today; most people are not, and the ones who aren't were
       * previously given nothing to do but leave.
       */
      const ready = when === 'soon';
      const mailBody = [
        'Hi Mo,',
        '',
        'I used the Reading Finder on your site and it suggested the ' + p.name + '.',
        '',
        'What I said:',
        '• What brought me here: ' + (FOCUS_LINE[answer('focus') ?? ''] ?? '—'),
        '• Worked together before: ' + (answer('who') === 'established' ? 'yes' : 'no'),
        '• Birth time: ' +
          (birth === 'yes' ? 'I have it' : birth === 'approx' ? 'roughly' : "don't have it"),
        '• Timing: ' +
          (when === 'soon'
            ? 'in the next few weeks'
            : when === 'months'
              ? 'in the next few months'
              : 'still deciding'),
        '',
        'My question is:',
        '',
      ].join('\n');
      const mailto =
        'mailto:' +
        MO_EMAIL +
        '?subject=' +
        encodeURIComponent('Reading Finder — ' + p.name) +
        '&body=' +
        encodeURIComponent(mailBody);

      result.innerHTML = `
        <h2>Here’s what I’m hearing</h2>
        <p class="finder__readback">${esc(readback())}</p>
        <p>${birth && BIRTH_LINE[birth] ? BIRTH_LINE[birth] : ''}</p>
        <h3>So I’d suggest the ${esc(p.name)}</h3>
        <p>${why}</p>
        <dl class="factlist">
          <dt>Length</dt><dd>${esc(p.duration)}</dd>
          <dt>Price</dt><dd>${esc(p.price)}</dd>
          <dt>You'll need</dt><dd>${esc(p.birth)}</dd>
        </dl>
        <div class="finder__exits">
          <a class="btn ${ready ? 'btn--primary' : 'btn--ghost'}" href="${bookHref}">${esc(bookLabel)}</a>
          <a class="btn ${ready ? 'btn--ghost' : 'btn--primary'}" href="${mailto}">Send this to me first</a>
          <a class="btn btn--ghost" href="/readings/${p.slug}/">Full details</a>
        </div>
        <p class="card__meta">
          “Send this to me” opens your own email with your answers filled in, so you can add the
          actual question before you decide anything. Nothing is sent until you press send.
        </p>
        ${a ? `<p>Also worth a look: <a href="/readings/${a.slug}/">${esc(a.name)}</a> — ${esc(a.purpose)}</p>` : ''}
        ${
          when === 'exploring'
            ? `<p>And if you're still working out whether this is for you, don't book anything yet. <a href="/current-sky/">Read the sky letter</a> or <a href="/explore/">the reference library</a> first — both are free, and they'll tell you more about how I think than any sales page will.</p>`
            : `<p>The suggestion is exactly that. Every reading is open to you, and this is your call.</p>`
        }`;
      // The nurture block, for the "still deciding" answer only. Everyone else
      // has a reading to book and does not need a mailing list in the way.
      const nurture = document.querySelector<HTMLElement>('[data-finder-nurture]');
      if (nurture) nurture.hidden = when !== 'exploring';

      result.querySelector('h2')?.setAttribute('tabindex', '-1');
      (result.querySelector('h2') as HTMLElement)?.focus();
    }

    nextBtn.addEventListener('click', () => {
      const current = path[path.length - 1];
      const name = stepEls[current].querySelector('input')!.name;
      if (!answer(name)) {
        stepEls[current].querySelector<HTMLInputElement>('input')?.focus();
        progress.textContent = 'Please choose an option to continue';
        return;
      }
      const next = nextStepId();
      if (next) {
        path.push(next);
        show(next);
      } else {
        showResult();
      }
    });
    backBtn.addEventListener('click', () => {
      if (!result.hidden) {
        show(path[path.length - 1]);
      } else if (path.length > 1) {
        path.pop();
        show(path[path.length - 1]);
      }
    });
    restartBtn.addEventListener('click', () => {
      form.reset();
      path = ['focus'];
      const nurture = document.querySelector<HTMLElement>('[data-finder-nurture]');
      if (nurture) nurture.hidden = true;
      show('focus');
    });
    // Going Back from the result also leaves the result, so the nurture block
    // must not linger under a question.
    backBtn.addEventListener('click', () => {
      const nurture = document.querySelector<HTMLElement>('[data-finder-nurture]');
      if (nurture) nurture.hidden = true;
    });
  }
</script>
