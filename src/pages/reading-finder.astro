---
import { getCollection } from 'astro:content';
import { photos, scenes } from '../config/images';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const services = await getCollection('services');
const bySlug = Object.fromEntries(
  services.map((s) => [
    s.data.slug,
    {
      name: s.data.name,
      slug: s.data.slug,
      duration: s.data.durationLabel,
      price:
        s.data.priceConfirmed && s.data.price
          ? (s.data.priceLabel ?? `$${s.data.price}`)
          : 'confirmed at booking',
      birth:
        s.data.birthDataRequired === 'none'
          ? 'No birth data needed'
          : s.data.birthDataRequired === 'both'
            ? 'Birth data for both people'
            : 'Your birth date, time, and place',
      purpose: s.data.purpose,
    },
  ])
);
const crumbs = [{ label: 'Reading Finder', href: '/reading-finder/' }];
---

<BaseLayout
  title="Reading Finder — which astrology reading fits you?"
  description="Answer two quick questions in plain language and find the astrology reading that fits your situation. No account, no stored answers, no pressure."
  path="/reading-finder/"
  breadcrumbs={crumbs}
>
  <Breadcrumbs crumbs={crumbs} />
  <section class="hero hero--split">
    <div class="container">
      <div>
      <p class="eyebrow">A little help choosing</p>
      <h1>Find your reading</h1>
      <p class="lede">
        Two quick questions, plain language, and a suggestion at the end. Nothing you answer here
        is stored or sent anywhere — and you're always welcome to choose any reading you like.
      </p>
      </div>
      <img
        class="hero__img"
        src={scenes.moreClarity.src}
        srcset={scenes.moreClarity.srcset}
        sizes="100vw"
        alt={scenes.moreClarity.alt}
        width={scenes.moreClarity.width}
        height={scenes.moreClarity.height}
        fetchpriority="high"
      />
    </div>
  </section>

  <section class="section">
    <div class="container" style="max-width: 46rem;">
      <div class="finder" data-finder data-services={JSON.stringify(bySlug)}>
        <form>
          <div data-step="who">
            <fieldset>
              <legend>Have you had a reading with Mo before?</legend>
              <label class="choice"
                ><input type="radio" name="who" value="new" required />
                <span>No — this would be my first reading with Mo</span></label
              >
              <label class="choice"
                ><input type="radio" name="who" value="established" />
                <span>Yes — I've had my natal reading and I'm back for more</span></label
              >
            </fieldset>
          </div>

          <div data-step="new-need" hidden>
            <fieldset>
              <legend>What brings you here?</legend>
              <label class="choice"
                ><input type="radio" name="new-need" value="deep" />
                <span>I want to understand myself and my life patterns — the full picture</span></label
              >
              <label class="choice"
                ><input type="radio" name="new-need" value="essentials" />
                <span>I'm curious and want a solid first look without the longest session</span></label
              >
              <label class="choice"
                ><input type="radio" name="new-need" value="relationship" />
                <span>It's about a relationship between two people</span></label
              >
            </fieldset>
          </div>

          <div data-step="est-need" hidden>
            <fieldset>
              <legend>What do you need right now?</legend>
              <label class="choice"
                ><input type="radio" name="est-need" value="deeper" />
                <span>To go deeper into parts of my chart or what's ahead</span></label
              >
              <label class="choice"
                ><input type="radio" name="est-need" value="year" />
                <span>My year ahead — it's near my birthday</span></label
              >
              <label class="choice"
                ><input type="radio" name="est-need" value="change" />
                <span>I'm navigating a change: job, home, direction</span></label
              >
              <label class="choice"
                ><input type="radio" name="est-need" value="monthly" />
                <span>Ongoing guidance — a monthly rhythm sounds right</span></label
              >
              <label class="choice"
                ><input type="radio" name="est-need" value="one-topic" />
                <span>One specific topic that needs attention now</span></label
              >
              <label class="choice"
                ><input type="radio" name="est-need" value="relationship" />
                <span>A relationship between two people</span></label
              >
            </fieldset>
          </div>

          <div class="finder__controls">
            <button type="button" class="btn btn--ghost" data-back hidden>Back</button>
            <button type="button" class="btn btn--primary" data-next>Next</button>
            <button type="button" class="btn btn--ghost" data-restart hidden>Start over</button>
            <span class="finder__progress" data-progress>Question 1 of 2</span>
          </div>
        </form>

        <div data-result hidden aria-live="polite"></div>

        <noscript>
          <p>
            The finder needs JavaScript — but choosing is simple: first reading with Mo → the
            <a href="/readings/natal/">Natal Chart Reading</a> (60 or 90 minutes); two people →
            the <a href="/readings/relationship/">Relationship Consultation</a>. Already an
            established client? See the follow-ups on the
            <a href="/readings/">readings page</a>: Want More Clarity, Solar Return, Life
            Changes, Monthly Transits, or a Quick Check-In.
          </p>
        </noscript>
      </div>
      <p class="card__meta" style="margin-top: var(--space-4);">
        The suggestion is exactly that — a suggestion. Every reading is open to you, and
        <a href="/contact/">Mo is happy to advise</a> if you're torn.
      </p>
    </div>
  </section>
</BaseLayout>

<script>
  const root = document.querySelector<HTMLElement>('[data-finder]');
  if (root) {
    const services = JSON.parse(root.dataset.services || '{}');
    const stepEls: Record<string, HTMLElement> = {};
    root.querySelectorAll<HTMLElement>('[data-step]').forEach((el) => {
      stepEls[el.dataset.step!] = el;
    });
    const backBtn = root.querySelector<HTMLButtonElement>('[data-back]')!;
    const nextBtn = root.querySelector<HTMLButtonElement>('[data-next]')!;
    const restartBtn = root.querySelector<HTMLButtonElement>('[data-restart]')!;
    const progress = root.querySelector<HTMLElement>('[data-progress]')!;
    const result = root.querySelector<HTMLElement>('[data-result]')!;
    const form = root.querySelector('form')!;
    let path: string[] = ['who'];

    const track = (event: string, params: Record<string, string> = {}) =>
      (window as any).gtag?.('event', event, params);
    track('reading_finder_start');

    const answer = (name: string) =>
      form.querySelector<HTMLInputElement>(`input[name="${name}"]:checked`)?.value ?? null;

    function nextStepId(): string | null {
      const current = path[path.length - 1];
      if (current === 'who') return answer('who') === 'established' ? 'est-need' : 'new-need';
      return null; // second answer produces the result
    }

    function recommend(): { primary: string; alt: string | null; why: string } {
      const who = answer('who');
      if (who === 'new') {
        const need = answer('new-need');
        if (need === 'relationship')
          return {
            primary: 'relationship',
            alt: 'natal',
            why: "The Relationship Consultation reads both natal charts together — affinities, frictions, and how each of you communicates and feels cared for. Both people's presence is preferred. (If it's really about your own patterns in relationships, the natal reading goes there too.)",
          };
        if (need === 'essentials')
          return {
            primary: 'natal',
            alt: null,
            why: "Every client relationship with Mo starts at the natal chart — and the 60-minute option gives you a solid first look at $150. If you already know you'll have lots of questions, the 90-minute session gives the conversation room to breathe.",
          };
        return {
          primary: 'natal',
          alt: null,
          why: 'The 90-minute Natal Chart Reading is the full tour: your whole chart, its patterns and connections, and what the current sky is stirring — with room for your questions throughout. It\'s the foundation every other reading builds on.',
        };
      }
      const need = answer('est-need');
      if (need === 'year')
        return {
          primary: 'solar-return',
          alt: 'monthly-transits',
          why: 'The Solar Return Reading is the yearly check-in: when the Sun returns to its birth position, the rest of the sky has moved, and your new year has its own themes. Book it near your birthday.',
        };
      if (need === 'change')
        return {
          primary: 'life-changes',
          alt: 'want-more-clarity',
          why: "The Life Changes Consultation reads the current sky against your natal chart, focused on the transition you're in — which areas are being influenced, and the themes emerging.",
        };
      if (need === 'monthly')
        return {
          primary: 'monthly-transits',
          alt: 'solar-return',
          why: "Monthly Personal Transits is a standing 30-minute Zoom each month on how the month's movements resonate with your chart specifically — individualized, not a general forecast.",
        };
      if (need === 'one-topic')
        return {
          primary: 'quick-check-in',
          alt: 'want-more-clarity',
          why: 'The Quick Check-In takes one named topic — the suddenly-chaotic area, or the one place you want to grow — and spends thirty focused minutes on how your current influences are affecting it.',
        };
      if (need === 'relationship')
        return {
          primary: 'relationship',
          alt: null,
          why: "The Relationship Consultation reads both natal charts together — affinities, frictions, communication styles, and what helps each of you feel secure. Both people's presence is preferred.",
        };
      return {
        primary: 'want-more-clarity',
        alt: 'quick-check-in',
        why: "Want More Clarity is exactly this: a full hour to go deeper into parts of your chart or future aspects — $100 if it's within three months of your natal reading, $130 after.",
      };
    }

    function show(stepId: string) {
      Object.values(stepEls).forEach((el) => (el.hidden = true));
      stepEls[stepId].hidden = false;
      result.hidden = true;
      nextBtn.hidden = false;
      const idx = path.indexOf(stepId);
      backBtn.hidden = idx === 0;
      restartBtn.hidden = idx === 0;
      nextBtn.textContent = stepId === 'who' ? 'Next' : 'Show my suggestion';
      progress.textContent = `Question ${idx + 1} of 2`;
      stepEls[stepId].querySelector<HTMLInputElement>('input')?.focus();
    }

    function showResult() {
      const { primary, alt, why } = recommend();
      const p = services[primary];
      const a = alt ? services[alt] : null;
      track('reading_finder_complete', { recommendation: primary });
      track('reading_recommendation_view', { service: primary });
      Object.values(stepEls).forEach((el) => (el.hidden = true));
      result.hidden = false;
      backBtn.hidden = false;
      restartBtn.hidden = false;
      nextBtn.hidden = true;
      progress.textContent = 'Suggestion ready';
      result.innerHTML = `
        <h2>Our suggestion: ${p.name}</h2>
        <p>${why}</p>
        <dl class="factlist">
          <dt>Length</dt><dd>${p.duration}</dd>
          <dt>Price</dt><dd>${p.price}</dd>
          <dt>You'll need</dt><dd>${p.birth}</dd>
        </dl>
        <p>
          <a class="btn btn--primary" href="/book/?service=${p.slug}">Book this reading</a>
          <a class="btn btn--ghost" href="/readings/${p.slug}/">Full details</a>
        </p>
        ${a ? `<p>Also worth a look: <a href="/readings/${a.slug}/">${a.name}</a> — ${a.purpose}</p>` : ''}
        <p>And remember — you're welcome to choose any reading. This is your call.</p>`;
      result.querySelector('h2')?.setAttribute('tabindex', '-1');
      (result.querySelector('h2') as HTMLElement)?.focus();
    }

    nextBtn.addEventListener('click', () => {
      const current = path[path.length - 1];
      const name = stepEls[current].querySelector('input')!.name;
      if (!answer(name)) {
        stepEls[current].querySelector<HTMLInputElement>('input')?.focus();
        progress.textContent = 'Please choose an option to continue';
        return;
      }
      const next = nextStepId();
      if (next) {
        path.push(next);
        show(next);
      } else {
        showResult();
      }
    });
    backBtn.addEventListener('click', () => {
      if (!result.hidden) {
        show(path[path.length - 1]);
      } else if (path.length > 1) {
        path.pop();
        show(path[path.length - 1]);
      }
    });
    restartBtn.addEventListener('click', () => {
      form.reset();
      path = ['who'];
      show('who');
    });
  }
</script>
