---
import BaseLayout from '../layouts/BaseLayout.astro';
import SeaBreak from '../components/SeaBreak.astro';
import { celestial, photos, scenes } from '../config/images';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CTABand from '../components/CTABand.astro';

const crumbs = [{ label: 'Approach', href: '/approach/' }];

const principles = [
  {
    title: 'The whole chart matters more than one label',
    idea: 'Planets, signs, houses, aspects, condition, and timing change one another. A single placement can be useful, but it is never the finished story.',
    practice: 'If one placement looks important, I keep looking: What supports it? What complicates it? Is another pattern louder? Then I bring that larger picture into the conversation.',
  },
  {
    title: 'Your experience is part of the interpretation',
    idea: 'The same configuration can be lived in more than one way. Technique gives me possibilities; your life helps us understand which possibilities are actually relevant.',
    practice: 'If something I see does not match your experience, I do not treat that as resistance or a failed reading. I get curious about the mismatch and look again.',
  },
  {
    title: 'Intuition points; it does not pronounce',
    idea: 'Intuition can draw my attention toward a possibility or a question worth asking. I do not treat an impression as unquestionable fact.',
    practice: 'I may say, “This is making me wonder about…” and then check the chart, the technique, and what you tell me before deciding how much weight it deserves.',
  },
  {
    title: 'Timing creates perspective, not orders',
    idea: 'Astrology can describe conditions, seasons, pressure points, openings, and recurring themes. It cannot make the decision for you.',
    practice: 'We can talk about what appears active and what choices may deserve more attention. I will not tell you that a transit requires you to quit, marry, move, stay, or leave.',
  },
  {
    title: 'Candor and compassion belong together',
    idea: 'I will not make difficult symbolism disappear, and I will not turn it into punishment or doom.',
    practice: 'I will name what looks challenging, explain why I am saying it, and keep the focus on understanding the pattern and the choices around it rather than frightening you with certainty.',
  },
] as const;
---

<BaseLayout
  title="My Approach: how I read a chart"
  description="How Mo Lumen practices astrology in an actual reading: whole-chart synthesis, collaborative interpretation, careful intuition, timing, candor, and client agency."
  path="/approach/"
  breadcrumbs={crumbs}
>
  <Breadcrumbs crumbs={crumbs} />

  <section class="hero hero--split">
    <div class="container">
      <div>
        <p class="eyebrow">How I work</p>
        <h1>How I read a chart</h1>
        <p class="lede">
          Technique matters. So do context, curiosity, conversation, and the person actually living
          the chart. Here is what those ideas change when we are sitting together in a reading.
        </p>
      </div>
      <img
        class="hero__img"
        src={scenes.approachPhilosophy.src}
        srcset={scenes.approachPhilosophy.srcset}
        sizes="100vw"
        alt={scenes.approachPhilosophy.alt}
        width={scenes.approachPhilosophy.width}
        height={scenes.approachPhilosophy.height}
        fetchpriority="high"
      />
    </div>
  </section>

  <section class="section">
    <div class="container grid grid--2" style="align-items: start;">
      <figure class="portrait-card">
        <img
          src={photos.moApproach.src}
          alt="Mo Lumen"
          width={photos.moApproach.width}
          height={photos.moApproach.height}
          loading="lazy"
        />
      </figure>
      <div class="prose flow">
        <p class="eyebrow">The short version</p>
        <h2>I am not reading a chart at you.</h2>
        <p>
          I prepare carefully and I will guide the conversation. I will also ask questions, explain
          what I am seeing, and pay attention to whether the symbolism is showing up in your actual
          life and how.
        </p>
        <p>
          That is not a compromise in the technique. It is how a general symbolic language becomes
          specific enough to be useful to one person.
        </p>
        <blockquote>There is fate and there is choice, and a good reading helps you tell the difference.</blockquote>
      </div>
    </div>
  </section>

  <SeaBreak image={celestial.galaxyTidepool} />

  <section class="section section--sea">
    <div class="container" style="max-width: 68rem;">
      <p class="eyebrow">Principles in practice</p>
      <h2>What my approach changes in a reading</h2>
      <div class="approach-principles" style="margin-top: var(--space-7);">
        {principles.map((principle, index) => (
          <article class="approach-principle">
            <div class="approach-principle__number" aria-hidden="true">{index + 1}</div>
            <div>
              <h3>{principle.title}</h3>
              <p>{principle.idea}</p>
              <div class="callout" style="margin-bottom: 0;">
                <p class="approach-principle__label">What this looks like in practice</p>
                <p style="margin: 0;">{principle.practice}</p>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container grid grid--2" style="align-items: start;">
      <div class="prose flow">
        <p class="eyebrow">Technique and judgment</p>
        <h2>I study broadly, then choose what serves the chart and question</h2>
        <p>
          Most of my foundational training is in Medieval and Renaissance astrology, including
          planetary condition, rulership, prediction, and horary, with additional study of
          Hellenistic techniques such as lots and various timing methods. My practice also
          incorporates modern astrology, including the outer planets and dwarf planets, along with
          attention to meaning, development, inner life, and the ways a person actually experiences
          the chart. I use the lunar nodes in my readings, but I am not an evolutionary astrologer,
          nor do I practice Vedic astrology.
        </p>
        <p>
          When a method makes a stronger or more specific claim, I will tell you that. When the
          symbolism supports several possibilities, I will tell you that too. I would rather be
          precise about uncertainty than manufacture confidence.
        </p>
      </div>
      <aside class="card">
        <h2 style="font-size: var(--text-xl); margin: 0;">What I won't do</h2>
        <ul style="margin: 0;">
          <li>Use fear, doom timelines, or “the stars say you must.”</li>
          <li>Present an intuitive impression as unquestionable fact.</li>
          <li>Give medical, psychological, legal, or financial advice in place of a licensed professional.</li>
          <li>Pressure you to agree, rebook, or hand over your decisions.</li>
        </ul>
      </aside>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container prose flow">
      <p class="eyebrow">Ethics in practice</p>
      <h2>Your chart is personal information, not content</h2>
      <p>
        Your birth data and what you share in a session are treated as confidential and sensitive.
        Readings are for adults 18 and over, and I follow the ethical standards of the professional
        organizations I belong to and serve. The <a href="/disclaimer/">disclaimer</a> and
        <a href="/privacy/">privacy policy</a> spell out the details in plain language.
      </p>
    </div>
  </section>

  <CTABand
    heading="Want to see how this feels in the room?"
    body="How Readings Work walks through the preparation, the conversation itself, and what happens afterward so you can decide whether this way of working fits you."
    buttonLabel="How Readings Work"
    buttonHref="/how-readings-work/"
    secondaryLabel="Not sure which reading fits? Try the Reading Finder"
    secondaryHref="/reading-finder/"
  />
</BaseLayout>

<style>
  .approach-principles {
    display: grid;
    gap: var(--space-8);
  }
  .approach-principle {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    gap: var(--space-5);
    align-items: start;
  }
  .approach-principle__number {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 999px;
    background: var(--color-teal-tint);
    color: var(--color-teal);
    font-weight: 800;
  }
  .approach-principle__label {
    margin-bottom: var(--space-2);
    font-size: var(--text-sm);
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-teal);
  }
  @media (max-width: 520px) {
    .approach-principle {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }
  }
</style>
