---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CTABand from '../components/CTABand.astro';
const crumbs = [{ label: 'Resources', href: '/resources/' }];
---

<BaseLayout
  title="Resources"
  description="Everything free at Mo Lumen Astrology in one place: the learning hub, tools, current sky, videos, newsletter, and guides — plus what's coming."
  path="/resources/"
  breadcrumbs={crumbs}
>
  <Breadcrumbs crumbs={crumbs} />
  <section class="hero">
    <div class="container">
      <p class="eyebrow">Start anywhere</p>
      <h1>Resources</h1>
      <p class="lede">Everything free on this site, gathered in one place.</p>
    </div>
  </section>
  <section class="section">
    <div class="container grid grid--3">
      {
        [
          ['Explore Astrology', '/explore/', 'The full learning hub: basics, planets, signs, houses, aspects, and more.'],
          ['Explore Your Chart', '/tools/explore-your-chart/', 'Interactive chart anatomy — click and learn.'],
          ['Reading Finder', '/reading-finder/', 'Three questions to the right reading.'],
          ['Current Sky', '/current-sky/', 'Verified dates for lunations, eclipses, and retrogrades.'],
          ['Horoscopes', '/horoscopes/', 'Rising-sign guidance with each lunation.'],
          ['Videos', '/videos/', 'Mo on YouTube and Instagram.'],
          ['Glossary', '/explore/glossary/', 'Every term, plainly defined.'],
          ['Newsletter', '/newsletter/', 'The Sky This Month, free by email.'],
          ['Guides', '/guides/', 'Downloadable references — first one in progress.'],
        ].map(([t, href, d]) => (
          <article class="card">
            <h2 style="font-size: var(--text-lg); margin: 0;">
              <a href={href}>{t}</a>
            </h2>
            <p style="margin: 0;">{d}</p>
          </article>
        ))
      }
    </div>
  </section>
  <CTABand />
</BaseLayout>
