---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page not found"
  description="This page doesn't exist, but there are several useful ways back into Mo Lumen Astrology."
  path="/404/"
  noindex={true}
>
  <section class="section" style="min-height: 55vh; display: grid; place-content: center;">
    <div class="container center flow" style="max-width: 48rem;">
      <p class="eyebrow">404: not found</p>
      <h1>This page isn't here.</h1>
      <p class="lede" style="margin-inline: auto;">
        The address may have changed during the site rebuild, or the link may have been mistyped.
        You do not have to start over; choose the path that is closest to what you came for.
      </p>

      <div class="grid grid--3" style="text-align: left; margin-top: var(--space-6);">
        <article class="card">
          <h2 style="font-size: var(--text-lg); margin: 0;"><a href="/readings/">I am considering a reading</a></h2>
          <p style="margin: 0;">Compare the readings, or use the Reading Finder if you are not sure which one fits.</p>
          <p style="margin: 0;"><a href="/reading-finder/">Use the Reading Finder →</a></p>
        </article>
        <article class="card">
          <h2 style="font-size: var(--text-lg); margin: 0;"><a href="/explore/">I came to learn</a></h2>
          <p style="margin: 0;">Explore planets, signs, houses, aspects, chart structure, and the ideas behind the practice.</p>
          <p style="margin: 0;"><a href="/start-here/">Start with the basics →</a></p>
        </article>
        <article class="card">
          <h2 style="font-size: var(--text-lg); margin: 0;"><a href="/current-sky/">I was following the sky</a></h2>
          <p style="margin: 0;">Find current events, rising-sign guidance, the calendar, and the archive.</p>
          <p style="margin: 0;"><a href="/current-sky/calendar/">See the Sky Calendar →</a></p>
        </article>
      </div>

      <p class="card__meta" style="margin-top: var(--space-6);">
        Still looking for something specific? <a href="/resources/">See all resources</a>,
        <a href="/contact/"> ask Mo</a>, or <a href="/">return to the homepage</a>.
      </p>
    </div>
  </section>
</BaseLayout>
