---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page not found"
  description="This page doesn't exist — but the rest of the sky does."
  path="/404/"
  noindex={true}
>
  <section class="section" style="min-height: 55vh; display: grid; place-content: center;">
    <div class="container center flow" style="max-width: 40rem;">
      <p class="eyebrow">404 — not found</p>
      <h1>This page isn't in the chart.</h1>
      <p class="lede" style="margin-inline: auto;">
        The address may have changed in our site rebuild, or the link was mistyped. Either way,
        nothing here is lost for good.
      </p>
      <p>
        <a class="btn btn--primary" href="/">Back to the homepage</a>
        <a class="btn btn--ghost" href="/readings/">See the readings</a>
      </p>
      <p class="card__meta">
        Looking for something specific? <a href="/contact/">Ask Mo</a> — or try the
        <a href="/resources/">resources page</a>, which links everything.
      </p>
    </div>
  </section>
</BaseLayout>
