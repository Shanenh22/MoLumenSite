---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CTABand from '../components/CTABand.astro';
import Icon from '../components/Icon.astro';
import { celestial } from '../config/images';

const approved = (await getCollection('testimonials')).filter((t) => t.data.approved);
const isDev = import.meta.env.DEV;
const crumbs = [{ label: 'Testimonials', href: '/testimonials/' }];
const signals = [
  {
    icon: 'chart' as const,
    title: 'Training you can verify',
    body: "A Practitioner's Certificate in Horary Astrology from the School of Traditional Astrology, NCGR-PAA Levels 1 and 2 passed, and board service with OPA. Named schools and named examinations, with the details gathered in one place.",
    href: '/credentials/',
    linkText: 'See the credentials',
  },
  {
    icon: 'book' as const,
    title: 'The reasoning is public',
    body: 'The learning library separates astronomical fact, astrological tradition, contemporary interpretation, and my own synthesis. You can read how I think before deciding whether you want me to think through your chart with you.',
    href: '/explore/',
    linkText: 'Read the library',
  },
  {
    icon: 'moon' as const,
    title: 'The limits are stated up front',
    body: 'The reading pages explain what each service is and is not for, and the disclaimer states the boundaries around medical, legal, financial, and other high-stakes decisions.',
    href: '/disclaimer/',
    linkText: 'Read the disclaimer',
  },
  {
    icon: 'letter' as const,
    title: 'The booking terms are visible',
    body: 'Scheduling, cancellation, rescheduling, recording, and refund terms are available before you book. You should not have to pay first to discover the rules.',
    href: '/booking-policy/',
    linkText: 'Read the booking policy',
  },
  {
    icon: 'sun' as const,
    title: 'Your information stays yours',
    body: 'Birth data is treated as information supplied for the reading, not as marketing material. The privacy policy explains how it is handled and what you can ask to have deleted.',
    href: '/privacy/',
    linkText: 'Read the privacy policy',
  },
  {
    icon: 'book' as const,
    title: 'You can see the sources',
    body: 'The sources page shows where the educational material comes from and where different traditions or methods do not agree. You do not have to take the methodology on faith.',
    href: '/explore/sources/',
    linkText: 'See the sources',
  },
];
---

<BaseLayout
  title="Testimonials"
  description="Every testimonial here is genuine and published with permission. When client comments are sparse, you can also verify Mo Lumen's training, methods, policies, and published reasoning directly."
  path="/testimonials/"
  breadcrumbs={crumbs}
  noindex={approved.length === 0}
>
  <Breadcrumbs crumbs={crumbs} />
  <section class="hero hero--split">
    <div class="container">
      <div>
        <p class="eyebrow">Kind words</p>
        <h1>Testimonials</h1>
        <p class="lede">
          I will only publish a client's words with permission and with the attribution that person
          chooses. If that makes this page shorter, I am comfortable with that. Trust should not
          depend on filling a wall with praise.
        </p>
      </div>
      <img class="hero__img" src={celestial.clearedTable.src} srcset={celestial.clearedTable.srcset} sizes="100vw" alt={celestial.clearedTable.alt} width={celestial.clearedTable.width} height={celestial.clearedTable.height} fetchpriority="high" />
    </div>
  </section>

  {approved.length > 0 && (
    <section class="section">
      <div class="container">
        <h2 class="visually-hidden">What clients say</h2>
        <div class="quote-grid quote-grid--wide">
          {approved.map((t) => (
            <figure class="quote-card">
              <blockquote>{t.data.quote}</blockquote>
              <figcaption>
                {t.data.attribution}
                {t.data.service ? <span> · {t.data.service.replace(/-/g, ' ')} reading</span> : null}
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}

  {approved.length === 0 && (
    <section class="section">
      <div class="container prose flow">
        <h2>What to use instead of testimonials</h2>
        <p>
          There are no approved client quotes to show here right now. Rather than substitute vague
          praise or anonymous marketing copy, I would rather point you to things you can inspect for
          yourself: how I trained, how I explain astrology, what I will not do in a reading, and the
          terms you would be agreeing to.
        </p>
      </div>
    </section>
  )}

  <section class="section section--alt">
    <div class="container">
      <h2>What you can verify without taking anyone's word for it</h2>
      <div class="grid grid--3 trust-grid">
        {signals.map((s) => (
          <div class="card">
            <p class="card__icon" aria-hidden="true"><Icon name={s.icon} size={28} /></p>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
            <p style="margin-top: auto;"><a href={s.href}>{s.linkText}</a></p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container prose flow">
      <h2>If we've worked together</h2>
      <p>
        If you would like to share a few words about the experience, email
        <a href="mailto:mo@molumen.com">mo@molumen.com</a>. You choose how you are attributed, and
        you can ask for the testimonial to be removed later.
      </p>
      {isDev && (
        <div class="callout callout--review">
          <p style="margin: 0;">
            DEV NOTE: no approved testimonials in src/content/testimonials/testimonials.json.
            Placeholders never render; this page is noindexed until at least one approved testimonial exists.
          </p>
        </div>
      )}
    </div>
  </section>

  <CTABand
    heading="Still deciding whether the approach fits?"
    body="How Readings Work explains the conversation itself. If the approach makes sense but you are unsure which service fits your question, use the Reading Finder next."
    buttonLabel="See How Readings Work"
    buttonHref="/how-readings-work/"
    secondaryLabel="Find the right reading"
    secondaryHref="/reading-finder/"
  />
</BaseLayout>
