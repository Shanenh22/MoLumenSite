---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CTABand from '../components/CTABand.astro';
import { celestial } from '../config/images';

const approved = (await getCollection('testimonials')).filter((t) => t.data.approved);
const isDev = import.meta.env.DEV;
const crumbs = [{ label: 'Testimonials', href: '/testimonials/' }];
---

<BaseLayout
  title="Testimonials"
  description="Genuine, permissioned client words about astrology readings with Mo Lumen, plus direct links to Mo's approach, training, and reading process."
  path="/testimonials/"
  breadcrumbs={crumbs}
  noindex={approved.length === 0}
>
  <Breadcrumbs crumbs={crumbs} />
  <section class="hero hero--split">
    <div class="container">
      <div>
        <p class="eyebrow">In their words</p>
        <h1>What clients say</h1>
        <p class="lede">
          A reading is personal, so another person's experience cannot tell you exactly what yours
          will be. It can tell you something about what it felt like to sit down with me, look at a
          chart together, and have that conversation.
        </p>
        <p class="card__meta">Every quote here is published with permission and the attribution the client chose.</p>
      </div>
      <img class="hero__img" src={celestial.clearedTable.src} srcset={celestial.clearedTable.srcset} sizes="100vw" alt={celestial.clearedTable.alt} width={celestial.clearedTable.width} height={celestial.clearedTable.height} fetchpriority="high" />
    </div>
  </section>

  {approved.length > 0 ? (
    <section class="section">
      <div class="container">
        <div class="prose flow" style="margin-bottom: var(--space-7);">
          <p class="eyebrow">The experience</p>
          <h2>Different charts, different questions, different conversations</h2>
          <p>
            I do not edit client words into a single story about what a reading is supposed to feel
            like. The useful part is the variation: what stood out to each person, what they found
            clarifying, and how the conversation landed for them.
          </p>
        </div>
        <div class="quote-grid quote-grid--wide">
          {approved.map((t) => (
            <figure class="quote-card">
              <blockquote>{t.data.quote}</blockquote>
              <figcaption>
                {t.data.attribution}
                {t.data.service ? <span> · {t.data.service.replace(/-/g, ' ')} reading</span> : null}
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  ) : (
    <section class="section">
      <div class="container prose flow">
        <h2>No client quotes are published here yet</h2>
        <p>
          I would rather leave this page empty than fill it with placeholders. You can still see
          exactly how I work, what I have studied, and what happens in a reading before deciding
          whether the approach fits you.
        </p>
      </div>
    </section>
  )}

  <section class="section section--alt">
    <div class="container">
      <div class="prose flow" style="margin-bottom: var(--space-6);">
        <p class="eyebrow">Prefer to verify for yourself?</p>
        <h2>Look at the work behind the testimonials</h2>
        <p>You do not have to rely on praise alone. These three pages show the parts you can inspect directly.</p>
      </div>
      <div class="grid grid--3">
        <article class="card">
          <h3><a href="/approach/">How I read a chart</a></h3>
          <p>How technique, synthesis, intuition, conversation, uncertainty, and your lived experience enter the work.</p>
        </article>
        <article class="card">
          <h3><a href="/credentials/">Training & credentials</a></h3>
          <p>The programs, examinations, teaching roles, and professional organizations behind my practice.</p>
        </article>
        <article class="card">
          <h3><a href="/how-readings-work/">What a reading is like</a></h3>
          <p>What happens before, during, and after a session, including what I ask from you and what I bring.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container prose flow">
      <h2>If we've worked together</h2>
      <p>
        If you would like to share a few words about the experience, email
        <a href="mailto:mo@molumen.com">mo@molumen.com</a>. You choose how you are attributed, and
        you can ask for the testimonial to be removed later.
      </p>
      {isDev && (
        <div class="callout callout--review">
          <p style="margin: 0;">DEV NOTE: no approved testimonials in src/content/testimonials/testimonials.json. Placeholders never render; this page is noindexed until at least one approved testimonial exists.</p>
        </div>
      )}
    </div>
  </section>

  <CTABand
    heading="Want to know what the conversation itself is like?"
    body="Client words are one view. How Readings Work shows the process, where your own experience enters, and what you can expect before you decide."
    buttonLabel="See How Readings Work"
    buttonHref="/how-readings-work/"
    secondaryLabel="Find the reading that fits"
    secondaryHref="/reading-finder/"
  />
</BaseLayout>
