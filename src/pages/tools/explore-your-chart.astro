---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { celestial } from '../../config/images';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CTABand from '../../components/CTABand.astro';
import { signs } from '../../data/signs';
import { houses } from '../../data/houses';
import { planets } from '../../data/planets';

const crumbs = [{ label: 'Explore Your Chart', href: '/tools/explore-your-chart/' }];

// Precompute wheel geometry (server-side; static SVG). This is deliberately a
// teaching diagram rather than a calculated chart; the caption below explains
// that real house cusps depend on birth time, location, and house system.
const cx = 300, cy = 300;
const rOuter = 290, rSignInner = 240, rHouseInner = 150;
const rad = (deg: number) => ((deg - 90) * Math.PI) / 180;
const pt = (r: number, deg: number) => [cx + r * Math.cos(rad(deg)), cy + r * Math.sin(rad(deg))];
function ringSeg(rIn: number, rOut: number, a0: number, a1: number) {
  const [x0o, y0o] = pt(rOut, a0), [x1o, y1o] = pt(rOut, a1);
  const [x0i, y0i] = pt(rIn, a0), [x1i, y1i] = pt(rIn, a1);
  return `M ${x0o.toFixed(1)} ${y0o.toFixed(1)} A ${rOut} ${rOut} 0 0 1 ${x1o.toFixed(1)} ${y1o.toFixed(1)} L ${x1i.toFixed(1)} ${y1i.toFixed(1)} A ${rIn} ${rIn} 0 0 0 ${x0i.toFixed(1)} ${y0i.toFixed(1)} Z`;
}
const signSegs = signs.map((s, i) => {
  const a0 = i * 30, a1 = (i + 1) * 30;
  const [lx, ly] = pt((rOuter + rSignInner) / 2, a0 + 15);
  return { ...s, d: ringSeg(rSignInner, rOuter, a0, a1), lx, ly };
});
const houseSegs = houses.map((h, i) => {
  const a0 = i * 30, a1 = (i + 1) * 30;
  const [lx, ly] = pt((rSignInner + rHouseInner) / 2, a0 + 15);
  return { ...h, d: ringSeg(rHouseInner, rSignInner, a0, a1), lx, ly };
});

const explainData = {
  planets: Object.fromEntries(
    planets.map((p) => [
      p.slug,
      {
        name: p.name,
        shortName: p.name.replace('The ', ''),
        glyph: p.glyph,
        text: p.drive,
        mo: p.mo,
        link: `/explore/planets/${p.slug}/`,
      },
    ])
  ),
  signs: Object.fromEntries(
    signSegs.map((s) => [
      s.slug,
      {
        name: s.name,
        shortName: s.name,
        glyph: s.glyph,
        text: s.style,
        mo: s.mo,
        link: `/explore/signs/${s.slug}/`,
      },
    ])
  ),
  houses: Object.fromEntries(
    houseSegs.map((h) => [
      h.slug,
      {
        name: h.name,
        shortName: h.name,
        glyph: String(h.number),
        text: h.arena,
        mo: h.mo,
        link: `/explore/houses/${h.slug}/`,
      },
    ])
  ),
};
---

<BaseLayout
  title="Explore Your Chart: How a Birth Chart Works"
  description="Learn how planets, signs, houses, and aspects work together in a birth chart. An interactive teaching tool from Mo Lumen Astrology."
  path="/tools/explore-your-chart/"
  breadcrumbs={crumbs}
>
  <Breadcrumbs crumbs={crumbs} />

  <section class="hero hero--split chart-hero">
    <div class="container">
      <div>
        <p class="eyebrow">Free interactive tool</p>
        <h1>Explore your chart</h1>
        <p class="lede">
          A birth chart can look complicated. Start with four questions and see how astrologers
          begin turning symbols into a conversation.
        </p>
        <p class="hero__reassure">
          <strong>No birth information needed.</strong> This teaching tool explains chart structure;
          it doesn't interpret your personal chart.
        </p>
      </div>
      <img
        class="hero__img"
        src={celestial.galaxyTidepool.src}
        srcset={celestial.galaxyTidepool.srcset}
        sizes="100vw"
        alt={celestial.galaxyTidepool.alt}
        width={celestial.galaxyTidepool.width}
        height={celestial.galaxyTidepool.height}
        fetchpriority="high"
      />
    </div>
  </section>

  <section class="section chart-intro">
    <div class="container">
      <div class="prose chart-intro__copy">
        <p class="eyebrow">Start with the structure</p>
        <h2>A chart is a system, not a list of traits</h2>
        <p>
          A birth chart maps the positions of the Sun, Moon, and planets against the zodiac and the
          local horizon at a particular moment and place. Astrology begins with the interpretation
          of that map: not one symbol at a time, but through relationships and context.
        </p>
        <p>
          These four questions are useful teaching shortcuts. They are a beginning, not a complete
          interpretation.
        </p>
      </div>

      <div class="chart-formula" aria-label="Four building blocks for reading a chart">
        <article class="chart-formula__item">
          <span class="chart-formula__number" aria-hidden="true">1</span>
          <p class="chart-formula__term">Planet</p>
          <p class="chart-formula__question">What is operating?</p>
          <p>A drive or function.</p>
        </article>
        <article class="chart-formula__item">
          <span class="chart-formula__number" aria-hidden="true">2</span>
          <p class="chart-formula__term">Sign</p>
          <p class="chart-formula__question">How does it express?</p>
          <p>A style or mode.</p>
        </article>
        <article class="chart-formula__item">
          <span class="chart-formula__number" aria-hidden="true">3</span>
          <p class="chart-formula__term">House</p>
          <p class="chart-formula__question">Where does it show up?</p>
          <p>An area of experience.</p>
        </article>
        <article class="chart-formula__item">
          <span class="chart-formula__number" aria-hidden="true">4</span>
          <p class="chart-formula__term">Aspect</p>
          <p class="chart-formula__question">How do planets relate?</p>
          <p>Angular relationships among planets.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div
      class="container chart-explorer"
      data-explorer
      data-content={JSON.stringify(explainData)}
    >
      <div class="explorer-heading prose">
        <p class="eyebrow">Try the language</p>
        <h2>Build a simple chart sentence</h2>
        <p>
          Choose a planet, sign, and house. Each selection teaches one layer. When you have all
          three, the tool shows how an astrologer begins holding them together without pretending
          that three labels are the whole chart.
        </p>
      </div>

      <div class="no-js-fallback">
        <p>
          The interactive lesson needs JavaScript. You can still browse the complete reference
          guides for <a href="/explore/planets/">planets</a>, <a href="/explore/signs/">signs</a>,
          and <a href="/explore/houses/">houses</a>.
        </p>
      </div>

      <div class="explorer-workspace interactive-only">
        <div class="explorer-guide">
          <div class="selection-progress" aria-label="Your teaching example">
            <div>
              <span>Planet · what</span>
              <strong data-selected="planets">Choose one</strong>
            </div>
            <div>
              <span>Sign · how</span>
              <strong data-selected="signs">Choose one</strong>
            </div>
            <div>
              <span>House · where</span>
              <strong data-selected="houses">Choose one</strong>
            </div>
          </div>

          <div class="category-tabs" role="tablist" aria-label="Chart layers">
            <button
              type="button"
              role="tab"
              aria-selected="true"
              aria-controls="planet-choices"
              id="planet-tab"
              data-tab="planets"
            >
              <span>Planet</span>
              <small>What</small>
            </button>
            <button
              type="button"
              role="tab"
              aria-selected="false"
              aria-controls="sign-choices"
              id="sign-tab"
              data-tab="signs"
              tabindex="-1"
            >
              <span>Sign</span>
              <small>How</small>
            </button>
            <button
              type="button"
              role="tab"
              aria-selected="false"
              aria-controls="house-choices"
              id="house-tab"
              data-tab="houses"
              tabindex="-1"
            >
              <span>House</span>
              <small>Where</small>
            </button>
          </div>

          <div
            class="choice-group"
            id="planet-choices"
            role="tabpanel"
            aria-labelledby="planet-tab"
            data-choice-group="planets"
          >
            <div class="choice-group__heading">
              <h3>Choose a planet</h3>
              <p>Astrology conventionally groups the Sun and Moon with the planets.</p>
            </div>
            <div class="choice-grid">
              {
                planets.map((p) => (
                  <button
                    type="button"
                    data-kind="planets"
                    data-key={p.slug}
                    aria-pressed="false"
                  >
                    <span aria-hidden="true">{p.glyph}</span>
                    {p.name.replace('The ', '')}
                  </button>
                ))
              }
            </div>
          </div>

          <div
            class="choice-group"
            id="sign-choices"
            role="tabpanel"
            aria-labelledby="sign-tab"
            data-choice-group="signs"
          >
            <div class="choice-group__heading">
              <h3>Choose a sign</h3>
              <p>The sign describes a style of expression, not a personality verdict.</p>
            </div>
            <div class="choice-grid">
              {
                signs.map((s) => (
                  <button
                    type="button"
                    data-kind="signs"
                    data-key={s.slug}
                    aria-pressed="false"
                  >
                    <span aria-hidden="true">{s.glyph}</span>
                    {s.name}
                  </button>
                ))
              }
            </div>
          </div>

          <div
            class="choice-group"
            id="house-choices"
            role="tabpanel"
            aria-labelledby="house-tab"
            data-choice-group="houses"
          >
            <div class="choice-group__heading">
              <h3>Choose a house</h3>
              <p>Houses describe areas of experience. They are not the same thing as signs.</p>
            </div>
            <div class="choice-grid choice-grid--houses">
              {
                houses.map((h) => (
                  <button
                    type="button"
                    data-kind="houses"
                    data-key={h.slug}
                    aria-pressed="false"
                  >
                    <span aria-hidden="true">{h.number}</span>
                    {h.name.replace(' House', '')}
                  </button>
                ))
              }
            </div>
          </div>

          <div class="explorer-result" aria-live="polite" data-panel>
            <p class="eyebrow" data-result-kind>Start here</p>
            <h3 class="explorer-result__title">
              <span class="explorer-result__glyph" aria-hidden="true" data-result-glyph>○</span>
              <span data-result-name>Pick any planet, sign, or house</span>
            </h3>
            <p data-result-intro>
              You can move in any order. Each choice gives you the core idea and then Mo's lens on
              why the symbol needs context.
            </p>

            <div data-result-detail hidden>
              <p class="result-label">Core idea</p>
              <p data-result-text></p>
              <p class="result-label">Mo's lens</p>
              <p data-result-mo></p>
              <p class="explorer-result__link">
                <a href="/explore/" data-result-link>Read the full reference page →</a>
              </p>
            </div>

            <button class="next-step" type="button" data-next-step hidden>
              Next: choose a sign
            </button>
          </div>

          <div class="synthesis-panel" data-synthesis hidden aria-live="polite">
            <p class="eyebrow">Now comes the important part</p>
            <h3>Put the layers in conversation</h3>
            <div class="synthesis-pieces">
              <article>
                <span>Planet · what</span>
                <strong data-synthesis-name="planets"></strong>
                <p data-synthesis-text="planets"></p>
              </article>
              <article>
                <span>Sign · how</span>
                <strong data-synthesis-name="signs"></strong>
                <p data-synthesis-text="signs"></p>
              </article>
              <article>
                <span>House · where</span>
                <strong data-synthesis-name="houses"></strong>
                <p data-synthesis-text="houses"></p>
              </article>
            </div>
            <p>
              This is where interpretation starts—not where it ends. An astrologer would also look
              at aspects, planetary condition, the rest of the chart, and the person's lived
              experience. The same combination can be lived in more than one way.
            </p>
            <p class="synthesis-panel__next">
              <a href="/explore/aspects/">Next layer: see how aspects connect planets →</a>
            </p>
          </div>
        </div>

        <aside class="wheel-visual" aria-labelledby="wheel-heading">
          <div class="wheel-visual__heading">
            <p class="eyebrow">Visual map</p>
            <h3 id="wheel-heading">See the layers on a chart wheel</h3>
            <p>
              Tap a sign or house here if you prefer the diagram. Your selection stays in sync with
              the lesson.
            </p>
          </div>

          <svg
            class="chart-wheel"
            viewBox="0 0 600 600"
            role="group"
            aria-label="Teaching chart wheel with 12 zodiac signs in the outer ring and 12 houses in the inner ring"
          >
            {
              signSegs.map((s) => (
                <path
                  class="seg"
                  d={s.d}
                  tabindex="0"
                  role="button"
                  aria-pressed="false"
                  aria-label={`${s.name}, sign`}
                  data-kind="signs"
                  data-key={s.slug}
                />
              ))
            }
            {
              houseSegs.map((h) => (
                <path
                  class="seg"
                  d={h.d}
                  tabindex="0"
                  role="button"
                  aria-pressed="false"
                  aria-label={`${h.name}, house`}
                  data-kind="houses"
                  data-key={h.slug}
                  style="fill: var(--color-ivory);"
                />
              ))
            }
            {signSegs.map((s) => (
              <text
                x={s.lx}
                y={s.ly}
                text-anchor="middle"
                dominant-baseline="central"
                font-size="22"
              >
                {s.glyph}
              </text>
            ))}
            {houseSegs.map((h) => (
              <text
                x={h.lx}
                y={h.ly}
                text-anchor="middle"
                dominant-baseline="central"
                font-size="16"
              >
                {h.number}
              </text>
            ))}
            <circle
              cx="300"
              cy="300"
              r="150"
              fill="var(--color-parchment)"
              stroke="var(--color-brown)"
              stroke-width="0.6"
            />
            <text x="300" y="286" text-anchor="middle" font-size="15">SIGN · HOW</text>
            <text x="300" y="309" text-anchor="middle" font-size="15">HOUSE · WHERE</text>
          </svg>

          <div class="wheel-note">
            <strong>Teaching diagram, not a calculated birth chart.</strong>
            <p>
              Real house cusps depend on birth time, location, and the house system being used.
              Houses and signs are different layers, even when a diagram makes them look neatly
              aligned.
            </p>
            <a href="/explore/house-systems/">Why house systems change the wheel →</a>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <section class="section verdict-section">
    <div class="container">
      <div class="verdict-callout">
        <p class="eyebrow">A placement isn't a verdict</p>
        <h2>The goal is a better question, not a faster label</h2>
        <p>
          “Mars in Taurus” is more useful as the beginning of an inquiry than as a one-line
          personality description. How does this Mars act? What makes effort sustainable? What
          complicates action? What else in the chart is participating?
        </p>
        <p>
          That is the difference between collecting meanings and reading a chart: the symbols have
          to be interpreted in relationship with one another and with the person living them.
        </p>
        <p class="verdict-callout__link">
          Want to see what that conversation looks like in practice?
          <a href="/how-readings-work/">See how Mo approaches a reading →</a>
        </p>
      </div>
    </div>
  </section>

  <CTABand
    heading="This is the grammar. Your chart is the poem."
    body="You have the basic nouns and modifiers. Next, see how aspects describe relationships among planets and add another layer of context."
    buttonLabel="Explore Aspects"
    buttonHref="/explore/aspects/"
  />
</BaseLayout>

<script>
  const root = document.querySelector<HTMLElement>('[data-explorer]');

  if (root) {
    const content = JSON.parse(root.dataset.content || '{}');
    root.dataset.enhanced = 'true';

    const targets = Array.from(
      root.querySelectorAll<HTMLElement>('[data-kind][data-key]')
    );
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-tab]'));
    const groups = Array.from(root.querySelectorAll<HTMLElement>('[data-choice-group]'));
    const selectedLabels = new Map(
      Array.from(root.querySelectorAll<HTMLElement>('[data-selected]')).map((el) => [
        el.dataset.selected!,
        el,
      ])
    );

    const resultKind = root.querySelector<HTMLElement>('[data-result-kind]')!;
    const resultGlyph = root.querySelector<HTMLElement>('[data-result-glyph]')!;
    const resultName = root.querySelector<HTMLElement>('[data-result-name]')!;
    const resultIntro = root.querySelector<HTMLElement>('[data-result-intro]')!;
    const resultDetail = root.querySelector<HTMLElement>('[data-result-detail]')!;
    const resultText = root.querySelector<HTMLElement>('[data-result-text]')!;
    const resultMo = root.querySelector<HTMLElement>('[data-result-mo]')!;
    const resultLink = root.querySelector<HTMLAnchorElement>('[data-result-link]')!;
    const nextStep = root.querySelector<HTMLButtonElement>('[data-next-step]')!;
    const synthesis = root.querySelector<HTMLElement>('[data-synthesis]')!;

    const selections: Record<string, any> = {
      planets: null,
      signs: null,
      houses: null,
    };

    let activeKind = 'planets';
    let started = false;

    // mlTrack is the site's only analytics entry point. The selected keys are
    // generic reference symbols, not birth data or a calculated personal chart.
    const track = (event: string, params: Record<string, string> = {}) =>
      (window as any).mlTrack?.(event, params);

    function activateCategory(kind: string, focusTab = false) {
      activeKind = kind;

      tabs.forEach((tab) => {
        const active = tab.dataset.tab === kind;
        tab.setAttribute('aria-selected', String(active));
        tab.tabIndex = active ? 0 : -1;
        if (active && focusTab) tab.focus();
      });

      groups.forEach((group) => {
        group.hidden = group.dataset.choiceGroup !== kind;
      });
    }

    function updatePressedState(kind: string, key: string) {
      targets.forEach((target) => {
        if (target.dataset.kind !== kind) return;
        target.setAttribute('aria-pressed', String(target.dataset.key === key));
      });
    }

    function updateSynthesis() {
      const complete = selections.planets && selections.signs && selections.houses;
      synthesis.hidden = !complete;
      if (!complete) return;

      (['planets', 'signs', 'houses'] as const).forEach((kind) => {
        const item = selections[kind];
        const name = root.querySelector<HTMLElement>(`[data-synthesis-name="${kind}"]`)!;
        const text = root.querySelector<HTMLElement>(`[data-synthesis-text="${kind}"]`)!;
        name.textContent = item.name;
        text.textContent = item.text;
      });
    }

    function configureNextStep(kind: string) {
      nextStep.hidden = false;

      if (kind === 'planets') {
        nextStep.textContent = selections.signs ? 'Review the sign layer' : 'Next: choose a sign';
        nextStep.dataset.nextKind = 'signs';
      } else if (kind === 'signs') {
        nextStep.textContent = selections.houses ? 'Review the house layer' : 'Next: choose a house';
        nextStep.dataset.nextKind = 'houses';
      } else if (selections.planets && selections.signs && selections.houses) {
        nextStep.textContent = 'See how the three layers work together';
        nextStep.dataset.nextKind = 'synthesis';
      } else {
        nextStep.textContent = selections.planets ? 'Choose the missing layer' : 'Next: choose a planet';
        nextStep.dataset.nextKind = selections.planets ? 'signs' : 'planets';
      }
    }

    function select(el: HTMLElement) {
      const kind = el.dataset.kind!;
      const key = el.dataset.key!;
      const item = content[kind]?.[key];
      if (!item) return;

      if (!started) {
        started = true;
        track('chart_explorer_start');
      }

      selections[kind] = item;
      updatePressedState(kind, key);
      activateCategory(kind);

      const selectedLabel = selectedLabels.get(kind);
      if (selectedLabel) selectedLabel.textContent = item.shortName;

      track('chart_explorer_interaction', { kind, key });

      const kindLabel =
        kind === 'planets' ? 'Planet · what' : kind === 'signs' ? 'Sign · how' : 'House · where';

      resultKind.textContent = kindLabel;
      resultGlyph.textContent = item.glyph;
      resultName.textContent = item.name;
      resultIntro.hidden = true;
      resultDetail.hidden = false;
      resultText.textContent = item.text;
      resultMo.textContent = item.mo;
      resultLink.href = item.link;
      resultLink.textContent = `Read the full ${item.shortName} page →`;

      configureNextStep(kind);
      updateSynthesis();
    }

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => activateCategory(tab.dataset.tab!));
      tab.addEventListener('keydown', (event) => {
        if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
        event.preventDefault();

        let nextIndex = index;
        if (event.key === 'ArrowRight') nextIndex = (index + 1) % tabs.length;
        if (event.key === 'ArrowLeft') nextIndex = (index - 1 + tabs.length) % tabs.length;
        if (event.key === 'Home') nextIndex = 0;
        if (event.key === 'End') nextIndex = tabs.length - 1;

        activateCategory(tabs[nextIndex].dataset.tab!, true);
      });
    });

    targets.forEach((el) => {
      el.addEventListener('click', () => select(el));
      el.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          select(el);
        }
      });
    });

    nextStep.addEventListener('click', () => {
      const nextKind = nextStep.dataset.nextKind;
      if (!nextKind) return;

      if (nextKind === 'synthesis') {
        synthesis.scrollIntoView({
          behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
          block: 'start',
        });
        return;
      }

      activateCategory(nextKind, true);
      root.querySelector<HTMLElement>(`[data-choice-group="${nextKind}"]`)?.scrollIntoView({
        behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
        block: 'nearest',
      });
    });

    activateCategory(activeKind);
  }
</script>

<style>
  .chart-intro {
    padding-block: var(--space-12);
  }

  .chart-intro__copy {
    margin-bottom: var(--space-8);
  }

  .chart-formula {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
  }

  .chart-formula__item {
    position: relative;
    min-width: 0;
    padding: var(--space-4);
    border: var(--border-hairline);
    border-radius: var(--radius-md);
    background: var(--surface);
  }

  .chart-formula__item p {
    margin-bottom: var(--space-1);
  }

  .chart-formula__number {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    margin-bottom: var(--space-3);
    border-radius: 999px;
    background: var(--color-teal-tint);
    color: var(--color-teal);
    font-weight: 700;
  }

  .chart-formula__term {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--ink);
  }

  .chart-formula__question {
    font-weight: 700;
    color: var(--color-teal);
  }

  .chart-formula__item p:last-child {
    color: var(--ink-soft);
    margin-bottom: 0;
