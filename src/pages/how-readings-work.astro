---
import BaseLayout from '../layouts/BaseLayout.astro';
import { photos, scenes } from '../config/images';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CTABand from '../components/CTABand.astro';
const crumbs = [{ label: 'How Readings Work', href: '/how-readings-work/' }];
---

<BaseLayout
  title="How Readings Work — what to expect"
  description="What actually happens in an astrology reading with Mo Lumen: booking, intake, preparation, the session itself, and what you take home. No mystery, no pressure."
  path="/how-readings-work/"
  breadcrumbs={crumbs}
>
  <Breadcrumbs crumbs={crumbs} />
  <section class="hero hero--split">
    <div class="container">
      <div>
      <p class="eyebrow">What to expect</p>
      <h1>How readings work</h1>
      <p class="lede">
        If you've never had a professional reading, here's the whole thing demystified — from the
        moment you book to the recording in your inbox.
      </p>
      </div>
      <img
        class="hero__img"
        src={scenes.readingProcess.src}
        alt={scenes.readingProcess.alt}
        width={scenes.readingProcess.width}
        height={scenes.readingProcess.height}
        fetchpriority="high"
      />
    </div>
  </section>

  <section class="section">
    <div class="container prose flow">
      <h2>Before we meet</h2>
      <p>
        When you book, you'll choose a time (shown in your own time zone), pay securely online,
        and answer a short intake form: your birth details, what's bringing you in, and any
        questions you already know you want to ask. Then you'll get preparation notes by email —
        they take five minutes to read, and there is nothing to study. Astrology knowledge is
        genuinely not required; that's my job.
      </p>
      <h2>Why I ask for your birth information</h2>
      <p>
        Your chart is calculated from your birth date, exact time, and place. The time matters
        most: your rising sign — and with it the entire house structure of your chart — changes
        roughly every two hours. A birth certificate is the gold standard. If your time is unknown,
        <a href="/prepare-for-your-reading/">there are honest workarounds</a>, including horary
        readings that need no birth data at all. Your birth details are treated as sensitive
        personal information: they're used to prepare your reading and never sold, shared, or used
        for anything else. See the <a href="/privacy/">privacy policy</a>.
      </p>
      <h2>The session itself</h2>
      <p>
        We meet one-on-one over Zoom or phone (in person in DFW can sometimes be arranged). I'll
        have studied your chart beforehand. We start with what's on your mind, and then we work
        through the chart together — always connecting the symbols back to your actual life. Ask
        anything, interrupt freely, and expect me to be candid: I'll tell you what I see, including
        the parts that ask something of you. What I won't do is predict doom, take away your
        agency, or pretend certainty I don't have. There is fate and there is choice — readings are
        about using both well.
      </p>
      <h2>What you take home</h2>
      <p>
        Every live session includes a recording and a copy of your chart. Most people listen again
        within the week and catch things they missed — insight tends to unfold on the second pass.
      </p>
      <h2>What readings are — and aren't</h2>
      <p>
        A reading offers perspective, pattern recognition, and timing. It is not medical,
        psychological, legal, or financial advice, and if your question belongs with one of those
        professionals, I'll say so plainly. See the <a href="/disclaimer/">disclaimer</a> for the
        full picture.
      </p>
    </div>
  </section>

  <CTABand />
</BaseLayout>
