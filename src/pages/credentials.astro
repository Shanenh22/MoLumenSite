---
import BaseLayout from '../layouts/BaseLayout.astro';
import { photos, scenes } from '../config/images';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CTABand from '../components/CTABand.astro';
const crumbs = [{ label: 'Credentials', href: '/credentials/' }];
---

<BaseLayout
  title="Credentials & Training"
  description="Mo Lumen's astrology credentials: STA Horary Practitioner's Certificate, NCGR-PAA Levels 1–2 examinations, OPA board service, and memberships in NCGR, OPA, and ISAR."
  path="/credentials/"
  breadcrumbs={crumbs}
>
  <Breadcrumbs crumbs={crumbs} />
  <section class="hero hero--split">
    <div class="container">
      <div>
      <p class="eyebrow">Training & service</p>
      <h1>Credentials</h1>
      <p class="lede">
        Astrology is an unregulated field, which makes verifiable training worth naming. Here is
        mine.
      </p>
      </div>
      <img
        class="hero__img"
        src={scenes.chartDetail.src}
        alt={scenes.chartDetail.alt}
        width={scenes.chartDetail.width}
        height={scenes.chartDetail.height}
        fetchpriority="high"
      />
    </div>
  </section>

  <section class="section">
    <div class="container prose flow">
      <figure class="portrait-card portrait-card--inline">
        <img src={photos.moCredentials.src} alt={photos.moCredentials.alt} width={photos.moCredentials.width} height={photos.moCredentials.height} loading="lazy" />
        <figcaption>Mo Lumen</figcaption>
      </figure>
      <h2>Certification & examination</h2>
      <ul>
        <li>
          <strong>Practitioner's Certificate in Horary Astrology</strong> — School of Traditional
          Astrology (STA), the rigorous modern home of classical horary technique.
        </li>
        <li>
          <strong>NCGR-PAA certification exams, Levels 1 and 2 — passed</strong>; Level 3 in
          progress. The National Council for Geocosmic Research's Professional Astrologers'
          Alliance program is among the field's most demanding, testing calculation by hand as
          well as interpretation.
        </li>
      </ul>
      <h2>Professional service</h2>
      <ul>
        <li><strong>Board member & treasurer</strong> — Organization for Professional Astrologers (OPA)</li>
        <li><strong>Treasurer</strong> — NCGR-DFW chapter</li>
      </ul>
      <h2>Memberships</h2>
      <ul>
        <li>National Council for Geocosmic Research (NCGR)</li>
        <li>Organization for Professional Astrologers (OPA)</li>
        <li>International Society for Astrological Research (ISAR)</li>
      </ul>
      <h2>Before astrology</h2>
      <p>
        Years in business, and years teaching natural sciences from middle school through college.
        The first taught me practicality; the second taught me how people actually learn. Both are
        in every reading.
      </p>
      <div class="callout">
        <p style="margin: 0;">
          <strong>Why this matters:</strong> anyone can call themselves an astrologer. Choosing one
          with documented training, examination, and peer-organization service is the closest thing
          the field has to due diligence. Wherever you book — here or elsewhere — ask about
          training. A good astrologer will be glad you did.
        </p>
      </div>
    </div>
  </section>

  <CTABand />
</BaseLayout>
