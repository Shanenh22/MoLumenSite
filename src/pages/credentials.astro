---
import BaseLayout from '../layouts/BaseLayout.astro';
import FurtherReading from '../components/FurtherReading.astro';
import SeaBreak from '../components/SeaBreak.astro';
import { ocean, photos, scenes } from '../config/images';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CTABand from '../components/CTABand.astro';
const crumbs = [{ label: 'Credentials', href: '/credentials/' }];
---

<BaseLayout
  title="Credentials & Training"
  description="Mo Lumen's astrology training and professional service: STA Horary Practitioner's Certificate, NCGR-PAA Levels 1–2 examinations, Dwarf Planet University diploma and teaching, OPA board service, and 2026 United Astrology Conference staff service."
  path="/credentials/"
  breadcrumbs={crumbs}
>
  <Breadcrumbs crumbs={crumbs} />
  <section class="hero hero--split">
    <div class="container">
      <div>
      <p class="eyebrow">Training & service</p>
      <h1>Credentials</h1>
      <p class="lede">
        Astrology is an unregulated field, which makes serious study, examination, and professional
        service worth naming. Here is mine.
      </p>
      </div>
      <img
        class="hero__img"
        src={scenes.chartDetail.src}
        srcset={scenes.chartDetail.srcset}
        sizes="100vw"
        alt={scenes.chartDetail.alt}
        width={scenes.chartDetail.width}
        height={scenes.chartDetail.height}
        fetchpriority="high"
      />
    </div>
  </section>

  <section class="section">
    <div class="container prose flow">
      <figure class="portrait-card portrait-card--inline">
        <img src={photos.moCredentials.src} alt={photos.moCredentials.alt} width={photos.moCredentials.width} height={photos.moCredentials.height} loading="lazy" />
        <figcaption>Mo Lumen</figcaption>
      </figure>
      <h2>Training, certification & examination</h2>
      <ul>
        <li>
          <strong>Practitioner's Certificate in Horary Astrology</strong>: School of Traditional
          Astrology (STA).
        </li>
        <li>
          <strong>NCGR-PAA certification exams, Levels 1 and 2, passed</strong>; Level 3 in
          progress.
        </li>
        <li>
          <strong>Diploma, Dwarf Planet University (DPU)</strong>; current assistant teacher and
          tutor at DPU.
        </li>
      </ul>
      <h2>Professional service</h2>
      <ul>
        <li>
          <strong>Board member &amp; treasurer</strong>:
          <a href="https://opaastrology.org/about-opa/meet-the-board/" rel="noopener" target="_blank"
            >Organization for Professional Astrologers (OPA)</a
          >.
        </li>
        <li><strong>Treasurer</strong>: NCGR-DFW chapter, 2024–2026</li>
        <li><strong>Bookkeeper</strong>: 2026 United Astrology Conference staff</li>
      </ul>
    </div>
  </section>

  <SeaBreak image={ocean.glassWave} />

  <section class="section section--sea">
    <div class="container prose flow">
      <h2>Memberships</h2>
      <ul>
        <li>
          <a href="https://ncgrastrology.org/" rel="noopener" target="_blank"
            >National Council for Geocosmic Research (NCGR)</a
          >
        </li>
        <li>
          <a href="https://opaastrology.org/" rel="noopener" target="_blank"
            >Organization for Professional Astrologers (OPA)</a
          >
        </li>
        <li>
          <a href="https://www.isarastrology.com/" rel="noopener" target="_blank"
            >International Society for Astrological Research (ISAR)</a
          >
        </li>
      </ul>
      <h2>A wider background</h2>
      <p>
        Astrology has interested me since childhood, although I came to it professionally later.
        Along the way I taught natural sciences from middle school through college and worked in
        business and financial roles. The science classroom especially shaped how I observe,
        question, explain complex ideas, and respect the relationships between parts of a larger
        system.
      </p>
      <div class="callout">
        <p style="margin: 0;">
          <strong>Why this matters:</strong> anyone can call themselves an astrologer. Training,
          examination, continued study, and service within professional organizations give you
          useful context when choosing someone to read your chart. Wherever you book, ask about
          the astrologer's training and approach.
        </p>
      </div>
      <FurtherReading />
    </div>
  </section>

  <CTABand />
</BaseLayout>
