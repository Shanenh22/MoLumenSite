---
import { getCollection } from 'astro:content';
import { photos } from '../../config/images';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CTABand from '../../components/CTABand.astro';

const now = new Date();
const events = (await getCollection('skyEvents'))
  .filter((e) => !e.data.draft && e.data.start < now)
  .sort((a, b) => b.data.start.valueOf() - a.data.start.valueOf());
const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const crumbs = [
  { label: 'Current Sky', href: '/current-sky/' },
  { label: 'Archive', href: '/current-sky/archive/' },
];
---

<BaseLayout
  title="Current Sky Archive"
  description="Past sky events and lunation letters from Mo Lumen Astrology, collected chronologically so you can revisit the astrology in context."
  path="/current-sky/archive/"
  breadcrumbs={crumbs}
>
  <Breadcrumbs crumbs={crumbs} />
  <section class="hero hero--split">
    <div class="container">
      <div>
        <p class="eyebrow">Past sky, kept in context</p>
        <h1>Current Sky archive</h1>
        <p class="lede">
          Astrology is easier to understand when you can look back as well as ahead. This archive keeps
          Mo's past sky notes and lunation letters in chronological context: what was happening, what
          patterns stood out, and what questions they raised at the time.
        </p>
        <p>
          For what is active now or coming next, use the <a href="/current-sky/">Current Sky timeline</a>
          or the <a href="/current-sky/calendar/">calendar</a>.
        </p>
      </div>
      <img
        class="hero__img hero__img--portrait"
        src={photos.skyReal1.src}
        alt={photos.skyReal1.alt}
        width={photos.skyReal1.width}
        height={photos.skyReal1.height}
        fetchpriority="high"
      />
    </div>
  </section>
  <section class="section">
    <div class="container">
      <p style="max-width: 46rem; margin-bottom: var(--space-8);">
        These pieces are records of the sky as Mo interpreted it then. They are useful for learning
        how cycles unfold and for comparing an earlier moment with what you now know happened. They
        are not personal readings; your own chart and lived circumstances add the layer an archive
        cannot provide.
      </p>
      <ol class="timeline">
        {
          events.map((e) => (
            <li>
              <span class="event-type">{e.data.eventType}</span>
              <h2 style="font-size: var(--text-lg); margin: var(--space-1) 0;">
                <a href={`/current-sky/events/${e.id.replace(/\.mdx?$/, '')}/`}>{e.data.title}</a>
              </h2>
              <p class="card__meta" style="margin: 0;">{fmt(e.data.start)}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
  <CTABand
    heading="Want to see what is unfolding now?"
    body="Move from the archive back into the current sequence, or use the calendar when you want the dates at a glance."
    buttonLabel="Read Current Sky"
    buttonHref="/current-sky/"
    secondaryLabel="Open the Sky Calendar"
    secondaryHref="/current-sky/calendar/"
  />
</BaseLayout>
