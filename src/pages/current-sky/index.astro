---
import { getCollection } from 'astro:content';
import { photos } from '../../config/images';
import { site } from '../../config/site';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CTABand from '../../components/CTABand.astro';
import NewsletterForm from '../../components/NewsletterForm.astro';
import SkyViewTabs from '../../components/SkyViewTabs.astro';
import { SKY_TYPE_LABELS, utcKey } from '../../lib/sky-calendar';
import { isSkyEventPublished } from '../../lib/sky-publishing';

const dateKeyInTimeZone = (date: Date, timeZone: string) => {
  const parts = Object.fromEntries(
    new Intl.DateTimeFormat('en-US', {
      timeZone,
      year: 'numeric',
      month: '2-digit',
      day: '2-digit',
    })
      .formatToParts(date)
      .filter((part) => ['year', 'month', 'day'].includes(part.type))
      .map((part) => [part.type, part.value])
  );
  return `${parts.year}-${parts.month}-${parts.day}`;
};

const now = new Date();
const todayKey = dateKeyInTimeZone(now, site.timezone);
const events = (await getCollection('skyEvents'))
  .filter(
    (e) =>
      isSkyEventPublished(e.data, now) &&
      utcKey(e.data.displayThrough ?? e.data.end ?? e.data.start) >= todayKey
  )
  .sort((a, b) => a.data.start.valueOf() - b.data.start.valueOf());
// Keep extra cards in the HTML so the browser can roll the list forward at
// midnight Central without requiring a fresh site deployment. Only three show.
const nextEvents = events.slice(0, 12);
const types = [...new Set(events.map((e) => e.data.eventType))];
const typeLabels = SKY_TYPE_LABELS;
const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const monthKey = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' });
const byMonth = new Map<string, typeof events>();
for (const e of events) {
  const k = monthKey(e.data.start);
  if (!byMonth.has(k)) byMonth.set(k, []);
  byMonth.get(k)!.push(e);
}
const crumbs = [{ label: 'Current Sky', href: '/current-sky/' }];
---

<BaseLayout
  title="Current Sky: what's overhead now"
  description="See the next astrological events first, then explore the wider timeline with verified dates and Mo Lumen's plain-language interpretation and context."
  path="/current-sky/"
  breadcrumbs={crumbs}
>
  <Breadcrumbs crumbs={crumbs} />

  <section class="hero hero--split current-sky-hero" data-current-sky data-timezone={site.timezone}>
    <div class="container">
      <div>
        <p class="eyebrow">The sky right now</p>
        <h1>Current sky</h1>
        <p class="lede">
          See what is changing next, when it changes, and what I find worth noticing about it. The
          dates and positions are astronomy; the interpretation is astrology. I keep those two
          things distinct on purpose.
        </p>
      </div>
      <img
        class="hero__img hero__img--portrait"
        src={photos.skyReal2.src}
        alt={photos.skyReal2.alt}
        width={photos.skyReal2.width}
        height={photos.skyReal2.height}
        fetchpriority="high"
      />
    </div>
  </section>

  <section class="section current-sky-now">
    <div class="container">
      <div class="current-sky-now__heading">
        <div>
          <p class="eyebrow">Next up</p>
          <h2>What is happening next?</h2>
        </div>
        <SkyViewTabs current="list" />
      </div>

      {nextEvents.length > 0 ? (
        <div class="grid grid--3" style="margin-top: var(--space-6);" data-next-events>
          {nextEvents.map((e, index) => (
            <article
              class:list={['card', { 'current-sky-feature': index === 0 }]}
              data-next-event
              data-event-through={utcKey(e.data.displayThrough ?? e.data.end ?? e.data.start)}
              hidden={index >= 3}
            >
              <p class="card__meta" style="margin: 0;">{typeLabels[e.data.eventType] ?? e.data.eventType} · {fmt(e.data.start)}</p>
              <h3><a href={`/current-sky/events/${e.id.replace(/\.mdx?$/, '')}/`}>{e.data.title}</a></h3>
              <p>{e.data.summary}</p>
              <p style="margin-top: auto;"><a href={`/current-sky/events/${e.id.replace(/\.mdx?$/, '')}/`}>Why I'm watching this →</a></p>
            </article>
          ))}
        </div>
      ) : (
        <p>There are no published upcoming events in this view right now.</p>
      )}

      <div class="current-sky-actions">
        <a class="btn btn--primary" href="/current-sky/calendar/">Open the Sky Calendar</a>
        <a class="btn btn--ghost" href="/current-sky/the-sky-in-2026/">See the larger 2026 picture</a>
      </div>
    </div>
  </section>

  <section class="section section--night">
    <div class="container prose flow">
      <p class="eyebrow">How I use this page</p>
      <h2>Look at the pattern before the prediction</h2>
      <p>
        I love watching planetary cycles because the movement itself is extraordinary: bodies
        traveling on different rhythms, repeatedly forming new relationships with one another.
        Astrology gives us a symbolic language for asking what those changing relationships may
        mean. That does not require turning every transit into an event that must happen to you.
      </p>
      <p>
        These notes stay at the level of the shared sky. Your own chart adds another layer: which
        degrees are being contacted, which houses are involved, what other patterns are active,
        and, most importantly, how any of it is actually showing up in your circumstances.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">Upcoming timeline</p>
      <h2>Browse what's ahead</h2>
      <p class="lede">Filter by the kind of event you want to follow, or move through the full timeline month by month.</p>

      <div class="filter-bar" role="group" aria-label="Filter events by type" data-sky-filters>
        <button type="button" aria-pressed="true" data-filter="all">All events</button>
        {types.map((t) => (
          <button type="button" aria-pressed="false" data-filter={t}>{typeLabels[t] ?? t}</button>
        ))}
      </div>
      <p class="visually-hidden" aria-live="polite" data-sky-status></p>

      {[...byMonth.entries()].map(([month, monthEvents]) => (
        <section data-month>
          <h2>{month}</h2>
          <ol class="timeline" style="margin-bottom: var(--space-8);">
            {monthEvents.map((e) => (
              <li
                data-event-type={e.data.eventType}
                data-event-through={utcKey(e.data.displayThrough ?? e.data.end ?? e.data.start)}
              >
                <span class="event-type">{typeLabels[e.data.eventType] ?? e.data.eventType}</span>
                <h3 style="margin: var(--space-1) 0;">
                  <a href={`/current-sky/events/${e.id.replace(/\.mdx?$/, '')}/`}>{e.data.title}</a>
                </h3>
                <p class="card__meta" style="margin: 0 0 var(--space-2);">
                  {fmt(e.data.start)}{e.data.end ? ` – ${fmt(e.data.end)}` : ''}{e.data.sign ? ` · ${e.data.sign}` : ''}
                </p>
                <p style="margin: 0;">{e.data.summary}</p>
              </li>
            ))}
          </ol>
        </section>
      ))}

      {events.length === 0 && (
        <div class="prose flow">
          <p>You can browse the <a href="/current-sky/archive/">archive</a> or use the <a href="/current-sky/calendar/">Sky Calendar</a> to move through the published timeline.</p>
        </div>
      )}
    </div>
  </section>

  <section class="section section--alt">
    <div class="container grid grid--2">
      <div class="flow">
        <p class="eyebrow">Go deeper</p>
        <h2>Follow the pattern, not just the date</h2>
        <p>
          Past sky writing lives in the <a href="/current-sky/archive/">Current Sky archive</a>. If
          the terminology is new, start with <a href="/explore/transits/">how transits work</a>,
          <a href="/explore/retrogrades/">retrogrades</a>, or <a href="/explore/eclipses/">eclipses</a>.
        </p>
        <p><a href="/current-sky/the-sky-in-2026/"><strong>The Sky in 2026</strong></a> steps back from individual dates to look at some of the larger movements shaping the year.</p>
      </div>
      <div class="flow">
        <p class="eyebrow">A monthly note from me</p>
        <h2 id="sky-newsletter">Stay with the conversation</h2>
        <p>
          <strong>The Sky This Month</strong> is one recurring part of my newsletter. I also share
          what has caught my attention: a question, a pattern, a connection, or something in the
          living world that made me look twice.
        </p>
        <NewsletterForm source="current-sky" labelledby="sky-newsletter" />
      </div>
    </div>
  </section>

  <CTABand
    heading="Wondering what this sky means in your chart?"
    body="The shared sky gives us the larger pattern. A personal reading adds your chart, your circumstances, and the conversation needed to understand which possibilities actually matter now."
    buttonLabel="Find Your Reading"
    buttonHref="/reading-finder/"
    secondaryLabel="Learn How Transits Work"
    secondaryHref="/explore/transits/"
  />
</BaseLayout>

<script>
  const currentSky = document.querySelector<HTMLElement>('[data-current-sky]');
  const timeZone = currentSky?.dataset.timezone || 'America/Chicago';

  function todayKeyInTimeZone() {
    const parts = Object.fromEntries(
      new Intl.DateTimeFormat('en-US', {
        timeZone,
        year: 'numeric',
        month: '2-digit',
        day: '2-digit',
      })
        .formatToParts(new Date())
        .filter((part) => ['year', 'month', 'day'].includes(part.type))
        .map((part) => [part.type, part.value])
    );
    return `${parts.year}-${parts.month}-${parts.day}`;
  }

  const isCurrent = (el: HTMLElement, today: string) =>
    !el.dataset.eventThrough || el.dataset.eventThrough >= today;

  function refreshNextEvents(today: string) {
    const cards = document.querySelectorAll<HTMLElement>('[data-next-event]');
    let shown = 0;
    cards.forEach((card) => {
      const show = isCurrent(card, today) && shown < 3;
      card.hidden = !show;
      card.classList.toggle('current-sky-feature', show && shown === 0);
      if (show) shown += 1;
    });
  }

  const bar = document.querySelector<HTMLElement>('[data-sky-filters]');
  const buttons = bar?.querySelectorAll<HTMLButtonElement>('button') ?? [];
  const items = document.querySelectorAll<HTMLElement>('[data-event-type]');
  const months = document.querySelectorAll<HTMLElement>('[data-month]');
  const status = document.querySelector<HTMLElement>('[data-sky-status]');

  function applyFilter(filter: string, today: string, announce = false) {
    let shown = 0;
    items.forEach((li) => {
      const show = isCurrent(li, today) && (filter === 'all' || li.dataset.eventType === filter);
      li.hidden = !show;
      if (show) shown++;
    });
    months.forEach((m) => {
      m.hidden = [...m.querySelectorAll<HTMLElement>('[data-event-type]')].every((li) => li.hidden);
    });
    if (announce && status) status.textContent = `${shown} event${shown === 1 ? '' : 's'} shown`;
  }

  function refreshCurrentSky() {
    const today = todayKeyInTimeZone();
    refreshNextEvents(today);
    const active = bar?.querySelector<HTMLButtonElement>('button[aria-pressed="true"]');
    applyFilter(active?.dataset.filter ?? 'all', today);
  }

  refreshCurrentSky();
  // A static build should not decide tomorrow's "current" event. Re-check the
  // calendar date while the page remains open so the rollover follows Central
  // time even when there has not been another deployment.
  window.setInterval(refreshCurrentSky, 60_000);

  if (bar) {
    buttons.forEach((btn) =>
      btn.addEventListener('click', () => {
        const filter = btn.dataset.filter!;
        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        applyFilter(filter, todayKeyInTimeZone(), true);
        (window as any).mlTrack?.('current_sky_filter', { filter });
      })
    );
  }
</script>

<style>
  .current-sky-now__heading {
    display: flex;
    gap: var(--space-6);
    align-items: end;
    justify-content: space-between;
  }
  .current-sky-feature {
    border-color: rgb(15 110 107 / 0.35);
    background: var(--color-teal-tint);
  }
  .current-sky-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }
  @media (max-width: 767px) {
    .current-sky-now__heading {
      display: block;
    }
    .current-sky-actions .btn {
      width: 100%;
    }
  }
</style>
