---
import { getCollection } from 'astro:content';
import { photos } from '../../config/images';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CTABand from '../../components/CTABand.astro';
import NewsletterForm from '../../components/NewsletterForm.astro';
import SkyViewTabs from '../../components/SkyViewTabs.astro';
import { SKY_TYPE_LABELS } from '../../lib/sky-calendar';

const now = new Date();
const events = (await getCollection('skyEvents'))
  .filter((e) => !e.data.draft && ((e.data.end ?? e.data.start) >= now || e.data.start >= now))
  .sort((a, b) => a.data.start.valueOf() - b.data.start.valueOf());
const types = [...new Set(events.map((e) => e.data.eventType))];
const typeLabels = SKY_TYPE_LABELS;
const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const monthKey = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' });
const byMonth = new Map<string, typeof events>();
for (const e of events) {
  const k = monthKey(e.data.start);
  if (!byMonth.has(k)) byMonth.set(k, []);
  byMonth.get(k)!.push(e);
}
const crumbs = [{ label: 'Current Sky', href: '/current-sky/' }];
---

<BaseLayout
  title="Current Sky: what's overhead now"
  description="A verified timeline of current astrological events: lunations, eclipses, retrogrades, ingresses, and major planetary shifts, with Mo Lumen's plain-language interpretation and context."
  path="/current-sky/"
  breadcrumbs={crumbs}
>
  <Breadcrumbs crumbs={crumbs} />
  <section class="hero hero--split">
    <div class="container">
      <div>
      <p class="eyebrow">The sky right now</p>
      <h1>Current sky</h1>
      <p class="lede">
        The sky never really holds still. Here you can see what's changing, when it changes, and
        what I find worth noticing about it. The dates and positions are astronomy; the
        interpretation is astrology. I keep those two things distinct on purpose.
      </p>
      </div>
      <img
        class="hero__img hero__img--portrait"
        src={photos.skyReal2.src}
        alt={photos.skyReal2.alt}
        width={photos.skyReal2.width}
        height={photos.skyReal2.height}
        fetchpriority="high"
      />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="prose flow" style="margin-bottom: var(--space-7);">
        <h2>Look at the pattern before the prediction</h2>
        <p>
          I love watching planetary cycles because the movement itself is extraordinary: bodies
          traveling on different rhythms, repeatedly forming new relationships with one another.
          Astrology gives us a symbolic language for asking what those changing relationships may
          mean. I don't think that requires turning every transit into an event that must happen to
          you.
        </p>
        <p>
          These notes stay at the level of the shared sky. Your own chart adds another layer: which
          degrees are being contacted, which houses are involved, what other patterns are active,
          and, most importantly, how any of it is actually showing up in your life.
        </p>
      </div>

      <SkyViewTabs current="list" />
      <div class="filter-bar" role="group" aria-label="Filter events by type" data-sky-filters>
        <button type="button" aria-pressed="true" data-filter="all">All events</button>
        {
          types.map((t) => (
            <button type="button" aria-pressed="false" data-filter={t}>
              {typeLabels[t] ?? t}
            </button>
          ))
        }
      </div>
      <p class="visually-hidden" aria-live="polite" data-sky-status></p>

      {
        [...byMonth.entries()].map(([month, monthEvents]) => (
          <section data-month>
            <h2>{month}</h2>
            <ol class="timeline" style="margin-bottom: var(--space-8);">
              {monthEvents.map((e) => (
                <li data-event-type={e.data.eventType}>
                  <span class="event-type">{typeLabels[e.data.eventType] ?? e.data.eventType}</span>
                  <h3 style="margin: var(--space-1) 0;">
                    <a href={`/current-sky/events/${e.id.replace(/\.mdx?$/, '')}/`}>{e.data.title}</a>
                  </h3>
                  <p class="card__meta" style="margin: 0 0 var(--space-2);">
                    {fmt(e.data.start)}
                    {e.data.end ? ` – ${fmt(e.data.end)}` : ''}
                    {e.data.sign ? ` · ${e.data.sign}` : ''}
                  </p>
                  <p style="margin: 0;">{e.data.summary}</p>
                </li>
              ))}
            </ol>
          </section>
        ))
      }
      {events.length === 0 && <p>New sky events are being added, check back shortly.</p>}
    </div>
  </section>

  <section class="section section--alt">
    <div class="container grid grid--2">
      <div class="flow">
        <h2>Keep exploring</h2>
        <p>
          Past lunation letters and earlier sky writing live in the
          <a href="/current-sky/archive/">Current Sky archive</a>.
        </p>
        <p>
          If the terminology is new, start with <a href="/explore/transits/">how transits work</a>,
          <a href="/explore/retrogrades/">retrogrades</a>, or
          <a href="/explore/eclipses/">eclipses</a>, or use the
          <a href="/explore/glossary/">glossary</a> whenever a term gets in the way of the idea.
        </p>
        <p>
          <a href="/current-sky/the-sky-in-2026/"><strong>The Sky in 2026</strong></a> steps back
          from individual dates to look at some of the larger movements shaping the year.
        </p>
      </div>
      <div class="flow">
        <h2 id="sky-newsletter">A monthly note from me</h2>
        <p>
          <strong>The Sky This Month</strong> is one recurring part of the newsletter. I also share
          what has caught my attention, a question I've been sitting with, or a connection I think
          is worth looking at a little more closely. Astrology is the anchor; curiosity gets some
          room too.
        </p>
        <NewsletterForm source="current-sky" labelledby="sky-newsletter" />
      </div>
    </div>
  </section>

  <CTABand
    heading="Wondering what this sky means in your chart?"
    body="The shared sky gives us the larger pattern. A personal reading adds your chart, your circumstances, and the conversation needed to understand which possibilities actually matter now."
    buttonLabel="Find Your Reading"
    buttonHref="/reading-finder/"
  />
</BaseLayout>

<script>
  const bar = document.querySelector<HTMLElement>('[data-sky-filters]');
  if (bar) {
    const buttons = bar.querySelectorAll<HTMLButtonElement>('button');
    const items = document.querySelectorAll<HTMLElement>('[data-event-type]');
    const months = document.querySelectorAll<HTMLElement>('[data-month]');
    const status = document.querySelector<HTMLElement>('[data-sky-status]');
    buttons.forEach((btn) =>
      btn.addEventListener('click', () => {
        const filter = btn.dataset.filter!;
        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        let shown = 0;
        items.forEach((li) => {
          const show = filter === 'all' || li.dataset.eventType === filter;
          li.hidden = !show;
          if (show) shown++;
        });
        months.forEach((m) => {
          m.hidden = [...m.querySelectorAll<HTMLElement>('[data-event-type]')].every((li) => li.hidden);
        });
        if (status) status.textContent = `${shown} event${shown === 1 ? '' : 's'} shown`;
        (window as any).mlTrack?.('current_sky_filter', { filter });
      })
    );
  }
</script>
