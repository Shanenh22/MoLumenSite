---
/**
 * The Current Sky calendar view.
 *
 * /current-sky/ is editorial: events with Mo's notes, meant to be read.
 * /current-sky/calendar/ is navigational: dates and sequence, meant to be scanned.
 * Keeping both makes the calendar useful without duplicating the editorial prose.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CTABand from '../../components/CTABand.astro';
import SkyCalendar from '../../components/SkyCalendar.astro';
import SkyViewTabs from '../../components/SkyViewTabs.astro';
import { photos } from '../../config/images';
import type { CalendarEvent } from '../../lib/sky-calendar';

const events: CalendarEvent[] = (await getCollection('skyEvents'))
  .filter((e) => !e.data.draft)
  .map((e) => ({
    slug: e.id.replace(/\.mdx?$/, ''),
    title: e.data.title,
    eventType: e.data.eventType,
    start: e.data.start,
    end: e.data.end,
    sign: e.data.sign,
  }));

const crumbs = [
  { label: 'Current Sky', href: '/current-sky/' },
  { label: 'Calendar', href: '/current-sky/calendar/' },
];
---

<BaseLayout
  title="Current Sky calendar: eclipses, retrogrades, moons"
  description="A month-by-month calendar of verified sky events: new and full moons, eclipses, retrogrades and ingresses, each linking to Mo Lumen's plain-language notes."
  path="/current-sky/calendar/"
  breadcrumbs={crumbs}
>
  <Breadcrumbs crumbs={crumbs} />

  <section class="hero hero--split">
    <div class="container">
      <div>
        <p class="eyebrow">Month by month</p>
        <h1>Current sky calendar</h1>
        <p class="lede">
          The same verified events as Current Sky, laid out by month so you can see the sequence at
          a glance: when a retrograde begins and ends, where the lunations fall, and what comes next.
          Each date links to Mo's note on the pattern and the questions she finds worth considering.
        </p>
      </div>
      <img
        class="hero__img hero__img--portrait"
        src={photos.skyReal1.src}
        alt={photos.skyReal1.alt}
        width={photos.skyReal1.width}
        height={photos.skyReal1.height}
        fetchpriority="high"
      />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SkyViewTabs current="calendar" />
      <SkyCalendar events={events} />
    </div>
  </section>

  <section class="section section--alt">
    <div class="container grid grid--2">
      <div class="flow">
        <h2>Prefer the story behind the dates?</h2>
        <p>
          <a href="/current-sky/">Current Sky</a> puts Mo's notes alongside upcoming events so you
          can follow the pattern rather than only the date. Past notes live in the
          <a href="/current-sky/archive/">archive</a>.
        </p>
        <p>
          New to these terms? Start with <a href="/explore/transits/">how transits work</a>,
          <a href="/explore/retrogrades/">retrogrades</a>, or
          <a href="/explore/eclipses/">eclipses</a>.
        </p>
      </div>
      <div class="flow">
        <h2>About the calendar</h2>
        <p>
          The dates and positions are the observable framework. Each event note adds Mo's
          astrological interpretation, and an individual chart adds context this calendar cannot
          know.
        </p>
        <p>
          <a href="/horoscopes/">Rising-sign guidance</a> gives a broad whole-sign-house lens for
          lunations and eclipses without pretending to be a personal reading.
        </p>
      </div>
    </div>
  </section>

  <CTABand
    heading="Want the story behind the dates?"
    body="The calendar shows when. Current Sky is where Mo slows down and asks what the pattern may be describing, while keeping shared symbolism separate from personal interpretation."
    buttonLabel="Read Current Sky"
    buttonHref="/current-sky/"
    secondaryLabel="Get Mo's monthly note"
    secondaryHref="/newsletter/"
  />
</BaseLayout>
