---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import CTABand from '../../../components/CTABand.astro';
import RisingSignGuidance from '../../../components/RisingSignGuidance.astro';
import { bandFor, celestial, ocean, type SiteImage } from '../../../config/images';
import { site } from '../../../config/site';

export async function getStaticPaths() {
  const events = await getCollection('skyEvents');
  return events.map((e) => ({
    params: { slug: e.id.replace(/\.mdx?$/, '') },
    props: { event: e },
  }));
}
const { event } = Astro.props;
const { Content } = await render(event);
const e = event.data;
const slug = event.id.replace(/\.mdx?$/, '');
const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const crumbs = [
  { label: 'Current Sky', href: '/current-sky/' },
  { label: e.title, href: `/current-sky/events/${slug}/` },
];
/* Fifteen sky-event pages carried no image at all, so the hero earns its place.
   A second decorative band below the article did not: these are short dated
   notes — three paragraphs and a source line — and the only seam available was
   between the note and its own citation. Tried and removed.

   The hero is keyed to what the event actually is rather than hashed off the
   slug, because a page about an eclipse opening on an arbitrary wave is the
   same "picture for no reason" problem in a quieter form. Unknown types still
   fall back to the hash, so adding an eventType to the schema cannot leave a
   page without a hero.

   A single image per type would mean all ten lunation pages opened on the same
   picture, which is the sibling-duplication problem the imagery work existed to
   fix. So each type gets a small pool and the slug picks within it: the hero is
   always about the right kind of event, and no two lunations look alike. */
const HERO_BY_TYPE: Record<string, SiteImage[]> = {
  eclipse: [celestial.distanceUnderEclipse, ocean.lightBreakingStorm],
  lunation: [
    celestial.moonPhasesInWater,
    ocean.seaStackMoonrise,
    ocean.ripplesSunset,
  ],
  retrograde: [celestial.emptyChair, celestial.platform, ocean.currents],
};
function heroFor(): SiteImage {
  const pool = HERO_BY_TYPE[e.eventType];
  if (!pool) return bandFor(slug);
  let h = 0;
  for (let i = 0; i < slug.length; i++) h = (h * 31 + slug.charCodeAt(i)) >>> 0;
  return pool[h % pool.length];
}
const heroImage = heroFor();
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: e.title,
    description: e.summary,
    datePublished: e.start.toISOString(),
    dateModified: (e.lastVerified ?? e.start).toISOString(),
    author: { '@type': 'Person', name: 'Maureen "Mo" Lumen', url: `${site.url}/about/` },
    publisher: { '@type': 'Organization', name: site.name, url: site.url },
    mainEntityOfPage: `${site.url}/current-sky/events/${slug}/`,
  },
  /**
   * These are dated astronomical events, so they are eligible for Event rich
   * results — the surface that answers "when is the next full moon". Marked
   * as online and free because that is what they are: the sky, visible to
   * everyone, at no cost. Nothing here is a Mo Lumen product.
   */
  {
    '@context': 'https://schema.org',
    '@type': 'Event',
    name: e.title,
    description: e.summary,
    startDate: e.start.toISOString(),
    endDate: e.start.toISOString(),
    eventStatus: 'https://schema.org/EventScheduled',
    eventAttendanceMode: 'https://schema.org/OnlineEventAttendanceMode',
    location: {
      '@type': 'VirtualLocation',
      url: `${site.url}/current-sky/events/${slug}/`,
    },
    image: new URL('/og-default.png', site.url).href,
    isAccessibleForFree: true,
    organizer: { '@type': 'Organization', name: site.name, url: site.url },
    about: {
      '@type': 'Thing',
      name: e.sign ? `${e.eventType} in ${e.sign}` : e.eventType,
    },
  },
];
---

<BaseLayout
  title={e.title}
  description={e.summary}
  path={`/current-sky/events/${slug}/`}
  breadcrumbs={crumbs}
  ogType="article"
  publishedDate={e.start}
  schema={schema}
>
  <Breadcrumbs crumbs={crumbs} />
  <article>
    <section class="hero hero--split">
      <div class="container">
        <div>
          <p class="eyebrow">{e.eventType}{e.sign ? ` · ${e.sign}` : ''}</p>
          <h1>{e.title}</h1>
          <p class="card__meta">
            {fmt(e.start)}{e.end ? ` – ${fmt(e.end)}` : ''} · by Mo Lumen
          </p>
        </div>
        <img
          class="hero__img"
          src={heroImage.src}
          srcset={heroImage.srcset}
          sizes="100vw"
          alt={heroImage.alt}
          width={heroImage.width}
          height={heroImage.height}
          fetchpriority="high"
        />
      </div>
    </section>
    <section class="section">
      <div class="container prose flow">
        <Content />
        <hr />
        <p class="card__meta">
          Astronomical data: {e.sourceNote} The interpretation is mine — astrology offers
          perspective, not certainty, and your choices remain your own.
        </p>
      </div>
    </section>

    <RisingSignGuidance eventType={e.eventType} title={e.title} sign={e.sign} />
  </article>
  <CTABand
    heading="What does this stir in your chart?"
    body="Sky events land differently for every chart. A reading connects the current sky to yours."
  />
</BaseLayout>
