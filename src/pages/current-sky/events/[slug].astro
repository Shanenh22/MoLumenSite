---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import CTABand from '../../../components/CTABand.astro';
import RisingSignGuidance from '../../../components/RisingSignGuidance.astro';
import { bandFor, celestial, ocean, type SiteImage } from '../../../config/images';

export async function getStaticPaths() {
  const events = (await getCollection('skyEvents')).filter((e) => !e.data.draft);
  return events.map((e) => ({
    params: { slug: e.id.replace(/\.mdx?$/, '') },
    props: { event: e },
  }));
}
const { event } = Astro.props;
const { Content } = await render(event);
const e = event.data;
const slug = event.id.replace(/\.mdx?$/, '');
const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });

const allEvents = (await getCollection('skyEvents'))
  .filter((item) => !item.data.draft)
  .sort((a, b) => a.data.start.valueOf() - b.data.start.valueOf());
const currentIndex = allEvents.findIndex((item) => item.id === event.id);
const nextEvent = currentIndex >= 0 ? allEvents[currentIndex + 1] : undefined;
const nextSlug = nextEvent?.id.replace(/\.mdx?$/, '');

const monthYear = e.start.toLocaleDateString('en-US', {
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});
const pageTitle = `${e.title}: ${monthYear}`;
const crumbs = [
  { label: 'Current Sky', href: '/current-sky/' },
  { label: e.title, href: `/current-sky/events/${slug}/` },
];

const HERO_BY_TYPE: Record<string, SiteImage[]> = {
  eclipse: [celestial.distanceUnderEclipse, ocean.lightBreakingStorm],
  lunation: [celestial.moonPhasesInWater, ocean.seaStackMoonrise, ocean.ripplesSunset],
  retrograde: [celestial.emptyChair, celestial.platform, ocean.currents],
};
function heroFor(): SiteImage {
  const pool = HERO_BY_TYPE[e.eventType];
  if (!pool) return bandFor(slug);
  let h = 0;
  for (let i = 0; i < slug.length; i++) h = (h * 31 + slug.charCodeAt(i)) >>> 0;
  return pool[h % pool.length];
}
const heroImage = heroFor();
---

<BaseLayout
  title={pageTitle}
  description={e.summary}
  path={`/current-sky/events/${slug}/`}
  breadcrumbs={crumbs}
  ogType="article"
>
  <Breadcrumbs crumbs={crumbs} />
  <article>
    <section class="hero hero--split">
      <div class="container">
        <div>
          <p class="eyebrow">{e.eventType}{e.sign ? ` · ${e.sign}` : ''}</p>
          <h1>{e.title}</h1>
          <p class="card__meta">
            {fmt(e.start)}{e.end ? ` – ${fmt(e.end)}` : ''} · by
            <a href="/about/">Mo Lumen</a> · <a href="/credentials/">Credentials</a>
          </p>
        </div>
        <img
          class="hero__img"
          src={heroImage.src}
          srcset={heroImage.srcset}
          sizes="100vw"
          alt={heroImage.alt}
          width={heroImage.width}
          height={heroImage.height}
          fetchpriority="high"
        />
      </div>
    </section>
    <section class="section">
      <div class="container prose flow">
        <Content />
        <hr />
        <p class="card__meta">
          Dates and planetary positions describe the shared astronomical sky. The interpretation
          presented here is Mo Lumen's astrological interpretation, not a personal prediction. Your
          chart and lived circumstances determine how, or whether, the symbolism becomes personally
          relevant.
        </p>
      </div>
    </section>

    <RisingSignGuidance eventType={e.eventType} title={e.title} sign={e.sign} />
  </article>

  <section class="section section--alt">
    <div class="container prose flow">
      <p class="eyebrow">Keep following the sky</p>
      {nextEvent && nextSlug ? (
        <>
          <h2>Next: {nextEvent.data.title}</h2>
          <p>
            {fmt(nextEvent.data.start)}. Continue with the next pattern as it develops rather than
            treating any one event as the whole story.
          </p>
          <p><a href={`/current-sky/events/${nextSlug}/`}>Read the next sky note →</a></p>
        </>
      ) : (
        <>
          <h2>Keep the larger cycle in view</h2>
          <p>The calendar gathers the dates so you can see what comes before and after this event.</p>
        </>
      )}
      <p>
        <a href="/current-sky/calendar/">See the Sky Calendar</a> ·
        <a href="/current-sky/">Return to Current Sky</a> ·
        <a href="/newsletter/">Get Mo's monthly note</a>
      </p>
    </div>
  </section>

  <CTABand
    heading="What does this touch in your chart?"
    body="If this shared pattern has raised a real personal question, the Reading Finder can help you decide whether a reading fits and which kind would be useful."
    buttonLabel="Find Your Reading"
    buttonHref="/reading-finder/"
    secondaryLabel="Keep following the shared sky"
    secondaryHref="/current-sky/calendar/"
  />
</BaseLayout>
