---
import BaseLayout from '../layouts/BaseLayout.astro';
import { scenes } from '../config/images';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
const crumbs = [{ label: 'Newsletter', href: '/newsletter/' }];
---

<BaseLayout
  title="A monthly note from Mo"
  description="A free monthly note from Mo Lumen: current sky, questions worth following, and ideas she has been thinking about across astrology, cycles, nature, and lived experience."
  path="/newsletter/"
  breadcrumbs={crumbs}
>
  <Breadcrumbs crumbs={crumbs} />
  <section class="hero hero--split">
    <div class="container">
      <div>
        <p class="eyebrow">Newsletter</p>
        <h1>A monthly note from Mo</h1>
        <p class="lede">
          Once a month I send a letter about what has caught my attention: something moving in the
          sky, a pattern I keep noticing, a question worth carrying for a while, or a connection I
          have been thinking about. It is correspondence, not a daily forecast or another feed to
          keep up with.
        </p>
      </div>
      <img
        class="hero__img"
        src={scenes.newsletterLetters.src}
        srcset={scenes.newsletterLetters.srcset}
        sizes="100vw"
        alt={scenes.newsletterLetters.alt}
        width={scenes.newsletterLetters.width}
        height={scenes.newsletterLetters.height}
        fetchpriority="high"
      />
    </div>
  </section>

  <section class="section">
    <div class="container grid grid--2" style="align-items: start;">
      <div class="flow">
        <p class="eyebrow">Once a month</p>
        <h2 id="nl-signup">Join the list</h2>
        <p>
          If you want a regular way to hear how I am thinking, including not only what is happening
          in the sky but what I am noticing around it, this is the place.
        </p>
        <NewsletterForm source="newsletter-page" labelledby="nl-signup" />
        <p class="card__meta">
          Your email is used for this newsletter only, never sold or shared. Marketing consent is
          separate from booking. See the <a href="/privacy/">privacy policy</a>.
        </p>
      </div>
      <div class="flow">
        <p class="eyebrow">What tends to arrive</p>
        <div class="grid newsletter-preview">
          <article class="card">
            <h3>The Sky This Month</h3>
            <p>A look at the larger pattern I think is worth noticing, with the limits of a shared-sky reading kept clear.</p>
          </article>
          <article class="card">
            <h3>A question or connection</h3>
            <p>Something from astrology, cycles, nature, teaching, or lived experience that has made me look twice.</p>
          </article>
          <article class="card">
            <h3>New work, when there is some</h3>
            <p>A new article, guide, class, or other project only when there is something concrete to share.</p>
          </article>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container prose flow" style="max-width: 46rem;">
      <p class="eyebrow">Prefer to read first?</p>
      <h2>You do not need to subscribe to use the site.</h2>
      <p>
        <a href="/current-sky/">Current Sky</a> follows the cycles overhead as they happen.
        <a href="/blog/">The blog</a> gives longer ideas room to develop, and
        <a href="/explore/">Explore Astrology</a> teaches the language and structure underneath
        both. All of that remains free without an email address.
      </p>
      <p>
        The newsletter is simply the more personal thread connecting those parts of the work from
        month to month.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .newsletter-preview { gap: var(--space-4); }
  .newsletter-preview .card { padding: var(--space-5); }
  .newsletter-preview h3 { margin: 0; font-size: var(--text-lg); }
  .newsletter-preview p { margin: 0; }
</style>
