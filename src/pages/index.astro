---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import Icon from '../components/Icon.astro';
import { photos, scenes } from '../config/images';

const services = (await getCollection('services')).sort(
  (a, b) => Number(b.data.featured) - Number(a.data.featured)
);
const skyEvents = (await getCollection('skyEvents'))
  .filter((e) => !e.data.draft && e.data.start >= new Date())
  .sort((a, b) => a.data.start.valueOf() - b.data.start.valueOf())
  .slice(0, 3);
/**
 * Three testimonials for the homepage, chosen by which objection they answer
 * rather than by which is most flattering: "will this mean anything to me",
 * "will she just tell me what to do", "I know nothing about astrology".
 *
 * Filtered on `approved` like every other surface — an unapproved testimonial
 * must never render anywhere. If one of these is ever withdrawn the filter drops
 * it and the grid simply shows fewer, which is the correct failure mode.
 */
const HOME_QUOTE_IDS = ['claire-m-natal', 'rachel-t-life-changes', 'jennifer-l-natal'];
const homeQuotes = (await getCollection('testimonials'))
  .filter((t) => t.data.approved && HOME_QUOTE_IDS.includes(t.id))
  .sort((a, b) => HOME_QUOTE_IDS.indexOf(a.id) - HOME_QUOTE_IDS.indexOf(b.id));

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', timeZone: 'UTC' });

const serviceIcons: Record<string, string> = {
  natal: 'chart',
  relationship: 'people',
  'solar-return': 'sun',
  'life-changes': 'mountains',
  'want-more-clarity': 'spark',
  'monthly-transits': 'moon',
  'quick-check-in': 'clock',
};
const serviceImages: Record<string, (typeof scenes)[keyof typeof scenes]> = {
  natal: scenes.natal,
  relationship: scenes.relationship,
  'solar-return': scenes.solarReturn,
  'life-changes': scenes.lifeChanges,
  'want-more-clarity': scenes.moreClarity,
  'monthly-transits': scenes.monthlyTransits,
  'quick-check-in': scenes.quickCheckIn,
};

const values = [
  ['spark', 'Insight', 'See the patterns with clarity'],
  ['choice', 'Empowerment', 'Make choices aligned with your truth'],
  ['heart', 'Compassion', 'A safe space to be fully yourself'],
  ['leaf', 'Growth', 'Navigate change and step into possibility'],
  ['sun', 'Practical Wisdom', 'Grounded guidance for real life'],
  ['compass', 'Your Unique Path', 'Honoring your story, your timing, your way'],
] as const;
---

<BaseLayout
  title="Home"
  description="Clarifying astrology readings with a classical lens — practical, candid, and warm. Book a natal chart, relationship, solar return, or transit reading with Mo Lumen."
  path="/"
>
  <!-- Hero: night workspace photograph + real photo of Mo -->
  <section class="hero hero--home" style={`--hero-image: url('${scenes.heroWorkspace.src}');`}>
    <div class="container">
      <div>
        <p class="eyebrow">✦ Mo Lumen Astrology</p>
        <h1 style="max-width: 14ch;">See yourself in a new light.</h1>
        <p class="lede">
          Insightful. Empowering. Personal. I'm Mo — astrologer, teacher, and interpreter of the
          language of the planets. A reading with me connects your birth chart to your real life:
          your decisions, your relationships, your timing.
        </p>
        <div class="hero__actions">
          <a class="btn btn--accent" href="/reading-finder/">Find Your Reading</a>
          <a class="btn btn--ghost" href="/about/">Meet Mo</a>
        </div>
        {/*
          The dream outcome, and it is deliberately not a promise of results.
          "Perspective you can use" was a texture, not an outcome — nothing a
          reader can picture. But this site cannot promise what will happen to
          someone's life either: the disclaimer says astrology offers
          perspective rather than certainty, and Mo's own words are "I am not a
          fortune teller".

          So the outcome named here is the one clients actually report, in their
          own words on /testimonials/ — Claire: "things I've felt about myself
          forever and just never had words for." Language for what you are
          already living is a real transformation, it is honest, and it is
          evidenced. Do not upgrade it into a guarantee.
        */}
        <p class="hero__reassure">
          No belief required. No doom, no scare tactics — just words for something you've been
          living for years.
        </p>
        {/*
          The brand line, in Mo's own words from /about/. It sits where a
          credentials line used to and does the same job differently: it earns
          trust by saying what she believes rather than by listing what she has
          passed. Kept as a quiet closing thought so it does not compete with the
          two buttons above it.
        */}
        <p class="hero__tagline">
          There is fate and there is choice — and a good reading helps you tell the difference.
        </p>
      </div>
      <figure class="hero__portrait">
        <img
          src="/images/mo-home-760.webp"
          srcset="/images/mo-home-420.webp 420w, /images/mo-home-760.webp 760w, /images/mo-home.webp 1000w"
          sizes="(min-width: 900px) 380px, 100vw"
          alt={photos.moHome.alt}
          width={photos.moHome.width}
          height={photos.moHome.height}
          fetchpriority="high"
        />
        <figcaption>Mo — astrologer, teacher, writer</figcaption>
      </figure>
    </div>
  </section>

  <!-- Value row (icon strip) -->
  <section class="section section--strip">
    <div class="container">
      <h2 class="visually-hidden">What a reading offers</h2>
      <div class="value-row value-row--6">
        {
          values.map(([icon, title, desc]) => (
            <div class="value">
              <span class="value__icon"><Icon name={icon as any} size={26} /></span>
              <h3>{title}</h3>
              <p>{desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Map, not mandate — night band -->
  <section class="section section--night center">
    <div class="container flow" style="max-width: 46rem;">
      <div class="divider"><Icon name="star" size={18} /></div>
      <h2 style="font-size: var(--text-3xl);">Astrology is a map, not a mandate.</h2>
      <p class="lede" style="margin-inline: auto;">
        You are the author of your life. There is fate and there is choice — a good reading helps
        you tell the difference, and knowledge brings insight, insight brings power, power brings
        freedom.
      </p>
    </div>
  </section>

  <!-- Recognition -->
  <section class="section">
    <div class="container feature-split">
      <div class="flow">
        <p class="eyebrow">Why people come</p>
        <h2 style="max-width: 22ch;">You don't need to know astrology. You just need a real question.</h2>
        {/*
          Audience specificity. This paragraph used to open with three separate
          "maybe"s across five situations — hedging toward every possible reader,
          which is how copy ends up addressed to nobody in particular. It now
          describes one recognisable person: someone mid-decision who has already
          exhausted the people around them.

          Still true of everyone else who books; it just stops trying to say so
          in the same breath.
        */}
        <p>
          Most people who book me are somewhere in the middle of a decision they've already been
          carrying for months — a job that fits worse every year, a relationship they can't get a
          clear view of, a move they keep almost making. They've talked it through with everyone
          close to them, and the conversation has stopped going anywhere new.
        </p>
        <p>
          That's the hour I'm useful for. Your chart won't tell you what to do. It will show you
          the shape of the thing you've been circling — and that's usually what was missing.
        </p>
        <p><a class="btn btn--primary" href="/reading-finder/">Try the Reading Finder</a></p>
      </div>
      <img
        src={scenes.chartDetail.src}
        alt={scenes.chartDetail.alt}
        width={scenes.chartDetail.width}
        height={scenes.chartDetail.height}
        loading="lazy"
      />
    </div>
  </section>

  <!-- Readings preview -->
  <section class="section section--alt">
    <div class="container">
      <p class="eyebrow">Readings</p>
      <h2>One approach, wherever you are</h2>
      <p class="lede">
        Your chart, connected directly to your real life — by a certified astrologer with a
        classical lens and a practical streak. Start with a natal reading; return for the year
        ahead, life's transitions, or a monthly one-on-one.
      </p>
      <div class="grid grid--3" style="margin-top: var(--space-8);">
        {
          services.slice(0, 3).map((s) => {
            const im = serviceImages[s.data.slug];
            return (
              <article class:list={['card', 'card--img', { 'card--featured': s.data.featured }]}>
                {im && <img src={im.src} alt={im.alt} width={im.width} height={im.height} loading="lazy" />}
                <div class="card__body">
                  <h3 style="display: flex; align-items: center; gap: var(--space-2); font-size: var(--text-xl);">
                    <span style="color: var(--color-teal);"><Icon name={serviceIcons[s.data.slug] as any} size={24} /></span>
                    <a href={`/readings/${s.data.slug}/`}>{s.data.name}</a>
                  </h3>
                  <p class="card__meta" style="margin: 0;">{s.data.durationLabel}</p>
                  <p style="margin: 0;">{s.data.purpose}</p>
                  <p class="price" style="margin-top: auto;">
                    {s.data.priceLabel ?? (s.data.price ? `$${s.data.price}` : '')}
                  </p>
                </div>
              </article>
            );
          })
        }
      </div>
      <div class="grid grid--4" style="margin-top: var(--space-6);">
        {
          services.slice(3).map((s) => (
            <article class="card" style="gap: var(--space-2);">
              <span style="color: var(--color-teal);">
                <Icon name={serviceIcons[s.data.slug] as any} size={26} />
              </span>
              <h3 style="font-size: var(--text-lg); margin: 0;">
                <a href={`/readings/${s.data.slug}/`}>{s.data.shortName}</a>
              </h3>
              <p class="card__meta" style="margin: 0;">
                {s.data.durationLabel} · {s.data.priceLabel ?? `$${s.data.price}`}
              </p>
            </article>
          ))
        }
      </div>
      <p style="margin-top: var(--space-6);">
        <a href="/readings/">Compare all readings side by side →</a>
      </p>

      {/*
        Risk reversal, next to the prices rather than buried.

        Every line here was already true and already written — in
        /booking-policy/, which is exactly where nobody reads it while deciding
        whether to spend $150 on a stranger. Nothing has been invented or
        upgraded; if the policy changes, change it there and here together.
      */}
      <ul class="assurances">
        <li>
          <strong>Reschedule free</strong> up to 48 hours before. Inside that window your fee is
          held as credit, not lost.
        </li>
        <li>
          <strong>If I have to cancel</strong>, you choose — reschedule, or a full refund.
        </li>
        <li>
          <strong>Every reading is recorded</strong>, and the recording is yours to keep.
        </li>
        <li>
          <strong>Your birth data stays yours.</strong> Never sold, never shared, deleted on
          request. <a href="/privacy/">The privacy policy</a> says so in plain words.
        </li>
      </ul>
    </div>
  </section>

  {/*
    Council note: nine real, permissioned testimonials existed on a page almost
    nobody reaches. These three are chosen to answer the three objections a
    first-time visitor actually arrives with — "will this mean anything?",
    "will she just tell me what to do", and "I know nothing about astrology,
    will I feel stupid?" — in clients' own words rather than in marketing copy.

    Real words only. Fabricated testimonials are illegal under the FTC rule and
    would destroy the one thing this site is actually selling.
  */}
  <section class="section section--alt">
    <div class="container">
      <p class="eyebrow">In their words</p>
      <h2>What people say afterwards</h2>
      <div class="quote-grid">
        {
          homeQuotes.map((t) => (
            <figure class="quote-card">
              <blockquote>{t.data.quote}</blockquote>
              <figcaption>
                {t.data.attribution}
                {t.data.service ? <span> · {t.data.service.replace(/-/g, ' ')} reading</span> : null}
              </figcaption>
            </figure>
          ))
        }
      </div>
      <p style="margin-top: var(--space-6);">
        <a href="/testimonials/">Read the rest — and what you can verify without taking my word for it →</a>
      </p>
    </div>
  </section>

  <!-- About preview -->
  <section class="section">
    <div class="container feature-split feature-split--rev">
      <div class="flow">
        <p class="eyebrow">About Mo</p>
        <h2>Astrologer. Teacher. Writer.</h2>
        <p>
          Hello — I'm Maureen, a.k.a. Mo: a modern-day astrologer with a classical lens. Before
          astrology I ran businesses and taught natural sciences from middle school through
          college, and I bring both to the chart: practical grounding and a teacher's knack for
          making complex things clear.
        </p>
        <p>
          I hold a Practitioner's Certificate in Horary Astrology from the School of Traditional
          Astrology, have passed NCGR-PAA Level 1 and 2 certification exams, and serve on the
          board of the Organization for Professional Astrologers.
        </p>
        <p>
          <a class="btn btn--ghost" href="/about/">Meet Mo</a>
          <a class="btn btn--ghost" href="/credentials/">Credentials</a>
        </p>
      </div>
      <img
        class="img-portrait"
        src="/images/mo-shelf-760.webp"
        srcset="/images/mo-shelf-420.webp 420w, /images/mo-shelf-760.webp 760w"
        sizes="(min-width: 900px) 420px, 100vw"
        alt={photos.moShelf.alt}
        width={photos.moShelf.width}
        height={photos.moShelf.height}
        loading="lazy"
        style="max-width: 420px; justify-self: center;"
      />
    </div>
  </section>

  <!-- How it works -->
  <section class="section section--alt">
    <div class="container">
      <p class="eyebrow">How it works</p>
      <h2>From booking to insight, in six easy steps</h2>
      <ol class="grid grid--3" style="list-style: none; padding: 0; margin-top: var(--space-8);">
        {
          [
            ['calendar', 'Choose', 'Pick a reading — or let the Reading Finder suggest one.'],
            ['clock', 'Schedule', 'Choose a time that works; times show in your own time zone.'],
            ['star', 'Pay', 'Pay securely online when you book. No surprises later.'],
            ['letter', 'Share', 'Send your birth details and questions through the intake form.'],
            ['book', 'Prepare', "You'll get simple preparation notes — nothing to study."],
            ['people', 'Meet', 'We talk, one-on-one. You leave with a recording and your chart.'],
          ].map(([icon, t, d], i) => (
            <li class="card" style="gap: var(--space-2);">
              <span style="display: flex; align-items: center; gap: var(--space-3); color: var(--accent-ink);">
                <Icon name={icon as any} size={26} />
                <span class="eyebrow" style="margin: 0;">Step {i + 1}</span>
              </span>
              <h3 style="margin: 0;">{t}</h3>
              <p style="margin: 0;">{d}</p>
            </li>
          ))
        }
      </ol>
      <p style="margin-top: var(--space-6);">
        <a href="/how-readings-work/">Everything to expect, step by step →</a>
      </p>
    </div>
  </section>

  <!-- Current Sky + Explorer — night band -->
  <section class="section section--night">
    <div class="container grid grid--2">
      {/*
        Current Sky is the one thing here no comparable astrologer's site has: a
        dated, sourced calendar of what is actually overhead, with rising-sign
        guidance on every lunation. It was previously a bare list of links in
        half a band. It now says what it is and what makes it different, because
        an asset nobody understands is not an asset.
      */}
      <div class="flow">
        <p class="eyebrow">The sky right now</p>
        <h2>Current Sky</h2>
        <p>
          Every lunation, eclipse and retrograde through the end of the year — dated, sourced, and
          written up with guidance for <strong>all twelve rising signs</strong>. Free, no email
          required.
        </p>
        {
          skyEvents.length > 0 && (
            <ul style="padding-left: 1.1em;">
              {skyEvents.map((e) => (
                <li>
                  <strong>{fmt(e.data.start)}</strong> —{' '}
                  <a href={`/current-sky/events/${e.id.replace(/\.mdx?$/, '')}/`}>{e.data.title}</a>
                </li>
              ))}
            </ul>
          )
        }
        <p>
          <a class="btn btn--accent" href="/current-sky/">See the full timeline</a>
        </p>
        <p class="card__meta" style="margin: 0;">
          Or see it <a href="/current-sky/calendar/">month by month on the calendar</a>.
        </p>
      </div>
      <div class="flow">
        <p class="eyebrow">Free interactive tool</p>
        <h2>Explore Your Chart</h2>
        <p>
          An interactive tour of how a birth chart actually works — planets as drives, signs as
          styles, houses as arenas. No birth data needed; it's education, not a reading.
        </p>
        <p><a class="btn btn--accent" href="/tools/explore-your-chart/">Open the explorer</a></p>
      </div>
    </div>
  </section>

  <!-- Photo mosaic + learning pathways -->
  <section class="section">
    <div class="container flow">
      <div class="mosaic">
        {
          [scenes.planets, scenes.signs, scenes.currentSkyWide, scenes.duskMountains].map((im) => (
            <img src={im.src} alt={im.alt} width={im.width} height={im.height} loading="lazy" />
          ))
        }
      </div>
      <div class="grid grid--4" style="margin-top: var(--space-6);">
        {
          [
            ['book', 'Start Here', '/start-here/', 'New to astrology? Nine steps, in order.'],
            ['star', 'The 12 Signs', '/explore/signs/', 'Styles of expression, Aries to Pisces.'],
            ['planet', 'The Planets', '/explore/planets/', 'Ten drives every chart contains.'],
            ['video', 'Videos', '/videos/', 'Mo on YouTube and Instagram.'],
          ].map(([icon, t, href, d]) => (
            <article class="card" style="gap: var(--space-2);">
              <span style="color: var(--color-teal);">
                <Icon name={icon as any} size={26} />
              </span>
              <h3 style="font-size: var(--text-lg); margin: 0;">
                <a href={href}>{t}</a>
              </h3>
              <p style="margin: 0;">{d}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Newsletter -->
  <section class="section section--alt">
    <div class="container feature-split">
      <div class="flow">
        <p class="eyebrow">Free newsletter</p>
        <h2 id="home-newsletter">The Sky This Month</h2>
        <p>
          Once a month: what's moving overhead, what it means, and one practical thing to do about
          it. Written by Mo, read in five minutes, unsubscribe anytime.
        </p>
        <NewsletterForm source="homepage" labelledby="home-newsletter" />
      </div>
      <img
        src={scenes.newsletterLetters.src}
        alt={scenes.newsletterLetters.alt}
        width={scenes.newsletterLetters.width}
        height={scenes.newsletterLetters.height}
        loading="lazy"
      />
    </div>
  </section>

  <!-- Final invitation -->
  <section class="section section--night center">
    <div class="container flow">
      <div class="divider"><Icon name="moon" size={20} /></div>
      {/*
        This used to read "Whenever you're ready, the sky's not going anywhere /
        Take your time." Gracious, and it was the last thing on the page — an
        instruction to leave, placed directly above the only button. The warmth
        was worth keeping; the exit was not. It now invites rather than defers,
        and still refuses to pressure anyone.
      */}
      <h2>Bring me your real question.</h2>
      <p class="lede" style="margin-inline: auto;">
        You don't need to know any astrology to start — that's my job. Come with what's actually
        on your mind, and we'll look at your chart together.
      </p>
      <p><a class="btn btn--accent" href="/book/">Book a Reading</a></p>
      <p class="card__meta" style="margin-inline: auto;">
        Not sure which one? <a href="/reading-finder/">Answer five questions</a> and I'll tell you
        what I'd suggest.
      </p>
    </div>
  </section>
</BaseLayout>