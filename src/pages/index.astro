---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import { photos, scenes } from '../config/images';
import { orderServices, eligibilityLabel } from '../config/booking.ts';
import YouTubeFacade from '../components/YouTubeFacade.astro';
import { site } from '../config/site';

const welcomeId = site.integrations.welcomeVideoId;
const welcomePoster = site.integrations.welcomeVideoPoster;
const services = orderServices(await getCollection('services'), (s) => s.data.slug);
const skyEvents = (await getCollection('skyEvents'))
  .filter((e) => !e.data.draft && e.data.start >= new Date())
  .sort((a, b) => a.data.start.valueOf() - b.data.start.valueOf())
  .slice(0, 2);
const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', timeZone: 'UTC' });
---

<BaseLayout
  title="Home"
  description="Thoughtful astrology readings with Mo Lumen: natal, relationship, solar return, and transit consultations that connect chart patterns with real life while keeping your choices your own."
  path="/"
>
  <section class="hero hero--home" style={`--hero-image: url('${scenes.heroWorkspace.src}');`}>
    <div class="container">
      <div>
        <p class="eyebrow">✦ Mo Lumen Astrology</p>
        <h1 style="max-width: 14ch;">See yourself in a new light.</h1>
        <p class="lede">
          I'm Mo, an astrologer, teacher, and interpreter of the language of the planets. I look
          for the patterns in your chart, the timing around you now, and the life you're actually
          living, then we make sense of them together.
        </p>
        <div class="hero__actions">
          <a class="btn btn--accent" href="/reading-finder/">Find Your Reading</a>
          <a class="btn btn--ghost" href="/about/">Meet Mo</a>
        </div>
        <p class="hero__tagline">
          There is fate and there is choice, and a good reading helps you tell the difference.
        </p>
      </div>
      <figure class="hero__portrait">
        <img
          src="/images/mo-home-760.webp"
          srcset="/images/mo-home-420.webp 420w, /images/mo-home-760.webp 760w, /images/mo-home.webp 1000w"
          sizes="(min-width: 900px) 380px, 100vw"
          alt={photos.moHome.alt}
          width={photos.moHome.width}
          height={photos.moHome.height}
          fetchpriority="high"
        />
        <figcaption>Mo: astrologer, teacher, and writer</figcaption>
      </figure>
    </div>
  </section>

  <section class="section">
    <div class="container feature-split">
      <div class="flow">
        <p class="eyebrow">Why people come</p>
        <h2>You don't need to know astrology. You just need a real question.</h2>
        <p>
          Maybe you are weighing a decision, trying to understand a relationship, noticing a
          pattern that keeps returning, or moving through a season when the old map no longer fits.
          Those are useful places to begin.
        </p>
        <p>
          I am not looking for one placement that tells you who you are or what you should do. I am
          looking at how the chart works as a whole, what is active now, and what becomes clearer
          when we put that picture beside the life you are actually living.
        </p>
        <p><a class="btn btn--primary" href="/reading-finder/">Tell Me What Brings You Here</a></p>
      </div>
      <img
        src={scenes.chartDetail.src}
        alt={scenes.chartDetail.alt}
        width={scenes.chartDetail.width}
        height={scenes.chartDetail.height}
        loading="lazy"
      />
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <p class="eyebrow">Choose your path</p>
      <h2>What would be most useful right now?</h2>
      <div class="grid grid--3" style="margin-top: var(--space-6);">
        <article class="card">
          <h3><a href="/start-here/">I want to understand astrology</a></h3>
          <p>Start with the pieces of a chart, then learn how they modify and complicate one another.</p>
          <p style="margin-top: auto;"><a href="/start-here/">Start from the beginning →</a></p>
        </article>
        <article class="card">
          <h3><a href="/reading-finder/">I'm considering a reading</a></h3>
          <p>Answer a few plain-language questions and see which reading I would point you toward, and why.</p>
          <p style="margin-top: auto;"><a href="/reading-finder/">Use the Reading Finder →</a></p>
        </article>
        <article class="card">
          <h3><a href="/current-sky/">I want to see what Mo is noticing now</a></h3>
          <p>Follow the current sky, verified dates, and the patterns I think are worth watching without turning them into personal predictions.</p>
          <p style="margin-top: auto;"><a href="/current-sky/">See the Current Sky →</a></p>
        </article>
      </div>
    </div>
  </section>

  <section class="section section--night center">
    <div class="container flow" style="max-width: 46rem;">
      <h2>Astrology is a map, not a mandate.</h2>
      <p class="lede" style="margin-inline: auto;">
        A chart can describe conditions, tendencies, timing, and patterns. It cannot live your life
        for you. I use astrology to widen the view, name what may be difficult to see from the
        inside, and give you more room to decide what comes next.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">Readings</p>
      <h2>If you're new to me, begin with the foundation</h2>
      <p class="lede">
        Most first-time clients begin with a Natal Chart Reading. If the reason you are coming is a
        relationship between two people, the Relationship Consultation is also open to new clients.
        Returning-client readings build on the natal work we have already done together.
      </p>
      <div class="grid grid--3" style="margin-top: var(--space-6);">
        {services.slice(0, 2).map((s) => (
          <article class="card">
            <h3><a href={`/readings/${s.data.slug}/`}>{s.data.name}</a></h3>
            <p class="card__meta">{s.data.durationLabel} · {s.data.priceLabel ?? (s.data.price ? `$${s.data.price}` : '')}</p>
            {eligibilityLabel(s.data.audience) && <p class="eligibility-chip">{eligibilityLabel(s.data.audience)}</p>}
            <p>{s.data.purpose}</p>
            <p style="margin-top: auto;"><a href={`/readings/${s.data.slug}/`}>See whether it fits →</a></p>
          </article>
        ))}
        <article class="card" style="background: var(--bg-alt);">
          <h3><a href="/readings/">Already worked with me?</a></h3>
          <p>Follow-up readings focus on a year ahead, a transition, a specific question, or ongoing timing after we already know your natal foundation.</p>
          <p style="margin-top: auto;"><a href="/readings/#follow-ups">See follow-up readings →</a></p>
        </article>
      </div>
      <p style="margin-top: var(--space-6);"><a href="/readings/">Compare all readings →</a></p>
    </div>
  </section>

  {welcomeId && (
    <section class="section section--alt">
      <div class="container" style="max-width: 46rem;">
        <p class="eyebrow">A minute with Mo</p>
        <h2>Before you decide, hear how I actually talk</h2>
        <p class="lede">A reading is a conversation with a real person. Here is a minute with me before we ever sit down together.</p>
        <div style="margin-top: var(--space-6);">
          <YouTubeFacade videoId={welcomeId} title="Meet Mo Lumen: a short introduction" poster={welcomePoster || undefined} context="home-welcome" />
        </div>
      </div>
    </section>
  )}

  {skyEvents.length > 0 && (
    <section class="section">
      <div class="container">
        <p class="eyebrow">Current sky</p>
        <h2>What I'm watching next</h2>
        <div class="grid grid--2" style="margin-top: var(--space-6);">
          {skyEvents.map((e) => (
            <article class="card">
              <p class="card__meta">{fmt(e.data.start)}</p>
              <h3><a href={`/current-sky/events/${e.id.replace(/\.mdx?$/, '')}/`}>{e.data.title}</a></h3>
              <p>{e.data.summary}</p>
            </article>
          ))}
        </div>
        <p style="margin-top: var(--space-6);"><a href="/current-sky/">See the full Current Sky →</a></p>
      </div>
    </section>
  )}

  <section class="section">
    <div class="container feature-split feature-split--rev">
      <div class="flow">
        <p class="eyebrow">About Mo</p>
        <h2>Curiosity first. Complexity welcome.</h2>
        <p>
          I have been fascinated by astrology since childhood and spent years teaching natural
          sciences. Science is not my proof of astrology; it is part of how I learned to observe
          carefully, ask better questions, respect complexity, and explain complicated systems in
          plain language.
        </p>
        <p><a class="btn btn--ghost" href="/about/">Meet Mo</a></p>
      </div>
      <img
        class="img-portrait"
        src="/images/mo-shelf-760.webp"
        srcset="/images/mo-shelf-420.webp 420w, /images/mo-shelf-760.webp 760w"
        sizes="(min-width: 900px) 420px, 100vw"
        alt={photos.moShelf.alt}
        width={photos.moShelf.width}
        height={photos.moShelf.height}
        loading="lazy"
        style="max-width: 420px; justify-self: center;"
      />
    </div>
  </section>

  <section class="section section--alt">
    <div class="container grid grid--2" style="align-items: start;">
      <div class="flow">
        <p class="eyebrow">Not ready to book?</p>
        <h2>Stay curious with me</h2>
        <p>
          My monthly note includes the sky I'm watching, along with questions, patterns, connections,
          and occasional observations from the living world that made me look twice.
        </p>
      </div>
      <div>
        <NewsletterForm source="home" />
      </div>
    </div>
  </section>
</BaseLayout>
