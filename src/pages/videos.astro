---
import { getCollection } from 'astro:content';
import { scenes } from '../config/images';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CTABand from '../components/CTABand.astro';
import YouTubeFacade from '../components/YouTubeFacade.astro';
import { site } from '../config/site';

const videos = (await getCollection('videos'))
  .filter((v) => !v.data.draft)
  .sort((a, b) => b.data.publishedDate.valueOf() - a.data.publishedDate.valueOf());

/**
 * VideoObject per real, published video — built entirely from fields the
 * collection already requires, so nothing here can be invented. `publishedDate`
 * is required by the schema, which is what makes `uploadDate` safe to emit.
 * An empty library emits no video schema at all, which is correct: there is
 * nothing to describe.
 */
const videoSchema = videos
  .filter((v) => v.data.platform === 'youtube')
  .map((v) => ({
    '@context': 'https://schema.org',
    '@type': 'VideoObject',
    name: v.data.title,
    description: v.data.description,
    uploadDate: v.data.publishedDate.toISOString().slice(0, 10),
    embedUrl: `https://www.youtube-nocookie.com/embed/${v.data.externalId}`,
    contentUrl: `https://www.youtube.com/watch?v=${v.data.externalId}`,
    ...(v.data.thumbnail ? { thumbnailUrl: new URL(v.data.thumbnail, site.url).href } : {}),
    ...(v.data.durationSeconds
      ? { duration: `PT${Math.round(v.data.durationSeconds)}S` }
      : {}),
    publisher: { '@type': 'Organization', name: site.name, url: site.url },
  }));
const categories = [
  ['current-sky', 'Current Sky'],
  ['astrology-basics', 'Astrology Basics'],
  ['relationships', 'Relationships'],
  ['personal-purpose', 'Personal Purpose'],
] as const;
const crumbs = [{ label: 'Videos', href: '/videos/' }];
const ig = site.integrations.instagramHandle;
---

<BaseLayout
  title="Videos: watch Mo teach"
  description="Mo Lumen's astrology videos from YouTube and Instagram: current sky updates, astrology basics, relationships, and personal purpose."
  path="/videos/"
  breadcrumbs={crumbs}
  schema={videoSchema}
>
  <Breadcrumbs crumbs={crumbs} />
  <section class="hero hero--split">
    <div class="container">
      <div>
      <p class="eyebrow">Watch & learn</p>
      <h1>Videos</h1>
      <p class="lede">
        Short, clear, and doom-free: Mo on the current sky and the fundamentals, from YouTube and
        Instagram.
      </p>
      </div>
      <img
        class="hero__img"
        src={scenes.videosStudio.src}
        srcset={scenes.videosStudio.srcset}
        sizes="100vw"
        alt={scenes.videosStudio.alt}
        width={scenes.videosStudio.width}
        height={scenes.videosStudio.height}
        fetchpriority="high"
      />
    </div>
  </section>

  <section class="section">
    <div class="container">
      {
        videos.length > 0 ? (
          <>
            <div class="filter-bar" role="group" aria-label="Filter videos by category" data-video-filters>
              <button type="button" aria-pressed="true" data-filter="all">All</button>
              {categories.map(([key, label]) => (
                <button type="button" aria-pressed="false" data-filter={key}>{label}</button>
              ))}
            </div>
            <div class="grid grid--2">
              {videos.map((v) => (
                <article class="card" data-video-category={v.data.category}>
                  {v.data.platform === 'youtube' ? (
                    /*
                      Shared YouTubeFacade rather than the bespoke markup that
                      used to live here. The old version fell back to
                      i.ytimg.com for a thumbnail when none was uploaded, which
                      is a Google-hosted request on page load, so the facade
                      deferred the iframe while still handing Google the
                      visitor's IP, and /privacy/ says video players "load only
                      when you interact with them". The component uses the
                      uploaded thumbnail or a branded placeholder, and requests
                      nothing from Google until the play button is pressed.
                    */
                    <YouTubeFacade
                      videoId={v.data.externalId}
                      title={v.data.title}
                      poster={v.data.thumbnail || undefined}
                      context="videos-hub"
                    />
                  ) : (
                    <a
                      class="video-facade"
                      href={v.data.externalId}
                      rel="noopener"
                      target="_blank"
                      data-instagram-link
                      style="display: grid; place-content: center; color: var(--color-ivory); text-decoration: none;"
                    >
                      <span>Watch on Instagram ↗ (opens instagram.com)</span>
                    </a>
                  )}
                  <h2 style="font-size: var(--text-lg); margin: 0;">{v.data.title}</h2>
                  <p style="margin: 0;">{v.data.description}</p>
                </article>
              ))}
            </div>
          </>
        ) : (
          /*
            Empty-state copy, written for a visitor rather than for the build.
            It used to carry an "Owner action:" note naming a JSON file and a
            docs path, a construction note left on a public page, which reads as
            an unfinished site rather than a practice that hasn't filmed yet.
            The instructions for adding videos live in docs/add-a-video.md, which
            is where they belong. Delete this branch entirely once videos.json
            has entries; the page renders the real library above automatically.
          */
          <div class="prose flow">
            <p>
              I'm still filming for this page, so there's nothing to watch here yet, I'd rather
              show you nothing than pad it out.
            </p>
            <p>
              When there is something to watch it will appear here and on
              <a href={site.social.youtube} rel="noopener">my YouTube channel ↗</a> (opens
              youtube.com), subscribing there is the way to hear about it first.
            </p>
            <p>
              In the meantime, the closest thing to watching me work is reading how I think:
              <a href="/explore/">the reference library</a> separates what's astronomical fact from
              traditional doctrine from my own synthesis, and says plainly where astrologers
              disagree. You can also find me on
              <a href={`https://www.instagram.com/${ig}/`} rel="noopener">Instagram ↗</a> (opens
              instagram.com).
            </p>
          </div>
        )
      }
    </div>
  </section>

  <CTABand />
</BaseLayout>

<script>
  // YouTube activation now lives in YouTubeFacade.astro, delegated once for
  // every facade on the page. The per-page copy that used to sit here also
  // built its iframe by string concatenation and omitted the fullscreen and
  // captions parameters the component sets.
  document.querySelectorAll('[data-instagram-link]').forEach((a) =>
    a.addEventListener('click', () =>
      (window as any).mlTrack?.('video_platform_open', { platform: 'instagram' })
    )
  );
  const bar = document.querySelector<HTMLElement>('[data-video-filters]');
  if (bar) {
    const buttons = bar.querySelectorAll<HTMLButtonElement>('button');
    const cards = document.querySelectorAll<HTMLElement>('[data-video-category]');
    buttons.forEach((btn) =>
      btn.addEventListener('click', () => {
        const f = btn.dataset.filter!;
        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        cards.forEach((c) => (c.hidden = f !== 'all' && c.dataset.videoCategory !== f));
      })
    );
  }
</script>
