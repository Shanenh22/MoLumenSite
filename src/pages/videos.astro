---
import { getCollection } from 'astro:content';
import { photos, scenes } from '../config/images';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CTABand from '../components/CTABand.astro';
import { site } from '../config/site';

const videos = (await getCollection('videos')).sort(
  (a, b) => b.data.publishedDate.valueOf() - a.data.publishedDate.valueOf()
);
const categories = [
  ['current-sky', 'Current Sky'],
  ['astrology-basics', 'Astrology Basics'],
  ['relationships', 'Relationships'],
  ['personal-purpose', 'Personal Purpose'],
] as const;
const crumbs = [{ label: 'Videos', href: '/videos/' }];
const ig = site.integrations.instagramHandle;
---

<BaseLayout
  title="Videos — watch Mo teach"
  description="Mo Lumen's astrology videos from YouTube and Instagram: current sky updates, astrology basics, relationships, and personal purpose."
  path="/videos/"
  breadcrumbs={crumbs}
>
  <Breadcrumbs crumbs={crumbs} />
  <section class="hero hero--split">
    <div class="container">
      <div>
      <p class="eyebrow">Watch & learn</p>
      <h1>Videos</h1>
      <p class="lede">
        Short, clear, and doom-free: Mo on the current sky and the fundamentals, from YouTube and
        Instagram.
      </p>
      </div>
      <img
        class="hero__img"
        src={scenes.videosStudio.src}
        srcset={scenes.videosStudio.srcset}
        sizes="100vw"
        alt={scenes.videosStudio.alt}
        width={scenes.videosStudio.width}
        height={scenes.videosStudio.height}
        fetchpriority="high"
      />
    </div>
  </section>

  <section class="section">
    <div class="container">
      {
        videos.length > 0 ? (
          <>
            <div class="filter-bar" role="group" aria-label="Filter videos by category" data-video-filters>
              <button type="button" aria-pressed="true" data-filter="all">All</button>
              {categories.map(([key, label]) => (
                <button type="button" aria-pressed="false" data-filter={key}>{label}</button>
              ))}
            </div>
            <div class="grid grid--2">
              {videos.map((v) => (
                <article class="card" data-video-category={v.data.category}>
                  {v.data.platform === 'youtube' ? (
                    <button
                      type="button"
                      class="video-facade"
                      data-video-id={v.data.externalId}
                      aria-label={`Play video: ${v.data.title}`}
                    >
                      <img
                        src={v.data.thumbnail || `https://i.ytimg.com/vi/${v.data.externalId}/hqdefault.jpg`}
                        alt=""
                        loading="lazy"
                        width="480"
                        height="270"
                      />
                      <span class="play" aria-hidden="true">
                        <span>
                          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
                        </span>
                      </span>
                    </button>
                  ) : (
                    <a
                      class="video-facade"
                      href={v.data.externalId}
                      rel="noopener"
                      target="_blank"
                      data-instagram-link
                      style="display: grid; place-content: center; color: var(--color-ivory); text-decoration: none;"
                    >
                      <span>Watch on Instagram ↗ (opens instagram.com)</span>
                    </a>
                  )}
                  <h2 style="font-size: var(--text-lg); margin: 0;">{v.data.title}</h2>
                  <p style="margin: 0;">{v.data.description}</p>
                </article>
              ))}
            </div>
          </>
        ) : (
          /*
            Empty-state copy, written for a visitor rather than for the build.
            It used to carry an "Owner action:" note naming a JSON file and a
            docs path — a construction note left on a public page, which reads as
            an unfinished site rather than a practice that hasn't filmed yet.
            The instructions for adding videos live in docs/add-a-video.md, which
            is where they belong. Delete this branch entirely once videos.json
            has entries; the page renders the real library above automatically.
          */
          <div class="prose flow">
            <p>
              I'm still filming for this page, so there's nothing to watch here yet — I'd rather
              show you nothing than pad it out.
            </p>
            <p>
              In the meantime, the closest thing to watching me work is reading how I think:
              <a href="/explore/">the reference library</a> separates what's astronomical fact from
              traditional doctrine from my own synthesis, and says plainly where astrologers
              disagree. You can also find me on
              <a href={`https://www.instagram.com/${ig}/`} rel="noopener">Instagram ↗</a> (opens
              instagram.com).
            </p>
          </div>
        )
      }
    </div>
  </section>

  <CTABand />
</BaseLayout>

<script>
  // Video facades: load YouTube (privacy-enhanced) only on user interaction.
  document.querySelectorAll<HTMLButtonElement>('[data-video-id]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const id = btn.dataset.videoId!;
      (window as any).gtag?.('event', 'video_play', { video_id: id, platform: 'youtube' });
      const wrap = document.createElement('div');
      wrap.className = 'video-wrap';
      wrap.innerHTML = `<iframe src="https://www.youtube-nocookie.com/embed/${id}?autoplay=1" title="YouTube video player" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen></iframe>`;
      btn.replaceWith(wrap);
      wrap.querySelector('iframe')?.focus();
    });
  });
  document.querySelectorAll('[data-instagram-link]').forEach((a) =>
    a.addEventListener('click', () =>
      (window as any).gtag?.('event', 'video_platform_open', { platform: 'instagram' })
    )
  );
  const bar = document.querySelector<HTMLElement>('[data-video-filters]');
  if (bar) {
    const buttons = bar.querySelectorAll<HTMLButtonElement>('button');
    const cards = document.querySelectorAll<HTMLElement>('[data-video-category]');
    buttons.forEach((btn) =>
      btn.addEventListener('click', () => {
        const f = btn.dataset.filter!;
        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        cards.forEach((c) => (c.hidden = f !== 'all' && c.dataset.videoCategory !== f));
      })
    );
  }
</script>
