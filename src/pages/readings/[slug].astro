---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CTABand from '../../components/CTABand.astro';
import EstablishedClientChooser from '../../components/EstablishedClientChooser.astro';
import { site } from '../../config/site';
import SeaBreak from '../../components/SeaBreak.astro';
import { bandFor, scenes } from '../../config/images';
import { bookingActions, finalCtaAction } from '../../config/booking.ts';

const serviceImages: Record<string, (typeof scenes)[keyof typeof scenes]> = {
  natal: scenes.natal,
  relationship: scenes.relationship,
  'solar-return': scenes.solarReturn,
  'life-changes': scenes.lifeChanges,
  'want-more-clarity': scenes.moreClarity,
  'monthly-transits': scenes.monthlyTransits,
  'quick-check-in': scenes.quickCheckIn,
};

export async function getStaticPaths() {
  const services = await getCollection('services');
  return services.map((s) => ({ params: { slug: s.data.slug }, props: { service: s } }));
}
const { service } = Astro.props;
const s = service.data;
const all = await getCollection('services');
const related = all.filter((x) => s.related.includes(x.data.slug));
const actions = bookingActions(s);
const multiOption = actions.length > 1;
const finalCta = finalCtaAction(s);
const testimonial = (await getCollection('testimonials'))
  .filter((t) => t.data.approved && t.data.service === s.slug)
  .sort((a, b) => a.id.localeCompare(b.id))[0];
const breakImage = bandFor(s.slug, 7);
const faqs = (await getCollection('faqs'))
  .filter((f) => f.data.scope === 'global' || f.data.scope === s.slug)
  .sort((a, b) => {
    const scoped = (f: typeof a) => (f.data.scope === s.slug ? 0 : 1);
    return scoped(a) - scoped(b) || a.data.order - b.data.order;
  })
  .slice(0, 5);
const crumbs = [
  { label: 'Readings', href: '/readings/' },
  { label: s.shortName, href: `/readings/${s.slug}/` },
];
const schema: object[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: s.name,
    description: s.purpose,
    provider: { '@type': 'ProfessionalService', name: site.name, url: site.url },
    url: new URL(`/readings/${s.slug}/`, site.url).href,
    ...(s.priceConfirmed && s.price
      ? {
          offers:
            s.options && s.options.length > 1
              ? {
                  '@type': 'AggregateOffer',
                  priceCurrency: s.currency,
                  lowPrice: Math.min(...s.options.map((o) => o.price)),
                  highPrice: Math.max(...s.options.map((o) => o.price)),
                  offerCount: s.options.length,
                  offers: s.options.map((o, i) => ({
                    '@type': 'Offer',
                    name: o.label,
                    price: o.price,
                    priceCurrency: s.currency,
                    availability: 'https://schema.org/InStock',
                    url: new URL(actions[i].href, site.url).href,
                  })),
                }
              : {
                  '@type': 'Offer',
                  price: s.price,
                  priceCurrency: s.currency,
                  availability: 'https://schema.org/InStock',
                  url: new URL(actions[0].href, site.url).href,
                },
        }
      : {}),
  },
];
if (faqs.length > 0) {
  schema.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.data.question,
      acceptedAnswer: { '@type': 'Answer', text: f.data.answer },
    })),
  });
}
---

<BaseLayout
  title={s.name}
  description={`${s.purpose} ${s.durationLabel}. Book online with Mo Lumen Astrology.`}
  path={`/readings/${s.slug}/`}
  breadcrumbs={crumbs}
  schema={schema}
  shareImage={serviceImages[s.slug]?.src}
>
  <Breadcrumbs crumbs={crumbs} />
  <section class="hero hero--split">
    <div class="container">
      <div>
        <p class="eyebrow">Readings</p>
        <h1>{s.name}</h1>
        <p class="lede">{s.purpose}</p>
        <ul class="hero__meta" aria-label="At a glance">
          <li>{s.durationLabel}</li>
          {s.priceConfirmed && (s.priceLabel || s.price) && <li class="hero__meta--price">{s.priceLabel ?? `$${s.price}`}</li>}
          {s.audience === 'established' && <li>Established clients</li>}
        </ul>
        <p class="hero__cta">
          <a class="btn btn--accent" href="#fit">See if this reading fits</a>
          <a class="btn btn--ghost" href="/reading-finder/">Not sure? Find your reading</a>
        </p>
      </div>
      {serviceImages[s.slug] && (
        <img
          class="hero__img"
          src={serviceImages[s.slug].src}
          srcset={serviceImages[s.slug].srcset}
          sizes="100vw"
          alt={serviceImages[s.slug].alt}
          width={serviceImages[s.slug].width}
          height={serviceImages[s.slug].height}
          fetchpriority="high"
        />
      )}
    </div>
  </section>

  <section class="section" id="fit">
    <div class="container">
      <div class="prose flow" style="margin-bottom: var(--space-7);">
        <p class="eyebrow">Start with the reason</p>
        <h2>What this reading can help you see</h2>
        <p>{s.method}</p>
      </div>
      <div class="grid grid--2">
        <article class="card">
          <h3>This is likely a good fit if…</h3>
          <ul>{s.bestFor.map((b) => <li>{b}</li>)}</ul>
        </article>
        <article class="card">
          <h3>Choose something else if…</h3>
          <ul>{s.notFor.map((b) => <li>{b}</li>)}</ul>
        </article>
      </div>
    </div>
  </section>

  {s.audience === 'established' && <EstablishedClientChooser currentSlug={s.slug} />}

  <section class="section section--alt">
    <div class="container">
      <p class="eyebrow">Practical details</p>
      <h2>What to know before you choose a time</h2>
      <dl class="factlist" style="margin-top: var(--space-6);">
        <dt>Investment</dt>
        <dd>{s.priceConfirmed && s.price ? <span class="price">{s.priceLabel ?? `$${s.price}`}</span> : <span class="price--unconfirmed">Final price is being confirmed, shown clearly before you book.</span>}</dd>
        <dt>Length</dt><dd>{s.durationLabel}</dd>
        <dt>Where</dt><dd>{s.format.join(' · ')}</dd>
        <dt>Who can book</dt>
        <dd>{s.audience === 'new' ? 'New clients: no prior reading needed' : s.audience === 'established' ? 'Established clients: after a natal reading with Mo' : 'New and returning clients'}</dd>
        <dt>Birth data</dt>
        <dd>{s.birthDataRequired === 'none' ? 'Not needed' : s.birthDataRequired === 'both' ? 'Date, time, and place for both people' : 'Your date, exact time, and place of birth'}</dd>
        <dt>Afterward</dt><dd>{s.deliverables.join(' + ')}</dd>
      </dl>

      {s.options.length > 0 && (
        <section id="options" tabindex="-1" aria-labelledby="options-heading">
          <h2 id="options-heading">Choose your option</h2>
          <div class="grid grid--2" style="margin-bottom: var(--space-7);">
            {s.options.map((o, i) => {
              const a = actions[i] ?? actions[0];
              return (
                <article class="card">
                  <h3 style="font-size: var(--text-lg); margin: 0;">{o.label}</h3>
                  <p class="card__meta" style="margin: 0;">{o.durationLabel}</p>
                  <p class="price" style="margin: 0;">${o.price}</p>
                  {o.note && <p style="margin: 0;">{o.note}</p>}
                  {multiOption && <p class="card__actions" style="margin-top: auto;"><a class="btn btn--accent" href={a.href} aria-label={a.ariaLabel}>{a.label}</a></p>}
                </article>
              );
            })}
          </div>
        </section>
      )}

      {!multiOption && actions[0] && (
        <p><a class="btn btn--accent" href={actions[0].href} aria-label={actions[0].ariaLabel}>{actions[0].label}</a></p>
      )}
    </div>
  </section>

  <section class="section">
    <div class="container grid grid--2">
      <div class="prose flow">
        <p class="eyebrow">Inside the session</p>
        <h2>What we'll actually explore</h2>
        <ul>{s.includes.map((b) => <li>{b}</li>)}</ul>
      </div>
      <div class="prose flow">
        <p class="eyebrow">Before we meet</p>
        <h2>What I need from you</h2>
        <ul>{s.preparation.map((b) => <li>{b}</li>)}</ul>
        <p>You do not need to study astrology. More in <a href="/prepare-for-your-reading/">prepare for your reading</a>.</p>
      </div>
    </div>
  </section>

  {testimonial && (
    <section class="section section--alt">
      <div class="container" style="max-width: 46rem;">
        <p class="eyebrow">In their words</p>
        <figure class="quote-card">
          <blockquote>{testimonial.data.quote}</blockquote>
          <figcaption>{testimonial.data.attribution} · {s.shortName.toLowerCase()} reading</figcaption>
        </figure>
        <p class="card__meta" style="margin-top: var(--space-4);"><a href="/testimonials/">Read what other clients said →</a></p>
      </div>
    </section>
  )}

  <SeaBreak image={breakImage} />

  {faqs.length > 0 && (
    <section class="section section--alt">
      <div class="container prose">
        <h2>Questions people ask before booking</h2>
        {faqs.map((f) => (
          <details class="faq">
            <summary>{f.data.question}</summary>
            <div class="faq__body"><p>{f.data.answer}</p></div>
          </details>
        ))}
        <p><a href="/frequently-asked-questions/">All frequently asked questions →</a></p>
      </div>
    </section>
  )}

  {related.length > 0 && (
    <section class="section">
      <div class="container">
        <h2>If this is not quite the fit</h2>
        <div class="grid grid--2" style="margin-top: var(--space-6);">
          {related.map((r) => (
            <article class="card">
              <h3 style="margin: 0;"><a href={`/readings/${r.data.slug}/`}>{r.data.name}</a></h3>
              <p style="margin: 0;">{r.data.purpose}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <CTABand
    heading={`Ready for your ${s.shortName.toLowerCase()} reading?`}
    body={finalCta.kind === 'choose' ? 'This reading has more than one booking condition, so review the options above and choose the one that applies to you.' : 'Times display in your own time zone, and the price is shown again before you pay.'}
    buttonLabel={finalCta.label}
    buttonHref={finalCta.href}
    buttonAriaLabel={finalCta.ariaLabel}
  />
</BaseLayout>