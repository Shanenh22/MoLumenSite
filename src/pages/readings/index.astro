---
import { getCollection } from 'astro:content';
import { photos, scenes } from '../../config/images';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CTABand from '../../components/CTABand.astro';

import {
  orderServices,
  bookingActions,
  eligibilityLabel,
} from '../../config/booking.ts';

/**
 * Canonical order, then split by who may actually book.
 *
 * Five of the seven readings follow on from a natal reading. Presenting all
 * seven as one flat menu asked a first-time visitor to evaluate five things
 * they are not eligible for — including the cheapest row on the page — and the
 * old `featured` sort put the $275 two-person reading at the top of it. The
 * split is orientation, not gating: every reading keeps its page, its schema
 * entry and its booking link.
 */
const services = orderServices(await getCollection('services'), (s) => s.data.slug);
const startHere = services.filter((s) => s.data.audience !== 'established');
const followUps = services.filter((s) => s.data.audience === 'established');
const crumbs = [{ label: 'Readings', href: '/readings/' }];
const priceCell = (s: (typeof services)[0]) =>
  s.data.priceConfirmed && s.data.price
    ? (s.data.priceLabel ?? `$${s.data.price}`)
    : 'Confirmed at booking';
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Astrology Readings with Mo Lumen',
    itemListElement: services.map((s, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: s.data.name,
      url: `https://molumen.com/readings/${s.data.slug}/`,
    })),
  },
];
---

<BaseLayout
  title="Astrology Readings"
  description="Natal chart, relationship, solar return, life changes, and monthly transit readings with Mo Lumen — open pricing, recordings included. Compare readings and book online."
  path="/readings/"
  breadcrumbs={crumbs}
  schema={schema}
>
  <Breadcrumbs crumbs={crumbs} />
  <section class="hero hero--split">
    <div class="container">
      <div>
      <p class="eyebrow">Readings</p>
      <h1>Astrology readings with Mo</h1>
      <p class="lede">
        One approach for wherever you are: your chart connected directly to your real life —
        decisions, relationships, timing — by a certified astrologer with a classical lens and a
        practical streak. New clients start with the natal reading; established clients have a
        whole menu of follow-ups, from a yearly solar return to a 30-minute check-in.
      </p>
      </div>
      <img
        class="hero__img"
        src={scenes.readingProcess.src}
        srcset={scenes.readingProcess.srcset}
        sizes="100vw"
        alt={scenes.readingProcess.alt}
        width={scenes.readingProcess.width}
        height={scenes.readingProcess.height}
        fetchpriority="high"
      />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 id="start-here">New to Mo? Start here</h2>
      <p class="lede">
        These two are open to everyone. Most people begin with the natal reading — it's the
        foundation every other reading builds on.
      </p>
      <div class="grid grid--3" style="margin-top: var(--space-6);">
        {
          startHere.map((s) => (
            <article class="card">
              <h3 style="font-size: var(--text-xl); margin: 0;">
                <a href={`/readings/${s.data.slug}/`}>{s.data.name}</a>
              </h3>
              <p class="card__meta">{s.data.durationLabel} · {priceCell(s)}</p>
              <p>{s.data.purpose}</p>
              {/*
                One action per real option, from bookingActions() — so a
                multi-price reading offers both prices here rather than
                quietly resolving to one of them. The natal card shows
                "Book 1 hour 30 minutes — $200" and "Book 1 hour — $150";
                a single-option reading still shows one "Book this reading".
              */}
              <p class="card__actions">
                {bookingActions(s.data).map((a) => (
                  <a class="btn btn--accent" href={a.href} aria-label={a.ariaLabel}>
                    {a.label}
                  </a>
                ))}
                <a href={`/readings/${s.data.slug}/`}>Learn more →</a>
              </p>
            </article>
          ))
        }
        <article class="card" style="background: var(--bg-alt);">
          <h3 style="font-size: var(--text-xl); margin: 0;">Not sure which fits?</h3>
          {/* "three quick questions" was left behind when the finder went from
              two questions to five. It is a promise a visitor can disprove in
              one click, which is the worst kind of small inaccuracy to leave on
              a conversion page. */}
          <p>
            Answer five quick questions and get a suggestion — or start with the natal reading,
            the foundation everything else builds on.
          </p>
          <p style="margin: 0;"><a class="btn btn--primary" href="/reading-finder/">Reading Finder</a></p>
        </article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 id="follow-ups">Already had your natal reading?</h2>
      <p class="lede">
        These follow on from a natal reading with me — they start from a chart we've already been
        through together, so we can go straight to the question.
      </p>
      <div class="grid grid--3" style="margin-top: var(--space-6);">
        {
          followUps.map((s) => (
            <article class="card">
              <h3 style="font-size: var(--text-xl); margin: 0;">
                <a href={`/readings/${s.data.slug}/`}>{s.data.name}</a>
              </h3>
              <p class="card__meta">{s.data.durationLabel} · {priceCell(s)}</p>
              <p class="eligibility-chip">{eligibilityLabel(s.data.audience)}</p>
              <p>{s.data.purpose}</p>
              <p class="card__actions">
                {bookingActions(s.data).map((a) => (
                  <a class="btn btn--accent" href={a.href} aria-label={a.ariaLabel}>
                    {a.label}
                  </a>
                ))}
                <a href={`/readings/${s.data.slug}/`}>Learn more →</a>
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>Compare readings at a glance</h2>

      <!-- Mobile: stacked cards -->
      <div class="compare-cards">
        {
          services.map((s) => (
            <article class="card">
              <h3 style="margin: 0;">{s.data.shortName}</h3>
              <dl class="factlist" style="margin: 0; padding: var(--space-4);">
                <dt>Who can book</dt>
                <dd>{eligibilityLabel(s.data.audience) ?? 'Anyone — no prior reading needed'}</dd>
                <dt>Best for</dt>
                <dd>{s.data.bestFor[0]}</dd>
                <dt>Length</dt>
                <dd>{s.data.durationLabel}</dd>
                <dt>Birth data</dt>
                <dd>
                  {s.data.birthDataRequired === 'none'
                    ? 'Not needed'
                    : s.data.birthDataRequired === 'both'
                      ? 'Both people'
                      : 'Date, time, place'}
                </dd>
                <dt>Price</dt>
                <dd>{priceCell(s)}</dd>
              </dl>
              <p class="card__actions">
                {bookingActions(s.data).map((a) => (
                  <a class="btn btn--accent" href={a.href} aria-label={a.ariaLabel}>
                    {a.label}
                  </a>
                ))}
                <a href={`/readings/${s.data.slug}/`}>Full details →</a>
              </p>
            </article>
          ))
        }
      </div>

      <!-- Desktop: accessible table -->
      <table class="compare-table">
        <caption class="visually-hidden">Comparison of all readings</caption>
        <thead>
          <tr>
            <th scope="col">Reading</th>
            <th scope="col">Who can book</th>
            <th scope="col">Best for</th>
            <th scope="col">Length</th>
            <th scope="col">Birth data</th>
            <th scope="col">Price</th>
            <th scope="col">Book</th>
          </tr>
        </thead>
        <tbody>
          {
            services.map((s) => (
              <tr>
                <th scope="row">
                  <a href={`/readings/${s.data.slug}/`}>{s.data.shortName}</a>
                </th>
                <td>{eligibilityLabel(s.data.audience) ?? 'Anyone'}</td>
                <td>{s.data.bestFor[0]}</td>
                <td>{s.data.durationLabel}</td>
                <td>
                  {s.data.birthDataRequired === 'none'
                    ? 'Not needed'
                    : s.data.birthDataRequired === 'both'
                      ? 'Both people'
                      : 'Yes'}
                </td>
                <td>{priceCell(s)}</td>
                <td>
                  {/* One link per bookable option, so a two-price reading is
                      never collapsed into a single "Book" that picks for the
                      customer. The accessible name carries the reading and the
                      option, because a screen-reader user listing the links on
                      this page would otherwise hear "Book" nine times with
                      nothing to tell them apart. */}
                  <ul class="compare-book">
                    {bookingActions(s.data).map((a) => (
                      <li>
                        <a href={a.href} aria-label={a.ariaLabel}>
                          {bookingActions(s.data).length > 1 ? a.durationLabel : 'Book'}
                        </a>
                      </li>
                    ))}
                  </ul>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
      <p class="card__meta">
        Prices as currently listed on Mo's scheduler. Every price is always shown again before
        you pay. Readings marked "established clients" follow an initial natal reading with Mo.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container grid grid--3">
      <article class="card">
        <h2 style="font-size: var(--text-lg); margin: 0;"><a href="/readings/gift/">Gift a reading</a></h2>
        <p style="margin: 0;">A reading makes a remarkable gift — here's how it works.</p>
      </article>
      <article class="card">
        <h2 style="font-size: var(--text-lg); margin: 0;"><a href="/how-readings-work/">What to expect</a></h2>
        <p style="margin: 0;">Every step from booking to recording, explained.</p>
      </article>
      <article class="card">
        <h2 style="font-size: var(--text-lg); margin: 0;"><a href="/frequently-asked-questions/">Reading FAQs</a></h2>
        <p style="margin: 0;">Honest answers to the questions everyone asks.</p>
      </article>
    </div>
  </section>

  <CTABand />
</BaseLayout>
