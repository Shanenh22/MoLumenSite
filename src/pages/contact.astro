---
import BaseLayout from '../layouts/BaseLayout.astro';
import { photos, scenes } from '../config/images';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import { site } from '../config/site';
const crumbs = [{ label: 'Contact', href: '/contact/' }];
---

<BaseLayout
  title="Contact Mo"
  description="Get in touch with Mo Lumen Astrology — questions about readings, bookings, or anything astrological. I read every message myself."
  path="/contact/"
  breadcrumbs={crumbs}
>
  <Breadcrumbs crumbs={crumbs} />
  <section class="hero hero--split">
    <div class="container">
      <div>
      <p class="eyebrow">Say hello</p>
      <h1>Get in touch</h1>
      <p class="lede">
        If you have any questions — or you just want to learn more about my astrology readings —
        email me. I read every message myself.
      </p>
      </div>
      <img
        class="hero__img"
        src={scenes.aboutMo.src}
        srcset={scenes.aboutMo.srcset}
        sizes="100vw"
        alt={scenes.aboutMo.alt}
        width={scenes.aboutMo.width}
        height={scenes.aboutMo.height}
        fetchpriority="high"
      />
    </div>
  </section>
  <section class="section">
    <div class="container grid grid--2" style="align-items: start;">
      <div class="flow">
        <h2>Email</h2>
        <p>
          <a
            class="btn btn--primary"
            href={`mailto:${site.email}?subject=${encodeURIComponent('I want to know more about...')}`}
            data-contact-email>{site.email}</a
          >
        </p>
        <p>
          Booking questions? The <a href="/frequently-asked-questions/">FAQs</a> answer most
          things; the <a href="/book/">booking page</a> handles scheduling directly.
        </p>
        {/*
          Where and how sessions happen, stated to the visitor rather than only
          to search engines.

          The E-E-A-T audit flagged that a reader had no way to tell where this
          practice operates from, while the JSON-LD in BaseLayout already
          asserts a service area. Only confirmed facts are stated here: every
          service in src/content/services/*.json lists its format as Zoom or
          Phone, so "online, book from anywhere" is safe.

          Deliberately NOT stated: in-person sessions in Dallas–Fort Worth.
          docs/plan/open-questions.md #9 records that as unresolved, and the
          schema's "(in person, by arrangement)" claim needs Mo's answer before
          it belongs in visitor-facing copy — or in the schema.
        */}
        <h2>Where I am</h2>
        <p>
          Readings happen over Zoom, or by phone if you'd rather not be on camera — so you can book
          from anywhere, and you don't need to be near me. Times are shown in your own time zone
          when you pick one.
        </p>

        <h2>Elsewhere</h2>
        <p>
          <a href={site.social.instagram} rel="noopener">Instagram ↗</a> ·
          <a href={site.social.facebook} rel="noopener">Facebook ↗</a>
        </p>
        <p class="card__meta">
          Please don't send birth data by email unless I've asked you for it as part of a booked
          reading — it's sensitive information and deserves a proper home.
        </p>
      </div>
      <div class="card flow">
        <h2 id="contact-newsletter" style="font-size: var(--text-xl); margin: 0;">
          Prefer a slower hello?
        </h2>
        <p style="margin: 0;">
          The monthly letter is a fine way to get a feel for how I work before you reach out.
        </p>
        <NewsletterForm source="contact" labelledby="contact-newsletter" />
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  document
    .querySelector('[data-contact-email]')
    ?.addEventListener('click', () => (window as any).gtag?.('event', 'contact_submit'));
</script>
