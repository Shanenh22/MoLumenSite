---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import BirthTimeConfidence from '../components/BirthTimeConfidence.astro';
import { scenes } from '../config/images';
import { site } from '../config/site';

const crumbs = [{ label: 'Birth Time Toolkit', href: '/birth-time-toolkit/' }];
const pdfPath = '/downloads/birth-time-toolkit.pdf';
const description =
  'A worksheet set for finding your birth time: record search checklist, family interview prompts, a way to compare times that disagree, and a summary to bring to a reading.';
const schema = [{
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'The Birth Time Toolkit',
  description,
  url: new URL('/birth-time-toolkit/', site.url).href,
  inLanguage: 'en-US',
  isPartOf: { '@type': 'WebSite', name: site.name, url: site.url },
  publisher: { '@type': 'Organization', name: site.name, url: site.url },
}];
---

<BaseLayout title="The Birth Time Toolkit" description={description} path="/birth-time-toolkit/" breadcrumbs={crumbs} schema={schema}>
  <Breadcrumbs crumbs={crumbs} />

  <section class="hero hero--split">
    <div class="container">
      <div>
        <p class="eyebrow">Free worksheet set</p>
        <h1>The Birth Time Toolkit</h1>
        <p class="lede">
          Knowing where to look is one thing. Working through records, family memories, and two
          times that do not agree is another. Start by finding out how much confidence the time you
          already have deserves.
        </p>
      </div>
      <img class="hero__img" src={scenes.newsletterLetters.src} srcset={scenes.newsletterLetters.srcset} sizes="100vw" alt={scenes.newsletterLetters.alt} width={scenes.newsletterLetters.width} height={scenes.newsletterLetters.height} fetchpriority="high" />
    </div>
  </section>

  <section class="section section--sea">
    <div class="container" style="max-width: 46rem;">
      <div class="prose flow" style="margin-bottom: var(--space-7);">
        <p class="eyebrow">Start here · about ninety seconds</p>
        <h2>How good is the time you have?</h2>
        <p>
          Three questions about where your birth time came from. This does not work out what your
          time is; it works out how much weight it can carry. You will get one of the toolkit's five
          confidence labels and a practical next step.
        </p>
        <p class="card__meta">Nothing is stored or sent. I do not ask for your birth date, birth time, or birthplace.</p>
      </div>
      <BirthTimeConfidence />
    </div>
  </section>

  <section class="section">
    <div class="container" style="max-width: 46rem;">
      <div class="prose flow">
        <p class="eyebrow">If you need to investigate</p>
        <h2>What's in the toolkit</h2>
        <p>Eight printable sections designed to be filled in while you work, not simply read and filed.</p>
      </div>
      <ul class="assurances" style="margin-top: var(--space-6);">
        <li><strong>What you already know</strong>: the time you were told, who told you, and how sure they were.</li>
        <li><strong>Record search checklist</strong>: offices and documents worth trying, with space to log the result.</li>
        <li><strong>Family interview sheets</strong>: prompts that get better answers than “what time was I born?”</li>
        <li><strong>When times disagree</strong>: a comparison table so you keep the evidence instead of guessing early.</li>
        <li><strong>A confidence scale</strong>: five plain labels from <em>documented</em> to <em>unknown</em>.</li>
        <li><strong>If it stays unknown</strong>: what a reading can and cannot do without an exact time.</li>
        <li><strong>Rectification</strong>: what the technique is and what it cannot promise.</li>
        <li><strong>A reading preparation sheet</strong>: a clean summary to bring to an astrologer.</li>
      </ul>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container feature-split">
      <div class="flow">
        <p class="eyebrow">Use it your way</p>
        <h2 id="get-the-toolkit">PDF, browser worksheets, or both</h2>
        <p>
          You can join my monthly note and receive the toolkit, download it directly without
          subscribing, or work through the worksheets in your browser. The information itself is
          not being held behind an email address.
        </p>
        <NewsletterForm source="birth-time-toolkit" labelledby="get-the-toolkit" />
        <p class="card__meta" style="margin-top: var(--space-4);">
          Rather not subscribe? <a href={pdfPath} data-toolkit-download download>Download the PDF directly</a>,
          or <a href="/birth-time-toolkit/worksheets/">use the browser worksheets</a>.
        </p>
      </div>
      <div class="flow">
        <div class="callout">
          <p style="margin: 0;"><strong>The information is free either way.</strong> The complete explanation is already on <a href="/birth-time/">How to Find Your Birth Time</a>. The toolkit gives you a working format for doing the search.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container grid grid--3">
      <article class="card"><h2 style="font-size: var(--text-lg); margin: 0;"><a href="/birth-time/">How to find your birth time</a></h2><p style="margin: 0;">The full guide, free and ungated.</p></article>
      <article class="card"><h2 style="font-size: var(--text-lg); margin: 0;"><a href="/prepare-for-your-reading/">Prepare for your reading</a></h2><p style="margin: 0;">Everything else worth bringing.</p></article>
      <article class="card"><h2 style="font-size: var(--text-lg); margin: 0;"><a href="/reading-finder/">Reading Finder</a></h2><p style="margin: 0;">Five questions to help narrow which reading may fit your question.</p></article>
    </div>
  </section>
</BaseLayout>

<script>
  document.querySelector('[data-toolkit-download]')?.addEventListener('click', () =>
    (window as any).mlTrack?.('toolkit_download', { toolkit: 'birth-time' })
  );
</script>
