---
import { getCollection } from 'astro:content';
import { scenes } from '../config/images';
import BaseLayout from '../layouts/BaseLayout.astro';
import FurtherReading from '../components/FurtherReading.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CTABand from '../components/CTABand.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import NextLunations from '../components/NextLunations.astro';

const allLunations = (await getCollection('skyEvents')).filter(
  (e) => e.data.eventType === 'lunation' || e.data.eventType === 'eclipse'
);
const now = new Date();
const recent = allLunations
  .filter((e) => e.data.start < now)
  .sort((a, b) => b.data.start.valueOf() - a.data.start.valueOf())
  .slice(0, 4);
const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const crumbs = [{ label: 'Horoscopes', href: '/horoscopes/' }];
---

<BaseLayout
  title="Horoscopes by rising sign: a lens on each lunation"
  description="Mo Lumen offers rising-sign guidance with new moons and eclipses: a whole-sign-house lens on where to look, without pretending to predict what will happen."
  path="/horoscopes/"
  breadcrumbs={crumbs}
>
  <Breadcrumbs crumbs={crumbs} />
  <section class="hero hero--split">
    <div class="container">
      <div>
        <p class="eyebrow">A rising-sign lens</p>
        <h1>Horoscopes</h1>
        <p class="lede">
          Use your rising sign to see which broad area of the chart a new moon or eclipse is moving
          through. I will give you somewhere useful to look and questions worth considering, without
          pretending a general horoscope knows what will happen to you.
        </p>
      </div>
      <img
        class="hero__img"
        src={scenes.currentSkyWide.src}
        srcset={scenes.currentSkyWide.srcset}
        sizes="100vw"
        alt={scenes.currentSkyWide.alt}
        width={scenes.currentSkyWide.width}
        height={scenes.currentSkyWide.height}
        fetchpriority="high"
      />
    </div>
  </section>

  <NextLunations />

  <section class="section section--sea">
    <div class="container">
      <div class="prose flow" style="margin-bottom: var(--space-6);">
        <p class="eyebrow">How to use these</p>
        <h2>Keep the lens broad on purpose.</h2>
      </div>
      <div class="grid grid--3">
        <article class="card">
          <h3>Read your rising sign first</h3>
          <p>Whole-sign houses use the rising sign to locate the lunation in one broad area of the chart.</p>
        </article>
        <article class="card">
          <h3>Treat the result as a place to look</h3>
          <p>The horoscope can suggest an area of attention. It cannot know whether this lunation is especially important in your natal chart.</p>
        </article>
        <article class="card">
          <h3>Leave room for the rest of the chart</h3>
          <p>Natal planets, exact aspects, other timing, and the circumstances you are already living can change how the symbolism becomes relevant.</p>
        </article>
      </div>
      <p style="margin-top: var(--space-6);">
        Don't know your rising sign? <a href="/birth-time/">Start with your birth time</a>. If you
        have a time but are unsure how reliable it is, use the
        <a href="/birth-time-toolkit/#confidence-check">Birth Time confidence check</a>.
      </p>
    </div>
  </section>

  {recent.length > 0 && (
    <section class="section">
      <div class="container">
        <p class="eyebrow">Look back</p>
        <h2>Recent lunation notes</h2>
        <div class="grid grid--2" style="margin-top: var(--space-6);">
          {recent.map((e) => (
            <article class="card">
              <p class="card__meta" style="margin: 0;">{fmt(e.data.start)}</p>
              <h3 style="margin: 0;">
                <a href={`/current-sky/events/${e.id.replace(/\.mdx?$/, '')}/`}>
                  {e.data.title}
                </a>
              </h3>
              <p style="margin: 0;">{e.data.summary}</p>
            </article>
          ))}
        </div>
        <p style="margin-top: var(--space-6);">
          Every past note lives in the <a href="/current-sky/archive/">Current Sky archive</a>.
        </p>
      </div>
    </section>
  )}

  <section class="section section--alt">
    <div class="container grid grid--2" style="align-items: start;">
      <div class="prose flow">
        <p class="eyebrow">What this is and is not</p>
        <h2>A horoscope is not a miniature personal reading.</h2>
        <p>
          It is useful precisely because its job is narrower. It locates a lunation by whole-sign
          house and offers a broad interpretive frame. A personal reading adds the rest of your
          chart, the timing around it, and the life you are actually living.
        </p>
        <FurtherReading />
      </div>
      <div class="card flow">
        <h2 id="horo-newsletter" style="font-size: var(--text-xl); margin: 0;">Keep looking with me</h2>
        <p style="margin: 0;">
          My monthly note includes <strong>The Sky This Month</strong> along with a question,
          observation, or connection I have been thinking about.
        </p>
        <NewsletterForm source="horoscopes" labelledby="horo-newsletter" />
      </div>
    </div>
  </section>

  <CTABand
    heading="Want to go beyond the rising-sign lens?"
    body="A personal reading adds the rest of your chart, the timing around you, and the life you are actually living. That is where broad symbolism can become individual synthesis."
    buttonLabel="Find Your Reading"
    buttonHref="/reading-finder/"
    secondaryLabel="Keep following Current Sky"
    secondaryHref="/current-sky/"
  />
</BaseLayout>
