---
import { getCollection } from 'astro:content';
import { photos, scenes } from '../config/images';
import BaseLayout from '../layouts/BaseLayout.astro';
import FurtherReading from '../components/FurtherReading.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CTABand from '../components/CTABand.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import NextLunations from '../components/NextLunations.astro';

/**
 * Split on today, not just sorted descending.
 *
 * This page used to take the six latest lunations by date and head them
 * "Recent lunation letters". Every one of them was in the future, so a visitor
 * in August read "recent" above a letter dated Christmas Eve. Publishing the
 * 2027 window turned that from odd into plainly wrong — the top entry became
 * December 2027, sixteen months out.
 *
 * Upcoming and past are genuinely different things to a reader: one is
 * something to prepare for, the other something to look back on. So they are
 * now two lists with honest headings, both filtered against today.
 */
const allLunations = (await getCollection('skyEvents')).filter(
  (e) => e.data.eventType === 'lunation' || e.data.eventType === 'eclipse'
);
const now = new Date();
const upcoming = allLunations
  .filter((e) => e.data.start >= now)
  .sort((a, b) => a.data.start.valueOf() - b.data.start.valueOf())
  .slice(0, 4);
const recent = allLunations
  .filter((e) => e.data.start < now)
  .sort((a, b) => b.data.start.valueOf() - a.data.start.valueOf())
  .slice(0, 4);
const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const crumbs = [{ label: 'Horoscopes', href: '/horoscopes/' }];
---

<BaseLayout
  title="Horoscopes — by rising sign, with each lunation"
  description="Mo Lumen writes rising-sign guidance with each new moon and eclipse — horoscopes that respect your agency. Read the latest lunation letters."
  path="/horoscopes/"
  breadcrumbs={crumbs}
>
  <Breadcrumbs crumbs={crumbs} />
  <section class="hero hero--split">
    <div class="container">
      <div>
      <p class="eyebrow">By rising sign</p>
      <h1>Horoscopes</h1>
      <p class="lede">
        With each new moon and eclipse I write guidance for all twelve rising signs — where the
        lunation lands in your chart and what that part of life tends to ask. Read by your
        <em>rising</em> sign for the best fit; your Sun sign works too, it just fits more loosely.
      </p>
      </div>
      <img
        class="hero__img"
        src={scenes.currentSkyWide.src}
        srcset={scenes.currentSkyWide.srcset}
        sizes="100vw"
        alt={scenes.currentSkyWide.alt}
        width={scenes.currentSkyWide.width}
        height={scenes.currentSkyWide.height}
        fetchpriority="high"
      />
    </div>
  </section>
  <section class="section">
    <div class="container">
      {
        upcoming.length > 0 && (
          <>
            <h2>Coming up</h2>
            <div class="grid grid--2" style="margin-top: var(--space-6);">
              {upcoming.map((e) => (
                <article class="card">
                  <p class="card__meta" style="margin: 0;">{fmt(e.data.start)}</p>
                  <h3 style="margin: 0;">
                    <a href={`/current-sky/events/${e.id.replace(/\.mdx?$/, '')}/`}>
                      {e.data.title}
                    </a>
                  </h3>
                  <p style="margin: 0;">{e.data.summary}</p>
                </article>
              ))}
            </div>
          </>
        )
      }
      {
        recent.length > 0 && (
          <>
            <h2 style="margin-top: var(--space-12);">Recent lunation letters</h2>
            <div class="grid grid--2" style="margin-top: var(--space-6);">
              {recent.map((e) => (
                <article class="card">
                  <p class="card__meta" style="margin: 0;">{fmt(e.data.start)}</p>
                  <h3 style="margin: 0;">
                    <a href={`/current-sky/events/${e.id.replace(/\.mdx?$/, '')}/`}>
                      {e.data.title}
                    </a>
                  </h3>
                  <p style="margin: 0;">{e.data.summary}</p>
                </article>
              ))}
            </div>
          </>
        )
      }
      <p style="margin-top: var(--space-6);">
        Every past letter lives in the <a href="/current-sky/archive/">Current Sky archive</a>.
      </p>
      <p>
        Don't know your rising sign? It comes from your exact birth time —
        <a href="/birth-time/">here's how to find it</a>, and if you have a time but aren't sure
        how much to trust it, <a href="/birth-time-toolkit/#confidence-check">three questions will
        tell you</a>.
      </p>
    </div>
  </section>

  <NextLunations />
  <section class="section section--alt">
    <div class="container" style="max-width: 42rem;">
      <h2 id="horo-newsletter">New lunation letters, by email</h2>
      <p>The Sky This Month delivers each letter as it's written.</p>
      <NewsletterForm source="horoscopes" labelledby="horo-newsletter" />
      <FurtherReading />
    </div>
  </section>
  <CTABand />
</BaseLayout>
