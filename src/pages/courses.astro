---
import BaseLayout from '../layouts/BaseLayout.astro';
import { scenes } from '../config/images';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
const crumbs = [{ label: 'Courses', href: '/courses/' }];
---

<BaseLayout
  title="Courses: not open yet"
  description="Mo Lumen does not have a course open for enrollment yet. Learn free through Start Here and Explore Astrology, or join the monthly note for future course news."
  path="/courses/"
  breadcrumbs={crumbs}
  noindex={true}
>
  <Breadcrumbs crumbs={crumbs} />
  <section class="hero hero--split">
    <div class="container">
      <div>
        <p class="eyebrow">Not open yet</p>
        <h1>Courses</h1>
        <p class="lede">
          I plan to teach structured courses here, but there is nothing open for enrollment right
          now. I would rather say that plainly than ask you to browse a course catalog that does not
          exist yet.
        </p>
      </div>
      <img
        class="hero__img"
        src={scenes.approachPhilosophy.src}
        srcset={scenes.approachPhilosophy.srcset}
        sizes="100vw"
        alt={scenes.approachPhilosophy.alt}
        width={scenes.approachPhilosophy.width}
        height={scenes.approachPhilosophy.height}
        fetchpriority="high"
      />
    </div>
  </section>

  <section class="section">
    <div class="container grid grid--2" style="align-items: start;">
      <div class="prose flow">
        <p class="eyebrow">Learn now</p>
        <h2>You do not need to wait for a course.</h2>
        <p>
          If you are new to astrology, <a href="/start-here/">Start Here</a> gives the material an
          order. If you already know the basics, <a href="/explore/">Explore Astrology</a> is the
          deeper reference library. Both are free and designed to show how the pieces relate rather
          than hand you isolated definitions.
        </p>
        <p><a class="btn btn--primary" href="/start-here/">Start learning</a></p>
      </div>
      <div class="card flow">
        <p class="eyebrow" style="margin: 0;">Future course news</p>
        <h2 id="course-interest" style="font-size: var(--text-xl); margin: 0;">Hear when something is actually ready</h2>
        <p style="margin: 0;">
          Course announcements will go to the monthly note when there is a real course, date, and
          enrollment path to share.
        </p>
        <NewsletterForm source="courses-interest" labelledby="course-interest" />
      </div>
    </div>
  </section>
</BaseLayout>
