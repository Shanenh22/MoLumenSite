---
import BaseLayout from '../layouts/BaseLayout.astro';
import { scenes } from '../config/images';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
const crumbs = [{ label: 'Courses', href: '/courses/' }];
---

<BaseLayout
  title="Courses: in development"
  description="Astrology courses from Mo Lumen are planned for the future. For now, learn free through Explore Astrology and join the monthly letter for course news when there is something concrete to share."
  path="/courses/"
  breadcrumbs={crumbs}
>
  <Breadcrumbs crumbs={crumbs} />
  <section class="hero hero--split">
    <div class="container">
      <div>
      <p class="eyebrow">In development</p>
      <h1>Courses</h1>
      <p class="lede">
        Teaching matters to me, and I do plan to bring more structured astrology education here.
        I am not publishing a course catalog before the courses exist. When something is ready, this
        page will tell you exactly what it teaches, who it is for, how it works, and what it costs.
      </p>
      </div>
      <img
        class="hero__img"
        src={scenes.approachPhilosophy.src}
        srcset={scenes.approachPhilosophy.srcset}
        sizes="100vw"
        alt={scenes.approachPhilosophy.alt}
        width={scenes.approachPhilosophy.width}
        height={scenes.approachPhilosophy.height}
        fetchpriority="high"
      />
    </div>
  </section>

  <section class="section">
    <div class="container grid grid--2" style="align-items: start;">
      <div class="prose flow">
        <h2>Learn with me now</h2>
        <p>
          If you are new to astrology, begin with <a href="/start-here/">Start Here</a>. It gives
          the material an order instead of asking you to learn a pile of disconnected definitions.
        </p>
        <p>
          If you already know your way around a chart, <a href="/explore/">Explore Astrology</a>
          is the deeper reference library. It separates the pieces, shows how they relate, and
          makes clear where general education ends and personal synthesis begins.
        </p>
        <p>
          That free material is also the best preview of how I teach: explain the structure, show
          the relationships, say where astrologers differ, and leave room for questions.
        </p>
      </div>
      <div class="card flow">
        <h2 id="course-interest" style="font-size: var(--text-xl); margin: 0;">Hear when something opens</h2>
        <p style="margin: 0;">
          Course news will go through the monthly letter when there is a real offering to announce.
          No countdowns and no pre-orders for something that is not ready.
        </p>
        <NewsletterForm source="courses-interest" labelledby="course-interest" />
      </div>
    </div>
  </section>
</BaseLayout>
