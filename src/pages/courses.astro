---
import BaseLayout from '../layouts/BaseLayout.astro';
import { scenes } from '../config/images';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
const crumbs = [{ label: 'Courses', href: '/courses/' }];
---

<BaseLayout
  title="Courses: coming later"
  description="Astrology courses from Mo Lumen, a teacher by profession before she was an astrologer, are in development. Join the interest list to hear first."
  path="/courses/"
  breadcrumbs={crumbs}
>
  <Breadcrumbs crumbs={crumbs} />
  <section class="hero hero--split">
    <div class="container">
      <div>
      <p class="eyebrow">In development</p>
      <h1>Courses</h1>
      <p class="lede">
        Before astrology I taught natural sciences from middle school to college, teaching was my
        first profession, not a sideline. I'm building courses that bring that classroom skill to
        the chart, carefully, and none goes on sale until it's genuinely ready.
      </p>
      </div>
      <img
        class="hero__img"
        src={scenes.approachPhilosophy.src}
        srcset={scenes.approachPhilosophy.srcset}
        sizes="100vw"
        alt={scenes.approachPhilosophy.alt}
        width={scenes.approachPhilosophy.width}
        height={scenes.approachPhilosophy.height}
        fetchpriority="high"
      />
    </div>
  </section>
  <section class="section">
    <div class="container grid grid--2" style="align-items: start;">
      <div class="prose flow">
        <h2>What's being considered</h2>
        <ul>
          <li>Recorded foundations: the birth chart from zero, at your own pace</li>
          <li>Live small-group classes, taught the way I read: conversationally</li>
          <li>Short topic intensives on timing, lunations, and horary basics</li>
        </ul>
        <p>
          No launch dates, no countdowns, no pre-orders, when something opens, the interest list
          hears first, with full details and prices.
        </p>
        <p>
          Meanwhile, my teaching style is on display for free across
          <a href="/explore/">Explore Astrology</a> and <a href="/videos/">the videos</a>.
        </p>
      </div>
      <div class="card flow">
        <h2 id="course-interest" style="font-size: var(--text-xl); margin: 0;">Interest list</h2>
        <p style="margin: 0;">
          Join the newsletter and you're on it. Course news arrives there first.
        </p>
        <NewsletterForm source="courses-interest" labelledby="course-interest" />
      </div>
    </div>
  </section>
</BaseLayout>
