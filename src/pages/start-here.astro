---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CTABand from '../components/CTABand.astro';
import { ocean } from '../config/images';
import Interlude from '../components/Interlude.astro';

const crumbs = [{ label: 'Start Here', href: '/start-here/' }];

const stages = [
  {
    eyebrow: 'Stage one',
    title: 'Learn the pieces',
    intro: 'Begin with the basic structure of a chart. You are learning vocabulary here, not memorizing a personality system.',
    steps: [
      ['/explore/birth-chart-basics/', 'What a birth chart actually is', 'The map itself, what it contains, and the difference between astronomical position and astrological interpretation.', '6 min'],
      ['/explore/the-big-three/', 'Sun, Moon, and rising', 'Three important placements, why they can feel recognizable, and why they are still only part of a person.', '7 min'],
      ['/tools/explore-your-chart/', 'See the basic layers together', 'Use the interactive teaching tool to connect planet, sign, and house before adding more technique.', '5 min'],
    ],
  },
  {
    eyebrow: 'Stage two',
    title: 'See how the pieces change one another',
    intro: 'Definitions become much more interesting when one part of the chart begins modifying, supporting, or complicating another.',
    steps: [
      ['/explore/planets/', 'Planets: what is operating?', 'Different functions and drives within the chart, each changed by sign, house, aspects, and context.', '10 min'],
      ['/explore/signs/', 'Signs: how does it express?', 'Twelve modes of expression and the elements and modalities that reveal relationships among them.', '10 min'],
      ['/explore/houses/', 'Houses: where does it show up?', 'Areas of experience that help locate where a planet or pattern may be most visible.', '10 min'],
      ['/explore/aspects/', 'Aspects: how do the parts relate?', 'Angular relationships among planets and one of the clearest reasons no placement stands alone.', '8 min'],
    ],
  },
  {
    eyebrow: 'Stage three',
    title: 'Add timing, context, and judgment',
    intro: 'Once the grammar is familiar, astrology becomes a practice of context: what is moving, what is being emphasized, and what the chart cannot decide for you.',
    steps: [
      ['/explore/transits/', 'Understanding transits', 'How the moving sky forms new relationships with a natal chart and adds a timing layer.', '7 min'],
      ['/explore/misconceptions/', 'What astrology can and cannot tell you', 'Certainty, prediction, sun signs, free will, and assumptions that deserve a closer look.', '9 min'],
    ],
  },
] as const;
---

<BaseLayout
  title="Start Here: learn astrology from the beginning"
  description="A guided path through astrology for beginners: learn the pieces of a birth chart, see how they interact, then add timing, context, and judgment."
  path="/start-here/"
  breadcrumbs={crumbs}
>
  <Breadcrumbs crumbs={crumbs} />

  <section class="hero hero--split">
    <div class="container">
      <div>
        <p class="eyebrow">For complete beginners</p>
        <h1>Start here</h1>
        <p class="lede">
          Astrology has a large vocabulary, but you do not need to learn it all at once. I would
          begin with the pieces, then look at the relationships among them, and only after that add
          timing and interpretation.
        </p>
      </div>
      <img
        class="hero__img"
        src={ocean.dawnWave.src}
        srcset={ocean.dawnWave.srcset}
        sizes="100vw"
        alt={ocean.dawnWave.alt}
        width={ocean.dawnWave.width}
        height={ocean.dawnWave.height}
        fetchpriority="high"
      />
    </div>
  </section>

  <section class="section">
    <div class="container grid grid--2" style="align-items: start;">
      <div class="prose flow">
        <p class="eyebrow">Before you begin</p>
        <h2>Curiosity is enough</h2>
        <p>
          You do not need to arrive already convinced of what astrology can do. Learn how
          astrologers use a chart, notice what makes sense to you, question what does not, and keep
          your own judgment intact.
        </p>
        <p>
          I also try to keep different kinds of claims distinct: astronomical fact, historical or
          traditional doctrine, contemporary practice, and my own interpretation are not all the
          same thing.
        </p>
      </div>
      <aside class="callout" style="margin: 0;">
        <p style="margin: 0;"><strong>No birth time needed to begin.</strong> Birth time becomes important when you want to calculate the angles and houses of a particular chart. If yours is uncertain, you can still learn the structure first.</p>
      </aside>
    </div>
  </section>

  <Interlude
    image={ocean.lightRays}
    eyebrow="No exam at the end"
    heading="Learn the grammar. Then keep asking what changes in context."
    body="A definition gives you a foothold. Synthesis is what turns separate definitions into an astrological reading."
  />

  <section class="section section--alt">
    <div class="container" style="max-width: 60rem;">
      <p class="eyebrow">Your learning path</p>
      <h2>Three stages, one question at a time</h2>
      <p class="lede">
        If you are brand new, go in order. If one stage already feels familiar, start where your
        curiosity is strongest.
      </p>

      <div class="learning-stages" style="margin-top: var(--space-8);">
        {stages.map((stage, stageIndex) => (
          <section class="learning-stage">
            <div class="learning-stage__heading">
              <p class="eyebrow">{stage.eyebrow}</p>
              <h3>{stage.title}</h3>
              <p>{stage.intro}</p>
            </div>
            <div class="grid grid--2">
              {stage.steps.map(([href, title, body, mins], stepIndex) => (
                <article class="card">
                  <p class="card__meta">Step {stages.slice(0, stageIndex).reduce((n, s) => n + s.steps.length, 0) + stepIndex + 1} · {mins}</p>
                  <h4 style="font-size: var(--text-lg); margin: 0;"><a href={href}>{title}</a></h4>
                  <p style="margin: 0;">{body}</p>
                </article>
              ))}
            </div>
            {stageIndex < stages.length - 1 && <hr />}
          </section>
        ))}
      </div>

      <p style="margin-top: var(--space-8);">
        <a class="btn btn--accent" href="/explore/birth-chart-basics/">Begin with the birth chart</a>
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container grid grid--3">
      <article class="card">
        <h2 style="font-size: var(--text-lg); margin: 0;"><a href="/current-sky/">Watch the ideas in motion</a></h2>
        <p style="margin: 0;">Current Sky is where I apply the language to shared planetary cycles without turning them into personal predictions.</p>
      </article>
      <article class="card">
        <h2 style="font-size: var(--text-lg); margin: 0;"><a href="/explore/">Browse by topic</a></h2>
        <p style="margin: 0;">Already know what you want to study? Explore Astrology organizes the full reference library by the question you are trying to answer.</p>
      </article>
      <article class="card">
        <h2 style="font-size: var(--text-lg); margin: 0;"><a href="/explore/questions-to-bring/">Bring it back to a real question</a></h2>
        <p style="margin: 0;">A chart becomes more useful when the technique has somewhere meaningful to go.</p>
      </article>
    </div>
  </section>

  <CTABand
    heading="Ready for step one?"
    body="Start with what a birth chart actually is. You can come back to this page whenever you want the larger path again."
    buttonLabel="What a Birth Chart Is"
    buttonHref="/explore/birth-chart-basics/"
    secondaryLabel="Browse Explore Astrology"
    secondaryHref="/explore/"
  />
</BaseLayout>

<style>
  .learning-stages {
    display: grid;
    gap: var(--space-8);
  }
  .learning-stage__heading {
    max-width: 46rem;
    margin-bottom: var(--space-6);
  }
</style>
