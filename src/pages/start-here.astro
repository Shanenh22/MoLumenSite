---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CTABand from '../components/CTABand.astro';
import Icon from '../components/Icon.astro';
import { ocean } from '../config/images';
import Interlude from '../components/Interlude.astro';

const crumbs = [{ label: 'Start Here', href: '/start-here/' }];

const path = [
  {
    href: '/explore/birth-chart-basics/',
    title: 'What a birth chart actually is',
    body: 'A map of the sky at your exact moment and place of birth — and the four vocabularies every chart is built from.',
    mins: '6 min',
  },
  {
    href: '/explore/the-big-three/',
    title: 'The big three: Sun, Moon, and rising',
    body: 'The three placements that do most of the introductions, and why sun-sign horoscopes only half fit.',
    mins: '7 min',
  },
  {
    href: '/explore/planets/',
    title: 'The planets: what is acting',
    body: 'Ten drives every chart contains. Start with the Sun, Moon, and Mercury; the rest will keep.',
    mins: '10 min',
  },
  {
    href: '/explore/signs/',
    title: 'The signs: how it acts',
    body: 'Twelve styles of expression — and the two grids (elements and modalities) that generate all of them.',
    mins: '10 min',
  },
  {
    href: '/explore/houses/',
    title: 'The houses: where it acts',
    body: 'Twelve arenas of life, from your body to your reputation. This is where a chart stops being abstract.',
    mins: '10 min',
  },
  {
    href: '/explore/aspects/',
    title: 'Aspects: how the parts relate',
    body: 'The angles between planets — which of your drives cooperate, which argue, and which are fused.',
    mins: '8 min',
  },
  {
    href: '/tools/explore-your-chart/',
    title: 'Put one placement together',
    body: 'Use the interactive chart explorer to build the sentence: planet in sign in house. No birth data needed.',
    mins: '5 min',
  },
  {
    href: '/explore/transits/',
    title: 'Understanding transits',
    body: 'How the moving sky activates a fixed chart — the difference between who you are and what season you are in.',
    mins: '7 min',
  },
  {
    href: '/explore/misconceptions/',
    title: 'What astrology can and cannot tell you',
    body: 'The honest limits, the common myths, and why a chart describes tendencies rather than verdicts.',
    mins: '9 min',
  },
];
---

<BaseLayout
  title="Start Here — learn astrology from the beginning"
  description="A guided nine-step path through astrology for complete beginners: birth charts, the big three, planets, signs, houses, aspects, transits, and honest limits. Free, in order, no jargon."
  path="/start-here/"
  breadcrumbs={crumbs}
>
  <Breadcrumbs crumbs={crumbs} />
  <section class="hero hero--split">
    <div class="container">
      <div>
        <p class="eyebrow">For complete beginners</p>
        <h1>Start here</h1>
        <p class="lede">
          Astrology is a language, and languages are learnable. This is the order I'd teach it in —
          nine steps, about an hour of reading in total, no prior knowledge assumed and no jargon
          left unexplained.
        </p>
      </div>
      <img
        class="hero__img"
        src={ocean.dawnWave.src}
        srcset={ocean.dawnWave.srcset}
        sizes="100vw"
        alt={ocean.dawnWave.alt}
        width={ocean.dawnWave.width}
        height={ocean.dawnWave.height}
        fetchpriority="high"
      />
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <h2>Before you begin</h2>
      <p>
        Three things worth knowing. First, you don't need to believe anything — plenty of people use
        a chart as a structured way to think about their own patterns, and skepticism makes a better
        student, not a worse one. Second, you don't need your birth time to start reading, though
        you'll want it eventually. Third, go in order the first time. Each step assumes the one
        before it.
      </p>
      <p>
        Every page on this site labels its sources: what's astronomy, what's traditional convention,
        what's modern practice, and what's my own synthesis. You should always know which kind of
        claim you're reading.
      </p>
    </div>
  </section>

  <Interlude
    image={ocean.lightRays}
    eyebrow="No exam at the end"
    heading="First time through, go in order."
    body="About an hour of reading in total, and each step assumes the one before it. After that, wander — the pages keep, so come back to whichever one stopped making sense."
  />

  <section class="section section--alt">
    <div class="container" style="max-width: 52rem;">
      <p class="eyebrow">The path</p>
      <h2>Nine steps</h2>
      <div style="margin-top: var(--space-6);">
        {
          path.map((step, i) => (
            <div class="path-step">
              <span class="path-step__num" aria-hidden="true">{i + 1}</span>
              <div>
                <h3><a href={step.href}>{step.title}</a></h3>
                <p>{step.body}</p>
                <p class="card__meta">{step.mins} read</p>
              </div>
            </div>
          ))
        }
      </div>
      <p style="margin-top: var(--space-8);">
        <a class="btn btn--accent" href={path[0].href}>Begin with step one</a>
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">When you're ready for more</p>
      <h2>Where to go next</h2>
      <div class="grid grid--3" style="margin-top: var(--space-6);">
        {
          [
            ['chart', 'Essential Dignities', '/explore/dignities/', 'The traditional measure of planetary strength — largely skipped by modern sites.'],
            ['compass', 'The Four Angles', '/explore/angles/', 'Ascendant, Descendant, Midheaven, IC — and why birth time matters to the minute.'],
            ['book', 'Schools & Traditions', '/explore/schools/', 'Hellenistic, medieval, modern, evolutionary, Vedic — and what to ask an astrologer.'],
            ['star', 'Chart Patterns', '/explore/chart-patterns/', 'Stelliums, grand trines, T-squares — the configurations that define a chart.'],
            ['moon', 'Current Sky', '/current-sky/', "What's moving overhead right now, with verified dates."],
            ['spark', 'Questions to Bring', '/explore/questions-to-bring/', 'How to shape a question that makes a reading genuinely useful.'],
          ].map(([icon, title, href, desc]) => (
            <article class="card" style="gap: var(--space-2);">
              <span style="color: var(--color-teal);">
                <Icon name={icon as any} size={26} />
              </span>
              <h3 style="font-size: var(--text-lg); margin: 0;">
                <a href={href}>{title}</a>
              </h3>
              <p style="margin: 0;">{desc}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <CTABand
    heading="Learning is one thing. Seeing your own chart is another."
    body="When the reading gets personal, that's what a session with Mo is for — and you'll get far more from it having read this."
    buttonLabel="See the readings"
    buttonHref="/readings/"
  />
</BaseLayout>
