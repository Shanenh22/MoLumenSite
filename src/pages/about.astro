---
import BaseLayout from '../layouts/BaseLayout.astro';
import { photos, scenes } from '../config/images';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CTABand from '../components/CTABand.astro';
import YouTubeFacade from '../components/YouTubeFacade.astro';
import { site } from '../config/site';
const crumbs = [{ label: 'About Mo', href: '/about/' }];
/**
 * About is the primary home for the welcome video, per the decision log: this
 * is the page where a visitor has already decided they want to know who Mo is,
 * so a minute of her talking answers exactly the question they arrived with.
 * The homepage links here rather than embedding a second copy — see the note
 * in index.astro.
 *
 * Everything below is inert while the ID is empty. Nothing renders, no schema
 * is emitted, and there is no placeholder to remove later.
 */
const welcomeId = site.integrations.welcomeVideoId;
const welcomePoster = site.integrations.welcomeVideoPoster;
const welcomeUploaded = site.integrations.welcomeVideoUploadDate;
/**
 * VideoObject only when a real uploadDate exists. Google requires it, and
 * inventing one would be a fabricated fact in the format most likely to be
 * taken at face value by a machine. The video itself renders on the ID alone.
 */
const videoSchema =
  welcomeId && welcomeUploaded
    ? [
        {
          '@context': 'https://schema.org',
          '@type': 'VideoObject',
          name: 'Meet Mo Lumen — a short introduction',
          description:
            'A short face-to-camera introduction from astrologer Maureen "Mo" Lumen, on how she works and what a reading with her is like.',
          uploadDate: welcomeUploaded,
          embedUrl: `https://www.youtube-nocookie.com/embed/${welcomeId}`,
          contentUrl: `https://www.youtube.com/watch?v=${welcomeId}`,
          ...(welcomePoster
            ? { thumbnailUrl: new URL(welcomePoster, site.url).href }
            : {}),
          publisher: { '@type': 'Organization', name: site.name, url: site.url },
        },
      ]
    : [];
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: 'Maureen "Mo" Lumen',
    jobTitle: 'Astrologer',
    url: `${site.url}/about/`,
    worksFor: { '@type': 'ProfessionalService', name: site.name, url: site.url },
    memberOf: [
      { '@type': 'Organization', name: 'National Council for Geocosmic Research (NCGR)' },
      { '@type': 'Organization', name: 'Organization for Professional Astrologers (OPA)' },
      { '@type': 'Organization', name: 'International Society for Astrological Research (ISAR)' },
    ],
  },
];
---

<BaseLayout
  title="About Mo — astrologer, teacher, writer"
  description="Meet Maureen 'Mo' Lumen: a modern-day astrologer with a classical lens. Certified in horary astrology, NCGR-PAA examined, OPA board member — and a former science teacher who believes there is fate and there is choice."
  path="/about/"
  breadcrumbs={crumbs}
  schema={[...schema, ...videoSchema]}
>
  <Breadcrumbs crumbs={crumbs} />
  <section class="hero hero--split">
    <div class="container">
      <div>
      <p class="eyebrow">About</p>
      <h1>Hello! I'm Maureen … a.k.a. Mo</h1>
      <p class="lede">Astrologer. Teacher. Writer. I am your interpreter of the language of the planets.</p>
      </div>
      <img
        class="hero__img"
        src={scenes.readingProcess.src}
        srcset={scenes.readingProcess.srcset}
        sizes="100vw"
        alt={scenes.readingProcess.alt}
        width={scenes.readingProcess.width}
        height={scenes.readingProcess.height}
        fetchpriority="high"
      />
    </div>
  </section>

  {
    welcomeId && (
      <section class="section">
        <div class="container" style="max-width: 46rem;">
          <p class="eyebrow">A minute with Mo</p>
          <h2>Before you decide, hear how I actually talk</h2>
          <p class="lede">
            A reading is an hour of conversation with a specific person. This is what that
            person sounds like.
          </p>
          <div style="margin-top: var(--space-6);">
            <YouTubeFacade
              videoId={welcomeId}
              title="Meet Mo Lumen — a short introduction"
              poster={welcomePoster || undefined}
              context="about-welcome"
            />
          </div>
        </div>
      </section>
    )
  }

  <section class="section">
    <div class="container grid grid--2" style="align-items: start;">
      <figure class="portrait-card">
        <img
          src={photos.moAbout.src}
          alt={photos.moAbout.alt}
          width={photos.moAbout.width}
          height={photos.moAbout.height}
          loading="lazy"
        />
        <figcaption>Maureen &ldquo;Mo&rdquo; Lumen — astrologer, teacher, writer</figcaption>
      </figure>
      <div class="prose flow">
        <p>
          Life is a many-faceted journey, and the ancient wisdom of astrology shines light on our
          paths. I believe your resonance with the heavens influences your choices about
          everything — where you live, what you do, who you keep close, and what moves you. My work
          is to help you see those patterns clearly, so you can actively choose what suits you
          best.
        </p>
        <p>
          I came to astrology the long way, and I wouldn't trade the route. I've run businesses. I
          taught natural sciences from middle school through college, which is why my readings
          sound more like a good class than a mystical performance — I like things explained
          properly. I've weathered real losses and done real healing, and along the way picked up
          practices from tarot to reiki, plus a lifelong habit of making things with my hands:
          painting, jewelry, glass.
        </p>
        <p>
          All of it comes with me into the reading room. Clients tell me I'm a great listener and
          deeply intuitive; I'd add that I'm practical to a fault. Astrology, as I practice it, is
          a modern conversation through a classical lens — traditional technique, present-tense
          life.
        </p>
        <blockquote>Knowledge brings insight. Insight brings power. Power brings freedom.</blockquote>
        <p>
          That's the heart of it. There is fate and there is choice — and a good reading helps you
          tell the difference.
        </p>
        <h2>Can't live without</h2>
        <ul>
          <li><strong>Family</strong> — birth family, chosen family, and the family we create.</li>
          <li><strong>Nature</strong> — especially the ocean, where I'm most at peace and most alive.</li>
          <li><strong>Learning</strong> — something new, every single day.</li>
          <li><strong>Travel</strong> — other cultures are other ways of seeing.</li>
        </ul>
      </div>
      <aside class="flow">
        <div class="card">
          <h2 style="font-size: var(--text-lg); margin: 0;">Training & credentials</h2>
          <ul style="margin: 0; padding-left: 1.1em;">
            <li>Practitioner's Certificate in Horary Astrology — School of Traditional Astrology (STA)</li>
            <li>NCGR-PAA Level 1 and Level 2 certification exams passed; Level 3 in progress</li>
            <li>
              Board member &amp; treasurer,
              <a href="https://opaastrology.org/about-opa/meet-the-board/" rel="noopener" target="_blank"
                >Organization for Professional Astrologers (OPA)</a
              >
            </li>
            <li>Treasurer, NCGR-DFW chapter</li>
            <li>
              Member:
              <a href="https://ncgrastrology.org/" rel="noopener" target="_blank">NCGR</a>,
              <a href="https://opaastrology.org/" rel="noopener" target="_blank">OPA</a>, and
              <a href="https://www.isarastrology.com/" rel="noopener" target="_blank">ISAR</a>
            </li>
          </ul>
          <p style="margin: 0;"><a href="/credentials/">More on training & ethics →</a></p>
        </div>
        <div class="card">
          <h2 style="font-size: var(--text-lg); margin: 0;">My approach</h2>
          <p style="margin: 0;">
            Practical and inspiring. Candid and compassionate. Intuitive and skillful. Read about
            <a href="/approach/">how I work and what I believe astrology is for</a>.
          </p>
        </div>
      </aside>
    </div>
  </section>

  {/*
    The body text named the Reading Finder and did not link it, on the page
    where a visitor has just finished deciding whether they like Mo — the
    strongest consideration-stage moment on the site. The band now carries the
    finder as a real second action, so the sentence and the page agree.
  */}
  <CTABand
    heading="Ready to work together?"
    body="Choose a reading, or start with the Reading Finder — I'll meet you and your chart there."
    secondaryLabel="Start with the Reading Finder"
  />
</BaseLayout>
