---
import BaseLayout from '../layouts/BaseLayout.astro';
import { photos, scenes } from '../config/images';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CTABand from '../components/CTABand.astro';
import YouTubeFacade from '../components/YouTubeFacade.astro';
import { site } from '../config/site';
const crumbs = [{ label: 'About Mo', href: '/about/' }];
/**
 * About is the primary home for the welcome video, per the decision log: this
 * is the page where a visitor has already decided they want to know who Mo is,
 * so a minute of her talking answers exactly the question they arrived with.
 * The homepage links here rather than embedding a second copy — see the note
 * in index.astro.
 *
 * Everything below is inert while the ID is empty. Nothing renders, no schema
 * is emitted, and there is no placeholder to remove later.
 */
const welcomeId = site.integrations.welcomeVideoId;
const welcomePoster = site.integrations.welcomeVideoPoster;
const welcomeUploaded = site.integrations.welcomeVideoUploadDate;
/**
 * VideoObject only when a real uploadDate exists. Google requires it, and
 * inventing one would be a fabricated fact in the format most likely to be
 * taken at face value by a machine. The video itself renders on the ID alone.
 */
const videoSchema =
  welcomeId && welcomeUploaded
    ? [
        {
          '@context': 'https://schema.org',
          '@type': 'VideoObject',
          name: 'Meet Mo Lumen: a short introduction',
          description:
            'A short face-to-camera introduction from astrologer Maureen "Mo" Lumen, on how she works and what a reading with her is like.',
          uploadDate: welcomeUploaded,
          embedUrl: `https://www.youtube-nocookie.com/embed/${welcomeId}`,
          contentUrl: `https://www.youtube.com/watch?v=${welcomeId}`,
          ...(welcomePoster
            ? { thumbnailUrl: new URL(welcomePoster, site.url).href }
            : {}),
          publisher: { '@type': 'Organization', name: site.name, url: site.url },
        },
      ]
    : [];
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: 'Maureen "Mo" Lumen',
    jobTitle: 'Astrologer',
    url: `${site.url}/about/`,
    worksFor: { '@type': 'ProfessionalService', name: site.name, url: site.url },
    memberOf: [
      { '@type': 'Organization', name: 'National Council for Geocosmic Research (NCGR)' },
      { '@type': 'Organization', name: 'Organization for Professional Astrologers (OPA)' },
      { '@type': 'Organization', name: 'International Society for Astrological Research (ISAR)' },
    ],
  },
];
---

<BaseLayout
  title="About Mo: astrologer, teacher, writer"
  description="Meet Maureen 'Mo' Lumen: astrologer, teacher, writer, and lifelong observer of patterns, cycles, and the ways the pieces of a life fit together."
  path="/about/"
  breadcrumbs={crumbs}
  schema={[...schema, ...videoSchema]}
>
  <Breadcrumbs crumbs={crumbs} />
  <section class="hero hero--split">
    <div class="container">
      <div>
      <p class="eyebrow">About</p>
      <h1>Hello! I'm Maureen … a.k.a. Mo</h1>
      <p class="lede">Astrologer. Teacher. Writer. Interpreter of the language of the planets, and a lifelong student of patterns, cycles, and people.</p>
      </div>
      <img
        class="hero__img"
        src={scenes.readingProcess.src}
        srcset={scenes.readingProcess.srcset}
        sizes="100vw"
        alt={scenes.readingProcess.alt}
        width={scenes.readingProcess.width}
        height={scenes.readingProcess.height}
        fetchpriority="high"
      />
    </div>
  </section>

  {
    welcomeId && (
      <section class="section">
        <div class="container" style="max-width: 46rem;">
          <p class="eyebrow">A minute with Mo</p>
          <h2>Before you decide, hear how I actually talk</h2>
          <p class="lede">
            A reading is a conversation with a real person, not a performance. Here is a minute
            with me before we ever sit down together.
          </p>
          <div style="margin-top: var(--space-6);">
            <YouTubeFacade
              videoId={welcomeId}
              title="Meet Mo Lumen: a short introduction"
              poster={welcomePoster || undefined}
              context="about-welcome"
            />
          </div>
        </div>
      </section>
    )
  }

  <section class="section">
    <div class="container grid grid--2" style="align-items: start;">
      <figure class="portrait-card">
        <img
          src={photos.moAbout.src}
          alt={photos.moAbout.alt}
          width={photos.moAbout.width}
          height={photos.moAbout.height}
          loading="lazy"
        />
        <figcaption>Maureen &ldquo;Mo&rdquo; Lumen: astrologer, teacher, writer</figcaption>
      </figure>
      <div class="prose flow">
        <p>
          I have always been fascinated by the way things fit together. As a science teacher, I
          loved the point where separate facts stopped being separate: a cycle connected to
          another cycle, one system affected another, and suddenly you could see the larger
          pattern. The closer I looked at living systems, the more extraordinary they became.
          Astrology keeps me in that same state of curiosity.
        </p>
        <p>
          That does not mean I use science as proof of astrology. I don't. Science is part of how
          I learned to observe carefully, ask better questions, explain complicated ideas, and
          respect how much complexity can live inside one system. Those habits come with me when I
          look at a chart.
        </p>
        <p>
          I came to astrology after running businesses and teaching natural sciences from middle
          school through college, and I have studied widely since then. My training includes
          horary and traditional techniques as well as modern and other contemporary approaches.
          I am less interested in asking every chart to fit one school of astrology than in
          understanding what the chart in front of me is actually saying as a whole.
        </p>
        <p>
          That whole matters because no two people live the same symbols in exactly the same way.
          I may see several ways a pattern could be expressing itself; the person living the chart
          brings the part I cannot know from technique alone. A good reading grows through that
          meeting of chart, experience, questions, and conversation.
        </p>
        <blockquote>There is fate and there is choice, and a good reading helps you tell the difference.</blockquote>
        <p>
          I want you to understand what I'm seeing and why I'm seeing it. I will tell you what I
          notice, ask when I need to understand how something is showing up in your life, and leave
          the decisions where they belong: with you.
        </p>
        <h2>What matters to me</h2>
        <ul>
          <li><strong>My family</strong>: my husband and children are at the center of my life.</li>
          <li><strong>Connection</strong>: I also value the people outside family who become part of your tribe.</li>
          <li><strong>Nature</strong>: especially the ocean, where I feel both grounded and full of wonder.</li>
          <li><strong>Learning</strong>: there is always another question worth following.</li>
          <li><strong>Travel</strong>: other cultures offer other ways of seeing.</li>
        </ul>
      </div>
      <aside class="flow">
        <div class="card">
          <h2 style="font-size: var(--text-lg); margin: 0;">Training & credentials</h2>
          <ul style="margin: 0; padding-left: 1.1em;">
            <li>Practitioner's Certificate in Horary Astrology, School of Traditional Astrology (STA)</li>
            <li>NCGR-PAA Level 1 and Level 2 certification exams passed; Level 3 in progress</li>
            <li>
              Board member &amp; treasurer,
              <a href="https://opaastrology.org/about-opa/meet-the-board/" rel="noopener" target="_blank"
                >Organization for Professional Astrologers (OPA)</a
              >
            </li>
            <li>Treasurer, NCGR-DFW chapter</li>
            <li>
              Member:
              <a href="https://ncgrastrology.org/" rel="noopener" target="_blank">NCGR</a>,
              <a href="https://opaastrology.org/" rel="noopener" target="_blank">OPA</a>, and
              <a href="https://www.isarastrology.com/" rel="noopener" target="_blank">ISAR</a>
            </li>
          </ul>
          <p style="margin: 0;"><a href="/credentials/">More on training & ethics →</a></p>
        </div>
        <div class="card">
          <h2 style="font-size: var(--text-lg); margin: 0;">My approach</h2>
          <p style="margin: 0;">
            Technically grounded, intuitive, curious, and conversational. Read about
            <a href="/approach/">how I put the pieces together and what I believe astrology is for</a>.
          </p>
        </div>
      </aside>
    </div>
  </section>

  <CTABand
    heading="Ready to work together?"
    body="Choose a reading, or start with the Reading Finder. Bring what is actually on your mind, and we'll look at the chart together."
    secondaryLabel="Start with the Reading Finder"
  />
</BaseLayout>
