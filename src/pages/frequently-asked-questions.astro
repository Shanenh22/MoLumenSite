---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { ocean } from '../config/images';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CTABand from '../components/CTABand.astro';

const faqs = (await getCollection('faqs'))
  .filter((f) => f.data.scope === 'global')
  .sort((a, b) => a.data.order - b.data.order);

const groups = [
  {
    title: 'Before you book',
    intro: 'The questions that usually decide whether a reading feels like the right next step.',
    match: (q: string) => /which reading|online readings|what actually happens/i.test(q),
  },
  {
    title: 'Your chart & birth time',
    intro: 'What accuracy matters, what happens when the time is uncertain, and what remains usable.',
    match: (q: string) => /birth time/i.test(q),
  },
  {
    title: 'During & after the reading',
    intro: 'Preparation, recording, and what the session asks from you.',
    match: (q: string) => /prepare|recorded/i.test(q),
  },
  {
    title: 'Prediction, belief & limits',
    intro: 'Where I draw the line between useful astrological perspective and claims astrology should not make.',
    match: (q: string) => /predict|therapy|faith|belief/i.test(q),
  },
];
const grouped = groups.map((g) => ({ ...g, items: faqs.filter((f) => g.match(f.data.question)) }));
const crumbs = [{ label: 'FAQs', href: '/frequently-asked-questions/' }];
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.data.question,
      acceptedAnswer: { '@type': 'Answer', text: f.data.answer },
    })),
  },
];
---

<BaseLayout
  title="Frequently Asked Questions"
  description="Honest answers about astrology readings with Mo Lumen: what happens in a session, birth times, accuracy, preparation, recordings, and what astrology can and cannot do."
  path="/frequently-asked-questions/"
  breadcrumbs={crumbs}
  schema={schema}
>
  <Breadcrumbs crumbs={crumbs} />
  <section class="hero hero--split">
    <div class="container">
      <div>
        <p class="eyebrow">Good questions</p>
        <h1>Frequently asked questions</h1>
        <p class="lede">
          Start with the question that is actually in your way. You do not need to read these in
          order, and you do not need to know astrology to understand the answers.
        </p>
      </div>
      <img
        class="hero__img"
        src={ocean.lightRays.src}
        srcset={ocean.lightRays.srcset}
        sizes="100vw"
        alt={ocean.lightRays.alt}
        width={ocean.lightRays.width}
        height={ocean.lightRays.height}
        fetchpriority="high"
      />
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <p class="eyebrow">Most useful first</p>
      <h2>Three questions that stop people most often</h2>
      <div class="grid grid--3" style="margin-top: var(--space-6);">
        {faqs.filter((f) => ['Which reading should I start with?', "What if I don't know my birth time?", 'Can astrology predict my future?'].includes(f.data.question)).map((f) => (
          <article class="card">
            <h3>{f.data.question}</h3>
            <p>{f.data.answer}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      {grouped.map((g) => (
        <section style="margin-bottom: var(--space-10);">
          <h2>{g.title}</h2>
          <p class="card__meta">{g.intro}</p>
          {g.items.map((f) => (
            <details class="faq">
              <summary>{f.data.question}</summary>
              <div class="faq__body"><p>{f.data.answer}</p></div>
            </details>
          ))}
        </section>
      ))}
      <p>
        Didn't find your question? <a href="/contact/">Ask me directly</a>. I read every message myself.
      </p>
    </div>
  </section>

  <CTABand
    heading="Still deciding whether a reading fits?"
    body="Tell me what is bringing you here and the Reading Finder will point you toward the most likely fit and explain why."
    buttonLabel="Try the Reading Finder"
    buttonHref="/reading-finder/"
    secondaryLabel="See what a reading is actually like"
    secondaryHref="/how-readings-work/"
  />
</BaseLayout>

<style>
  /* Use an in-row disclosure marker instead of the browser's outside marker.
     Safari can place the native marker beyond the prose container on narrow
     screens, which clips the triangle at the viewport edge. */
  details.faq summary {
    position: relative;
    list-style: none;
    padding-inline-start: calc(var(--space-2) + 1.25rem);
  }

  details.faq summary::-webkit-details-marker {
    display: none;
  }

  details.faq summary::before {
    content: '';
    position: absolute;
    inset-inline-start: var(--space-2);
    top: 50%;
    width: 0;
    height: 0;
    border-block-start: 0.32rem solid transparent;
    border-block-end: 0.32rem solid transparent;
    border-inline-start: 0.46rem solid currentColor;
    transform: translateY(-50%);
    transform-origin: 35% 50%;
    transition: transform var(--duration-fast) var(--ease);
  }

  details.faq[open] summary::before {
    transform: translateY(-50%) rotate(90deg);
  }
</style>
