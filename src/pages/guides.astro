---
import BaseLayout from '../layouts/BaseLayout.astro';
import { scenes } from '../config/images';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
const crumbs = [{ label: 'Guides', href: '/guides/' }];
---

<BaseLayout
  title="Guides"
  description="Practical astrology guides from Mo Lumen, beginning with the Birth Time Toolkit: where to look, what to ask, and what an uncertain birth time changes."
  path="/guides/"
  breadcrumbs={crumbs}
>
  <Breadcrumbs crumbs={crumbs} />
  <section class="hero hero--split">
    <div class="container">
      <div>
      <p class="eyebrow">Free to use</p>
      <h1>Guides</h1>
      <p class="lede">
        Longer than a glossary entry, more practical than an essay. Each guide is built around a
        task you may actually need to work through.
      </p>
      </div>
      <img
        class="hero__img"
        src={scenes.newsletterLetters.src}
        srcset={scenes.newsletterLetters.srcset}
        sizes="100vw"
        alt={scenes.newsletterLetters.alt}
        width={scenes.newsletterLetters.width}
        height={scenes.newsletterLetters.height}
        fetchpriority="high"
      />
    </div>
  </section>

  <section class="section">
    <div class="container grid grid--2" style="align-items: start;">
      <div class="prose flow">
        <h2>Available now</h2>
        <p>
          <strong><a href="/birth-time-toolkit/">The Birth Time Toolkit</a></strong> walks through
          where a birth time may be recorded, better questions to ask family, how to think about
          confidence in the time you find, and what changes when the exact time remains unknown.
          It is free to read on the site.
        </p>
        <p>
          If you are just beginning to learn astrology rather than solving a specific problem,
          <a href="/start-here/">Start Here</a> is the more useful path. If you already know the
          concept you want, use <a href="/explore/">Explore Astrology</a> as the reference library.
        </p>
      </div>
      <div class="card flow">
        <h2 id="guide-interest" style="font-size: var(--text-xl); margin: 0;">Future guides</h2>
        <p style="margin: 0;">
          When I publish another guide, I will mention it in the monthly letter. I do not want to
          promise topics or dates before the material is ready.
        </p>
        <NewsletterForm source="guides-interest" labelledby="guide-interest" />
      </div>
    </div>
  </section>
</BaseLayout>
