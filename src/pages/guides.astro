---
import BaseLayout from '../layouts/BaseLayout.astro';
import { scenes } from '../config/images';
import Breadcrumbs from '../components/Breadcrumbs.astro';
const crumbs = [{ label: 'Guides', href: '/guides/' }];
---

<BaseLayout
  title="Guides"
  description="The practical astrology guides now live with Mo Lumen's Resources. Start with the Birth Time guide or toolkit, or browse all free resources by what you want to do."
  path="/guides/"
  breadcrumbs={crumbs}
  noindex={true}
>
  <Breadcrumbs crumbs={crumbs} />
  <section class="hero hero--split">
    <div class="container">
      <div>
        <p class="eyebrow">A simpler path</p>
        <h1>Practical guides</h1>
        <p class="lede">
          This section is not large enough to need its own library yet. The useful material is still
          here; I have simply put it closer to the problem it helps you solve.
        </p>
      </div>
      <img
        class="hero__img"
        src={scenes.newsletterLetters.src}
        srcset={scenes.newsletterLetters.srcset}
        sizes="100vw"
        alt={scenes.newsletterLetters.alt}
        width={scenes.newsletterLetters.width}
        height={scenes.newsletterLetters.height}
        fetchpriority="high"
      />
    </div>
  </section>

  <section class="section">
    <div class="container grid grid--3">
      <article class="card">
        <p class="eyebrow" style="margin: 0;">Read</p>
        <h2 style="font-size: var(--text-xl); margin: 0;"><a href="/birth-time/">How to Find Your Birth Time</a></h2>
        <p style="margin: 0;">Where to look, what to ask, how much precision matters, and what remains usable if the time stays uncertain.</p>
      </article>
      <article class="card">
        <p class="eyebrow" style="margin: 0;">Work through it</p>
        <h2 style="font-size: var(--text-xl); margin: 0;"><a href="/birth-time-toolkit/">The Birth Time Toolkit</a></h2>
        <p style="margin: 0;">A confidence check, record-search process, family prompts, and worksheets you can use while investigating.</p>
      </article>
      <article class="card">
        <p class="eyebrow" style="margin: 0;">Browse by need</p>
        <h2 style="font-size: var(--text-xl); margin: 0;"><a href="/resources/">All Resources</a></h2>
        <p style="margin: 0;">Learning, Current Sky, Mo's writing, practical tools, and the path toward a personal reading.</p>
      </article>
    </div>
  </section>
</BaseLayout>
