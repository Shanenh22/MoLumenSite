---
import BaseLayout from '../layouts/BaseLayout.astro';
import FurtherReading from '../components/FurtherReading.astro';
import SeaBreak from '../components/SeaBreak.astro';
import { celestial, ocean, photos, scenes } from '../config/images';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CTABand from '../components/CTABand.astro';
const crumbs = [{ label: 'Prepare for Your Reading', href: '/prepare-for-your-reading/' }];
---

<BaseLayout
  title="Prepare for Your Reading"
  description="How to get the most from your astrology reading: finding your exact birth time, choosing good questions, and what to do when birth information is missing."
  path="/prepare-for-your-reading/"
  breadcrumbs={crumbs}
>
  <Breadcrumbs crumbs={crumbs} />
  <section class="hero hero--split">
    <div class="container">
      <div>
      <p class="eyebrow">Get the most from your hour</p>
      <h1>Prepare for your reading</h1>
      <p class="lede">
        Ten minutes of preparation makes a reading noticeably richer. Here's exactly what helps.
      </p>
      </div>
      <img
        class="hero__img"
        src={scenes.prepareReading.src}
        srcset={scenes.prepareReading.srcset}
        sizes="100vw"
        alt={scenes.prepareReading.alt}
        width={scenes.prepareReading.width}
        height={scenes.prepareReading.height}
        fetchpriority="high"
      />
    </div>
  </section>

  <section class="section">
    <div class="container prose flow">
      <h2>1. Confirm your birth time</h2>
      <p>
        The single most valuable thing you can do. Your rising sign changes roughly every two
        hours, and it anchors the whole chart. In order of reliability:
      </p>
      <ul>
        <li><strong>Birth certificate</strong> — in the US, request the "long form" from the vital records office of your birth state; hospital-recorded times usually appear there.</li>
        <li><strong>Baby book or hospital records</strong> — often accurate to the minute.</li>
        <li><strong>Family memory</strong> — useful but treat as approximate; "around dinnertime" is a real clue, not a time.</li>
      </ul>
      <p>
        If it isn't in the obvious place, the <a href="/birth-time/">birth time guide</a>
        walks the whole search in order — including better questions to ask the people who might
        remember, and what to send me when all you have is a range.
      </p>
      <h2>2. If your birth time is unknown</h2>
      <p>
        Don't let that stop you — tell me when you book. An unknown time limits some techniques
        (the rising sign and houses depend on it), but much of the chart doesn't, and we can
        shape the reading around what's solid.
      </p>
    </div>
  </section>

  <SeaBreak image={celestial.clearedTable} />

  <section class="section section--sea">
    <div class="container prose flow">
      <h2>3. Bring real questions</h2>
      <p>
        Two or three genuine questions beat ten vague ones. The best questions are the ones you
        actually lie awake with: "Why does every job start well and sour in year two?" works
        better than "Tell me about my career." Specific, honest, and yours.
      </p>
      <h2>4. Set up your space</h2>
      <p>
        A quiet room, decent headphones, water, maybe a notebook — though the recording means you
        don't need to write everything down. If you can, leave a little unhurried time afterward;
        readings tend to keep unfolding for an hour or two after we say goodbye.
      </p>
      <h2>5. Come as you are</h2>
      <p>
        You don't need to believe anything, prepare answers, or perform. Skepticism is welcome —
        bring it along with your curiosity. This is your hour, and your chart has been waiting
        your whole life for this conversation.
      </p>
      <FurtherReading />
    </div>
  </section>

  <CTABand heading="Prepared enough — shall we?" />
</BaseLayout>
