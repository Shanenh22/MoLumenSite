---
import { getCollection } from 'astro:content';
import { scenes } from '../config/images';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { site } from '../config/site';
import BookingEmbed from '../components/BookingEmbed.astro';
import { DEFAULT_BOOKING_EVENT, orderServices } from '../config/booking.ts';

const services = orderServices(
  (await getCollection('services')).filter((s) => s.data.available),
  (s) => s.data.slug
);
const calUser = site.integrations.calcomUsername;
const crumbs = [{ label: 'Book a Reading', href: '/book/' }];
const bookables = services.flatMap((s) =>
  s.data.options.length > 1
    ? s.data.options.map((o) => ({
        key: o.bookingEventId || s.data.bookingEventId,
        service: s.data.slug,
        name: `${s.data.shortName}: ${o.label}`,
        duration: o.durationLabel,
        price: s.data.priceConfirmed ? `$${o.price}` : null,
        event: o.bookingEventId || s.data.bookingEventId,
        audience: s.data.audience,
        note: o.note ?? '',
      }))
    : [
        {
          key: s.data.slug,
          service: s.data.slug,
          name: s.data.name,
          duration: s.data.durationLabel,
          price:
            s.data.priceConfirmed && s.data.price
              ? (s.data.priceLabel ?? `$${s.data.price}`)
              : null,
          event: s.data.bookingEventId,
          audience: s.data.audience,
          note: '',
        },
      ]
);
const serviceData = Object.fromEntries(bookables.map((b) => [b.key, b]));

if (!serviceData[DEFAULT_BOOKING_EVENT]) {
  throw new Error(
    `DEFAULT_BOOKING_EVENT "${DEFAULT_BOOKING_EVENT}" is not a bookable event. ` +
      `Available: ${Object.keys(serviceData).join(', ')}. ` +
      `Fix src/config/booking.ts or the services collection.`
  );
}

const serviceToEvent = Object.fromEntries(
  services.map((sv) => {
    const first = bookables.find((b) => b.service === sv.data.slug);
    return [sv.data.slug, first?.key ?? sv.data.bookingEventId];
  })
);

const firstReadings = bookables.filter((b) => b.audience !== 'established');
const returningReadings = bookables.filter((b) => b.audience === 'established');
const groups = [
  {
    legend: 'Your first reading with Mo',
    note: 'Open to everyone. Start here if you have not had a reading before.',
    items: firstReadings,
  },
  {
    legend: 'Returning client?',
    note: 'Already had your natal reading with Mo? Choose a follow-up reading.',
    items: returningReadings,
  },
].filter((g) => g.items.length > 0);
---

<BaseLayout
  title="Book a Reading"
  description="Choose your reading, pick a time in your own time zone, and pay securely online. Booking with Mo Lumen Astrology takes about two minutes."
  path="/book/"
  breadcrumbs={crumbs}
>
  <Breadcrumbs crumbs={crumbs} />
  <section class="hero hero--split">
    <div class="container">
      <div>
        <p class="eyebrow">Let's meet</p>
        <h1>Book a reading</h1>
        <p class="lede">
          You're at the practical part now. Choose the reading that fits your question, then pick a
          time. Times display in your own time zone, payment is secure, and you'll receive
          confirmation, preparation notes, and a reminder by email.
        </p>
        <p class="card__meta">
          Still deciding? <a href="/reading-finder/">The Reading Finder</a> can help, and
          <a href="/how-readings-work/">How Readings Work</a> explains what happens before, during,
          and after a session.
        </p>
      </div>
      <img
        class="hero__img"
        src={scenes.chartDetail.src}
        srcset={scenes.chartDetail.srcset}
        sizes="100vw"
        alt={scenes.chartDetail.alt}
        width={scenes.chartDetail.width}
        height={scenes.chartDetail.height}
        fetchpriority="high"
      />
    </div>
  </section>

  <section class="section booking-section">
    <div class="container">
      <div class="grid grid--2" style="align-items: start;">
        <div class="flow">
          <h2>Choose your reading</h2>
          <div
            class="booking-groups"
            data-booking-services
            data-services={JSON.stringify(serviceData)}
            data-service-map={JSON.stringify(serviceToEvent)}
          >
            {
              groups.map((g, gi) => (
                <fieldset
                  class:list={['booking-group', { 'booking-group--returning': gi === 1 }]}
                  data-group-index={gi}
                >
                  <legend>
                    {g.legend}
                    <span>{g.note}</span>
                  </legend>
                  <div class="booking-list">
                    {g.items.map((b) => (
                      <label class="choice choice--book">
                        <input
                          type="radio"
                          name="booking-service"
                          value={b.key}
                          checked={b.key === DEFAULT_BOOKING_EVENT}
                        />
                        <span class="choice__body">
                          <span class="choice__name">{b.name}</span>
                          <span class="choice__meta">
                            <span class="choice__tag">{b.duration}</span>
                            <a class="choice__details" href={`/readings/${b.service}/`}>
                              Details
                            </a>
                          </span>
                        </span>
                        {b.price && <span class="choice__price">{b.price}</span>}
                      </label>
                    ))}
                  </div>
                </fieldset>
              ))
            }
          </div>
          <p class="booking-mobile-next">
            <a class="btn btn--primary" href="#pick-a-time">Choose a time ↓</a>
          </p>
        </div>

        <div class="flow">
          <BookingEmbed calUser={calUser} />
          <div class="callout">
            <p style="margin: 0;">
              <strong>Before you book:</strong> for a first chart-based reading, have the birth date,
              birthplace, and birth time ready, as exact as you know it. If the time is uncertain or
              unknown, you can still book; <a href="/birth-time/">see your options</a>. Booking means
              you accept the <a href="/booking-policy/">booking policy</a> (cancellation,
              rescheduling, and recording details).
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>What happens after you book</h2>
      <ol class="grid grid--3" style="list-style: none; padding: 0;">
        {
          [
            ['Right away', 'Confirmation email with your appointment details and, when applicable, your session link, plus links to reschedule or cancel if needed.'],
            ['Before we meet', 'Preparation notes and a reminder: nothing to study, just a few ways to make the most of your session.'],
            ['Afterward', 'Your recording and a copy of your chart.'],
          ].map(([t, d]) => (
            <li class="card" style="gap: var(--space-2);">
              <h3 style="margin: 0; font-size: var(--text-lg);">{t}</h3>
              <p style="margin: 0;">{d}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</BaseLayout>

<script>
  const secondary = document.querySelector<HTMLFieldSetElement>('[data-group-index="1"]');
  if (secondary && window.matchMedia('(max-width: 767px)').matches) {
    requestAnimationFrame(() => {
      const checked = document.querySelector<HTMLInputElement>(
        'input[name="booking-service"]:checked'
      );
      if (checked && secondary.contains(checked)) return;
      secondary.dataset.collapsed = 'true';
      const legend = secondary.querySelector('legend');
      if (!legend) return;
      const toggle = document.createElement('button');
      toggle.type = 'button';
      toggle.className = 'booking-group__toggle';
      const count = secondary.querySelectorAll('input[name="booking-service"]').length;
      toggle.textContent = `Show ${count} follow-up readings ↓`;
      toggle.setAttribute('aria-expanded', 'false');
      const list = secondary.querySelector<HTMLElement>('.booking-list');
      if (!list) return;
      list.id = list.id || 'booking-list-returning';
      toggle.setAttribute('aria-controls', list.id);
      toggle.addEventListener('click', () => {
        const open = secondary.dataset.collapsed !== 'true';
        secondary.dataset.collapsed = open ? 'true' : 'false';
        toggle.setAttribute('aria-expanded', String(!open));
        toggle.textContent = open
          ? `Show ${count} follow-up readings ↓`
          : 'Hide follow-up readings ↑';
      });
      legend.after(toggle);
    });
  }
</script>

<style is:global>
  .booking-mobile-next {
    display: none;
  }

  @media (max-width: 767px) {
    .section.booking-section {
      padding-top: var(--space-4);
    }

    .booking-mobile-next {
      display: block;
      margin-top: var(--space-5);
    }

    .booking-mobile-next .btn {
      width: 100%;
    }

    fieldset.booking-group--returning {
      margin-top: var(--space-2);
      padding: var(--space-5);
      border: 1px solid rgb(15 110 107 / 0.3);
      border-radius: var(--radius-lg);
      background: var(--color-teal-tint);
    }

    fieldset.booking-group--returning > legend {
      width: 100%;
      margin-bottom: var(--space-2);
      font-family: var(--font-sans);
      font-size: var(--text-sm);
      font-weight: 800;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--color-teal);
    }

    fieldset.booking-group--returning > legend span {
      margin-top: var(--space-2);
      font-size: var(--text-base);
      line-height: var(--leading-body);
      font-weight: 600;
      letter-spacing: normal;
      text-transform: none;
      color: var(--ink);
    }

    fieldset.booking-group--returning .booking-group__toggle {
      width: 100%;
      justify-content: center;
      min-height: 52px;
      margin-top: var(--space-3);
      padding: var(--space-3) var(--space-4);
      border: 1px solid var(--color-teal);
      border-radius: var(--radius-md);
      background: var(--color-teal);
      color: #ffffff;
      box-shadow: 0 2px 10px rgb(15 110 107 / 0.22);
      font-size: var(--text-base);
      font-weight: 700;
    }

    fieldset.booking-group--returning .booking-group__toggle:hover,
    fieldset.booking-group--returning .booking-group__toggle:focus-visible {
      background: var(--color-teal-deep);
      color: #ffffff;
    }

    fieldset.booking-group--returning:not([data-collapsed='true']) .booking-list {
      margin-top: var(--space-4);
    }
  }
</style>
