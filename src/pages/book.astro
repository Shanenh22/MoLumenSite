---
import { getCollection } from 'astro:content';
import { photos, scenes } from '../config/images';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { site } from '../config/site';
import BookingEmbed from '../components/BookingEmbed.astro';

const services = (await getCollection('services')).filter((s) => s.data.available);
const calUser = site.integrations.calcomUsername;
const crumbs = [{ label: 'Book a Reading', href: '/book/' }];
/**
 * One entry per Cal.com event type, not per service. Readings sold at more
 * than one length (natal 60/90, the clarity follow-up) become separate
 * choices in the list rather than hiding a second picker behind a selection —
 * the price differs, so it is a different thing being bought.
 */
const bookables = services.flatMap((s) =>
  s.data.options.length > 1
    ? s.data.options.map((o) => ({
        key: o.bookingEventId || s.data.bookingEventId,
        service: s.data.slug,
        name: `${s.data.shortName} — ${o.label}`,
        duration: o.durationLabel,
        price: s.data.priceConfirmed ? `$${o.price}` : null,
        event: o.bookingEventId || s.data.bookingEventId,
        audience: s.data.audience,
        note: o.note ?? '',
      }))
    : [
        {
          key: s.data.slug,
          service: s.data.slug,
          name: s.data.name,
          duration: s.data.durationLabel,
          price:
            s.data.priceConfirmed && s.data.price
              ? (s.data.priceLabel ?? `$${s.data.price}`)
              : null,
          event: s.data.bookingEventId,
          audience: s.data.audience,
          note: '',
        },
      ]
);
const serviceData = Object.fromEntries(bookables.map((b) => [b.key, b]));

/**
 * Service slug -> default event key.
 *
 * The Reading Finder recommends by SERVICE slug ("want-more-clarity") while
 * the booking radios are keyed by Cal.com EVENT ("clarity-3mo"). Those two
 * vocabularies diverged when multi-price readings became separate rows, and
 * the old prefix match silently sent "want-more-clarity" to natal-90 — the
 * $200 new-client reading — for anyone asking about a follow-up.
 * Built from the data so it cannot drift again.
 */
const serviceToEvent = Object.fromEntries(
  services.map((sv) => {
    const first = bookables.find((b) => b.service === sv.data.slug);
    return [sv.data.slug, first?.key ?? sv.data.bookingEventId];
  })
);

/**
 * Split by who may book. A first-time visitor should see the three readings
 * actually open to them, not scan nine and work out which say "established
 * clients". Same radio group name across both fieldsets, so it stays one
 * choice.
 */
const firstReadings = bookables.filter((b) => b.audience !== 'established');
const returningReadings = bookables.filter((b) => b.audience === 'established');
const groups = [
  {
    legend: 'Your first reading with Mo',
    note: 'Open to everyone. Start here if you have not had a reading before.',
    items: firstReadings,
  },
  {
    legend: 'For returning clients',
    note: 'These follow on from a natal reading you have already had.',
    items: returningReadings,
  },
].filter((g) => g.items.length > 0);
---

<BaseLayout
  title="Book a Reading"
  description="Choose your reading, pick a time in your own time zone, and pay securely online. Booking with Mo Lumen Astrology takes about two minutes."
  path="/book/"
  breadcrumbs={crumbs}
>
  <Breadcrumbs crumbs={crumbs} />
  <section class="hero hero--split">
    <div class="container">
      <div>
      <p class="eyebrow">Let's meet</p>
      <h1>Book a reading</h1>
      <p class="lede">
        I'd love to connect you with the life-enhancing tool of astrology. Choose a reading below —
        times display in your own time zone, payment is secure, and you'll get confirmation,
        preparation notes, and a reminder by email.
      </p>
      </div>
      <img
        class="hero__img"
        src={scenes.chartDetail.src}
        alt={scenes.chartDetail.alt}
        width={scenes.chartDetail.width}
        height={scenes.chartDetail.height}
        fetchpriority="high"
      />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="grid grid--2" style="align-items: start;">
        <div class="flow">
          <h2>Choose your reading</h2>
          <div
            class="booking-groups"
            data-booking-services
            data-services={JSON.stringify(serviceData)}
            data-service-map={JSON.stringify(serviceToEvent)}
          >
            {
              groups.map((g) => (
                <fieldset class="booking-group">
                  <legend>
                    {g.legend}
                    <span>{g.note}</span>
                  </legend>
                  <div class="booking-list">
                    {g.items.map((b) => (
                      <label class="choice choice--book">
                        <input
                          type="radio"
                          name="booking-service"
                          value={b.key}
                          checked={b.key === firstReadings[0]?.key}
                        />
                        <span class="choice__body">
                          <span class="choice__name">{b.name}</span>
                          <span class="choice__meta">
                            <span class="choice__tag">{b.duration}</span>
                            <a class="choice__details" href={`/readings/${b.service}/`}>
                              Details
                            </a>
                          </span>
                        </span>
                        {b.price && <span class="choice__price">{b.price}</span>}
                      </label>
                    ))}
                  </div>
                </fieldset>
              ))
            }
          </div>
        </div>

        <div class="flow">
          <BookingEmbed calUser={calUser} services={serviceData} />
          <div class="callout">
            <p style="margin: 0;">
              <strong>Before you book:</strong> live readings need your birth date, exact time, and
              place — <a href="/prepare-for-your-reading/">here's why and how to find them</a>.
              Booking means you accept the <a href="/booking-policy/">booking policy</a>
              (cancellation, rescheduling, and recording details).
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>What happens after you book</h2>
      <ol class="grid grid--3" style="list-style: none; padding: 0;">
        {
          [
            ['Right away', 'Confirmation email with your session link and a calendar invite.'],
            ['Before we meet', 'Preparation notes and a reminder — nothing to study, just how to get the most from your hour.'],
            ['Afterward', 'Your recording and chart, plus rescheduling links if life intervenes.'],
          ].map(([t, d]) => (
            <li class="card" style="gap: var(--space-2);">
              <h3 style="margin: 0; font-size: var(--text-lg);">{t}</h3>
              <p style="margin: 0;">{d}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</BaseLayout>


