---
import { site } from '../config/site';
import pageDates from '../data/page-dates.json';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

export interface Breadcrumb {
  label: string;
  href: string;
}
interface Props {
  title: string;
  description: string;
  /** Path beginning and ending with '/'; used for canonical URL. */
  path: string;
  breadcrumbs?: Breadcrumb[];
  ogType?: 'website' | 'article';
  publishedDate?: Date;
  updatedDate?: Date;
  /** Extra JSON-LD objects for this page. */
  schema?: object[];
  noindex?: boolean;
}
const {
  title,
  description,
  path,
  breadcrumbs = [],
  ogType = 'website',
  publishedDate,
  updatedDate,
  schema = [],
  noindex = false,
} = Astro.props;

const canonical = new URL(path, site.url).href;

/** Keep titles under ~60 chars so search results don't truncate mid-word. */
function buildTitle(t: string): string {
  if (path === '/') return `${site.name} — ${site.tagline}`;
  const full = `${t} | ${site.name}`;
  if (full.length <= 60) return full;
  const short = `${t} | Mo Lumen`;
  if (short.length <= 60) return short;
  return t.length <= 60 ? t : t.slice(0, 57).replace(/\s+\S*$/, '') + '…';
}
/** Clamp meta descriptions to ~155 chars at a word boundary. */
function clampDesc(d: string): string {
  const t = d.replace(/\s+/g, ' ').trim();
  if (t.length <= 158) return t;
  return t.slice(0, 155).replace(/[\s,;:—-]+\S*$/, '') + '…';
}
const fullTitle = buildTitle(title);
const metaDescription = clampDesc(description);
const ogImage = new URL('/og-default.svg', site.url).href;

/**
 * Real last-modified date for this route, from git history via
 * scripts/gen-page-dates.mjs. An explicit updatedDate prop (content
 * frontmatter) always wins. If neither exists the page ships without a date —
 * we never invent one.
 */
function resolveModified(): string | null {
  if (updatedDate) return updatedDate.toISOString();
  const exact = (pageDates.exact as Record<string, string>)[path];
  if (exact) return exact;
  const families = Object.entries(pageDates.prefix as Record<string, string>)
    .filter(([p]) => path.startsWith(p))
    .sort((a, b) => b[0].length - a[0].length);
  return families.length ? families[0][1] : null;
}
const dateModified = resolveModified();

/** Mo as a resolvable entity — engines cite sources they can attribute. */
const moPerson = {
  '@type': 'Person',
  name: 'Maureen "Mo" Lumen',
  jobTitle: 'Astrologer',
  url: new URL('/about/', site.url).href,
  sameAs: [site.social.instagram, site.social.facebook, site.social.youtube].filter(Boolean),
  knowsAbout: [
    'Astrology',
    'Natal chart interpretation',
    'Traditional astrology',
    'Horary astrology',
    'Electional astrology',
    'Astrological transits',
  ],
  worksFor: { '@type': 'ProfessionalService', name: site.name, url: site.url },
};

const baseSchema: object[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'ProfessionalService',
    name: site.name,
    url: site.url,
    email: site.email,
    description: site.description,
    areaServed: [
      { '@type': 'AdministrativeArea', name: 'Worldwide (online)' },
      { '@type': 'City', name: 'Dallas–Fort Worth, Texas (in person, by arrangement)' },
    ],
    founder: moPerson,
    employee: moPerson,
    sameAs: [site.social.instagram, site.social.facebook, site.social.youtube].filter(Boolean),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: site.name,
    url: site.url,
    publisher: { '@type': 'Organization', name: site.name, url: site.url },
  },
];

/**
 * Reference and editorial pages get an Article so their freshness and
 * authorship are machine-readable. Skipped where the page already supplies its
 * own article-ish type (blog posts emit BlogPosting) and on transactional or
 * legal pages, where Article would be a misdescription.
 */
const ARTICLE_PREFIXES = ['/explore/', '/start-here/', '/current-sky/', '/horoscopes/', '/approach/'];
const suppliesOwnArticle = JSON.stringify(schema).includes('"BlogPosting"')
  || JSON.stringify(schema).includes('"Article"');
if (
  dateModified &&
  !suppliesOwnArticle &&
  ARTICLE_PREFIXES.some((p) => path === p || path.startsWith(p))
) {
  baseSchema.push({
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: title,
    description: metaDescription,
    mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
    author: moPerson,
    publisher: { '@type': 'Organization', name: site.name, url: site.url },
    dateModified,
    ...(publishedDate ? { datePublished: publishedDate.toISOString() } : {}),
    inLanguage: 'en-US',
    isAccessibleForFree: true,
  });
} else if (dateModified && !suppliesOwnArticle) {
  // Service, booking and legal pages are not articles — describing them as one
  // would be a lie to the crawler. They still deserve a freshness signal, so
  // they get a WebPage node carrying the same real date.
  baseSchema.push({
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: title,
    description: metaDescription,
    url: canonical,
    dateModified,
    inLanguage: 'en-US',
    isPartOf: { '@type': 'WebSite', name: site.name, url: site.url },
    ...(path === '/' ? {} : { publisher: { '@type': 'Organization', name: site.name, url: site.url } }),
  });
}
if (breadcrumbs.length > 0) {
  baseSchema.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [{ label: 'Home', href: '/' }, ...breadcrumbs].map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: c.label,
      item: new URL(c.href, site.url).href,
    })),
  });
}
const allSchema = [...baseSchema, ...schema];
const ga4Id = site.integrations.ga4Id;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} — Current Sky & Articles`} href="/rss.xml" />
    <meta name="theme-color" content="#1e2a45" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    {publishedDate && <meta property="article:published_time" content={publishedDate.toISOString()} />}
    {dateModified && <meta property="article:modified_time" content={dateModified} />}
    <script type="application/ld+json" set:html={JSON.stringify(allSchema)} />
    {
      ga4Id && (
        <>
          <script async src={`https://www.googletagmanager.com/gtag/js?id=${ga4Id}`} />
          <script
            set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','${ga4Id}',{anonymize_ip:true});`}
          />
        </>
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
