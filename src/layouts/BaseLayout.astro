---
import { site } from '../config/site';
import pageDates from '../data/page-dates.json';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import '../styles/global.css';

export interface Breadcrumb {
  label: string;
  href: string;
}
interface Props {
  /** Absolute-from-root path to a raster share image, e.g. /images/natal-reading.webp */
  shareImage?: string;
  title: string;
  description: string;
  /** Path beginning and ending with '/'; used for canonical URL. */
  path: string;
  breadcrumbs?: Breadcrumb[];
  ogType?: 'website' | 'article';
  publishedDate?: Date;
  updatedDate?: Date;
  /** Extra JSON-LD objects for this page. */
  schema?: object[];
  noindex?: boolean;
}
/**
 * No `preloadImage` prop, and that is a measured decision rather than an
 * omission.
 *
 * Lighthouse flags the homepage hero as neither discoverable nor
 * priority-hinted, because it is painted from a CSS custom property that the
 * preload scanner cannot see. The obvious fix is a `<link rel="preload">`, so
 * it was built and measured on one machine with the project's own
 * `npm run audit:lh`:
 *
 *   without preload   mobile P:94  LCP 3.0s   desktop P:100  LCP 0.7s
 *   with preload      mobile P:93  LCP 3.2s   desktop P:99   LCP 0.9s
 *
 * It did not help, and if anything competed with the stylesheet for bandwidth
 * on a throttled connection. Shipping it would have been a "performance
 * improvement" that made the number worse, justified by an audit label rather
 * than by a measurement.
 *
 * The homepage mobile LCP of ~3.0s is real and worth fixing — every other page
 * measures 1.7–2.3s. The hero file is only 56KB, so the cause is more likely
 * the overall weight of a 12-section page than that one image. The next thing
 * to try is viewport-based hero variants (the 640/960/1280 copies already
 * exist) rather than another preload. Measure it the same way before keeping it.
 */
const {
  title,
  description,
  path,
  breadcrumbs = [],
  ogType = 'website',
  publishedDate,
  updatedDate,
  schema = [],
  noindex = false,
  shareImage,
} = Astro.props;

const canonical = new URL(path, site.url).href;

/** Keep titles under ~60 chars so search results don't truncate mid-word. */
function buildTitle(t: string): string {
  if (path === '/') return `${site.name} | ${site.tagline}`;
  const full = `${t} | ${site.name}`;
  if (full.length <= 60) return full;
  const short = `${t} | Mo Lumen`;
  if (short.length <= 60) return short;
  return t.length <= 60 ? t : t.slice(0, 57).replace(/\s+\S*$/, '') + '…';
}
/** Clamp meta descriptions to ~155 chars at a word boundary. */
function clampDesc(d: string): string {
  const t = d.replace(/\s+/g, ' ').trim();
  if (t.length <= 158) return t;
  return t.slice(0, 155).replace(/[\s,;:—-]+\S*$/, '') + '…';
}
const fullTitle = buildTitle(title);
const metaDescription = clampDesc(description);
/**
 * Share image. Must be a raster format — Facebook, LinkedIn, X, WhatsApp and
 * Slack all refuse to render an SVG og:image, so the previous og-default.svg
 * meant every share of this site appeared with no picture at all.
 * Pages that pass their own image use it; everything else gets the branded
 * 1200x630 default.
 */
const ogImage = new URL(shareImage ?? '/og-default.png', site.url).href;

/**
 * Real last-modified date for this route, from git history via
 * scripts/gen-page-dates.mjs. An explicit updatedDate prop (content
 * frontmatter) always wins. If neither exists the page ships without a date —
 * we never invent one.
 */
function resolveModified(): string | null {
  if (updatedDate) return updatedDate.toISOString();
  const exact = (pageDates.exact as Record<string, string>)[path];
  if (exact) return exact;
  const families = Object.entries(pageDates.prefix as Record<string, string>)
    .filter(([p]) => path.startsWith(p))
    .sort((a, b) => b[0].length - a[0].length);
  return families.length ? families[0][1] : null;
}
const dateModified = resolveModified();

/**
 * Mo as a resolvable entity. Keep this practice-led and broad: structured data
 * should describe what she actually works with without classifying her into a
 * single astrological school.
 */
const moPerson = {
  '@type': 'Person',
  name: 'Maureen "Mo" Lumen',
  jobTitle: 'Astrologer',
  url: new URL('/about/', site.url).href,
  sameAs: [site.social.instagram, site.social.facebook, site.social.youtube].filter(Boolean),
  knowsAbout: [
    'Astrology',
    'Astrological chart interpretation',
    'Astrological synthesis',
    'Natal astrology',
    'Horary astrology',
    'Astrological transits and timing',
  ],
  worksFor: { '@type': 'ProfessionalService', name: site.name, url: site.url },
};

const baseSchema: object[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'ProfessionalService',
    name: site.name,
    url: site.url,
    email: site.email,
    description: site.description,
    /**
     * Two entries because the practice genuinely has two service areas: online
     * everywhere, and in person in DFW by arrangement. The in-person offer is
     * not a schema-only claim — it is stated in the FAQs, /how-readings-work/,
     * the terms, and the privacy policy, the last two owner-approved. Schema
     * has to agree with the visible page or it is the schema that is wrong.
     *
     * The `address` block is separate and says something different: where the
     * practice is *based*, which Shane confirmed on 2026-08-05 and is backing
     * with a Google Business Profile. Being based somewhere and serving
     * somewhere are different claims, so they live in different properties.
     */
    areaServed: [
      { '@type': 'AdministrativeArea', name: 'Worldwide (online)' },
      { '@type': 'AdministrativeArea', name: 'Dallas–Fort Worth Metroplex, Texas' },
    ],
    address: {
      '@type': 'PostalAddress',
      addressRegion: 'TX',
      addressCountry: 'US',
      addressLocality: 'Dallas–Fort Worth Metroplex',
    },
    founder: moPerson,
    employee: moPerson,
    sameAs: [site.social.instagram, site.social.facebook, site.social.youtube].filter(Boolean),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: site.name,
    url: site.url,
    publisher: { '@type': 'Organization', name: site.name, url: site.url },
  },
];

/**
 * Only genuinely editorial/reference pages get Article schema. Hubs,
 * calendars, archives, glossaries and reference indexes are collection or
 * navigation experiences, not authored articles, even when they live under an
 * editorial URL prefix. Those pages still get a WebPage node and a real
 * dateModified below.
 */
const ARTICLE_EXACT = new Set([
  '/start-here/',
  '/approach/',
  '/current-sky/the-sky-in-2026/',
]);
const EXPLORE_COLLECTIONS = new Set([
  '/explore/',
  '/explore/glossary/',
  '/explore/planets/',
  '/explore/signs/',
  '/explore/houses/',
  '/explore/aspects/',
]);
const isArticleLike =
  ARTICLE_EXACT.has(path) ||
  path.startsWith('/current-sky/events/') ||
  (path.startsWith('/explore/') && !EXPLORE_COLLECTIONS.has(path));
const serializedSchema = JSON.stringify(schema);
const suppliesOwnArticle =
  serializedSchema.includes('"BlogPosting"') || serializedSchema.includes('"Article"');
const usesArticleMetadata = ogType === 'article' || suppliesOwnArticle || isArticleLike;
const effectiveOgType: 'website' | 'article' = usesArticleMetadata ? 'article' : ogType;

if (dateModified && !suppliesOwnArticle && isArticleLike) {
  baseSchema.push({
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: title,
    description: metaDescription,
    mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
    author: moPerson,
    publisher: { '@type': 'Organization', name: site.name, url: site.url },
    dateModified,
    ...(publishedDate ? { datePublished: publishedDate.toISOString() } : {}),
    inLanguage: 'en-US',
    isAccessibleForFree: true,
  });
} else if (dateModified && !suppliesOwnArticle) {
  // Non-article pages still deserve a freshness signal, so they get a WebPage
  // node carrying the same real date rather than a misleading Article.
  baseSchema.push({
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: title,
    description: metaDescription,
    url: canonical,
    dateModified,
    inLanguage: 'en-US',
    isPartOf: { '@type': 'WebSite', name: site.name, url: site.url },
    ...(path === '/' ? {} : { publisher: { '@type': 'Organization', name: site.name, url: site.url } }),
  });
}
if (breadcrumbs.length > 0) {
  baseSchema.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [{ label: 'Home', href: '/' }, ...breadcrumbs].map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: c.label,
      item: new URL(c.href, site.url).href,
    })),
  });
}
const allSchema = [...baseSchema, ...schema];
const ga4Id = site.integrations.ga4Id;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonical} />
    {site.verification.google && (
      <meta name="google-site-verification" content={site.verification.google} />
    )}
    {site.verification.bing && <meta name="msvalidate.01" content={site.verification.bing} />}
    {site.verification.pinterest && (
      <meta name="p:domain_verify" content={site.verification.pinterest} />
    )}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name}: Current Sky & Articles`} href="/rss.xml" />
    <meta name="theme-color" content="#1e2a45" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={effectiveOgType} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={fullTitle} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    {usesArticleMetadata && publishedDate && <meta property="article:published_time" content={publishedDate.toISOString()} />}
    {usesArticleMetadata && dateModified && <meta property="article:modified_time" content={dateModified} />}
    <script is:inline type="application/ld+json" set:html={JSON.stringify(allSchema)} />
    {
      ga4Id && (
        <>
          <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${ga4Id}`} />
          {/*
            Order inside this one script is load-bearing, which is why it is a
            single block rather than several tidy ones. `gtag('consent',
            'default', …)` MUST reach dataLayer before `gtag('config', …)`. If
            the config lands first, the very first page_view is sent under the
            implicit default of granted, a cookie is written, and the visitor
            has been measured before being asked. The async loader above does
            not affect this: it only defines the processor, and dataLayer order
            is what decides behaviour.

            `anonymize_ip` used to be set on the config call. It is a Universal
            Analytics parameter and does nothing in GA4 — IP anonymisation is
            always on and cannot be switched off — so it read as a privacy
            measure while being inert. The two flags that replaced it do have an
            effect: no cross-device/Google-account linking, and no advertising
            personalisation. That is what makes this measurement rather than
            adtech, which is the claim /privacy/ makes.

            Everything starts denied. Consent Mode upgrades `analytics_storage`
            in two places: synchronously below if this browser already said yes
            (so a returning visitor is not re-counted as a stranger while the
            banner script is still parsing), and from the banner on click.
            Denied is not silent — GA4 still sends a cookieless ping, so
            aggregate page counts survive a refusal while nothing is stored.
          */}
          <script
            is:inline
            set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('consent','default',{ad_storage:'denied',ad_user_data:'denied',ad_personalization:'denied',analytics_storage:'denied',functionality_storage:'granted',security_storage:'granted'});try{if(localStorage.getItem('ml-consent-v1')==='granted')gtag('consent','update',{analytics_storage:'granted'});}catch(e){}gtag('js',new Date());gtag('config','${ga4Id}',{allow_google_signals:false,allow_ad_personalization_signals:false});`}
          />
        </>
      )
    }
    {/*
      One tracking entry point for the whole site: `window.mlTrack(name, params)`.

      Defined unconditionally, even when GA4 is not configured, so that every
      caller can fire and forget. Components must never test for gtag
      themselves — that is how the Reading Finder ended up with four events
      that silently never fired for months behind an optional-call operator.
      With a real helper the call site stays honest and the no-op lives in
      exactly one place.

      The sanitiser is the important part. This site handles birth dates, birth
      times and birth places, and none of it may ever reach an analytics
      vendor. Rather than trusting every future call site to remember that,
      anything resembling an email address or a run of digits long enough to be
      a date or a time is dropped here, and values are capped at 100 chars.
      Parameters are meant to be short enumerated labels like "natal-90" or
      "exploring", so anything longer is a mistake worth losing.
    */}
    <script
      is:inline
      set:html={`
      (function () {
        var EMAIL = /[^\\s@]+@[^\\s@]+\\.[^\\s@]+/;
        var DIGITS = /\\d{4,}|\\d{1,2}[:/-]\\d{1,2}/;
        function clean(params) {
          var out = {};
          if (!params) return out;
          for (var k in params) {
            if (!Object.prototype.hasOwnProperty.call(params, k)) continue;
            var v = params[k];
            if (typeof v === 'number' || typeof v === 'boolean') { out[k] = v; continue; }
            if (typeof v !== 'string') continue;
            if (EMAIL.test(v) || DIGITS.test(v)) continue;
            out[k] = v.slice(0, 100);
          }
          return out;
        }
        window.mlTrack = function (name, params) {
          try {
            if (typeof window.gtag !== 'function') return;
            window.gtag('event', name, clean(params));
          } catch (e) { /* analytics must never break a page */ }
        };

        /**
         * Every route into the booking funnel, measured once, here.
         *
         * Booking links live on the homepage, seven reading pages, the readings
         * hub cards, the comparison table, the Reading Finder result and the
         * shared CTA band. Instrumenting them individually would guarantee the
         * next one added is the one nobody remembers to wire, so this is a
         * single delegated listener instead.
         *
         * The service param is the Cal.com event key: an enumerated internal
         * label such as natal-90, never anything about the visitor. The from
         * param is the pathname, so the funnel can be attributed to the page
         * that produced it.
         *
         * NOTE: no backticks anywhere inside this script. The whole block is a
         * template literal, so one backtick in a comment closes the string and
         * the rest of the file is parsed as code. That is what broke this build
         * once already.
         */
        document.addEventListener('click', function (e) {
          var a = e.target instanceof Element ? e.target.closest('a[href*="/book/"]') : null;
          if (!a) return;
          var href = a.getAttribute('href') || '';
          var m = href.match(/[?&]service=([^&#]+)/);
          window.mlTrack('booking_cta_click', {
            service: m ? decodeURIComponent(m[1]) : 'unspecified',
            from: location.pathname
          });
        });
      })();
      `}
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    {/*
      Second in the body, immediately after the bypass link, even though it is
      pinned to the bottom of the screen. A keyboard or screen-reader user
      should meet the consent choice in the first couple of tabs rather than
      after every nav item and half the page — and `position: fixed` means DOM
      order costs nothing visually.
    */}
    <ConsentBanner />
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
