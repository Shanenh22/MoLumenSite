# ============================================================
# Mo Lumen Astrology — environment configuration
# Copy to .env for local development. In Cloudflare Pages, set
# these under Settings → Environment variables (staging and
# production separately). NEVER commit real values or secrets.
# All variables are optional: the site builds and runs with
# none of them set (integrations gracefully disable).
# ============================================================

# Canonical site URL for the current deployment.
# Production: https://molumen.com   Staging: your *.pages.dev URL
PUBLIC_SITE_URL=https://molumen.com

# Google Analytics 4 measurement ID (G-XXXXXXXXXX).
# Leave empty to disable analytics entirely (default).
PUBLIC_GA4_ID=

# Cal.com username that owns the booking event types.
# Used to build embed and fallback URLs: https://cal.com/<username>/<event>
PUBLIC_CALCOM_USERNAME=

# MailerLite: form/group identifier for newsletter signups.
# Found in MailerLite → Forms → embedded form settings.
PUBLIC_MAILERLITE_FORM_ID=

# YouTube channel ID (UC…) and optional uploads/featured playlist ID.
PUBLIC_YOUTUBE_CHANNEL_ID=
PUBLIC_YOUTUBE_PLAYLIST_ID=

# Instagram profile handle (without @) for outbound video links.
PUBLIC_INSTAGRAM_HANDLE=mo.lumen

# ------------------------------------------------------------
# NOTE: No secret keys belong in this project at all.
# Stripe is connected inside Cal.com (server-side on their end);
# the static site never touches Stripe credentials.
# ------------------------------------------------------------
