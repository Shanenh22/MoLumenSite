# ============================================================
# Mo Lumen Astrology — environment configuration
# Copy to .env for local development. In Cloudflare, set values
# for the relevant staging/production deployment environment.
# NEVER commit real secret values. Public integration IDs below
# are safe to expose because they already appear in browser URLs/code.
# ============================================================

# Canonical site URL for the current deployment.
# Production: https://molumen.com
PUBLIC_SITE_URL=https://molumen.com

# Google Analytics 4 measurement ID (G-XXXXXXXXXX).
# Leave empty to disable analytics entirely.
PUBLIC_GA4_ID=

# Cal.com username that owns the booking event types.
# Used to build embed and fallback URLs: https://cal.com/<username>/<event>
PUBLIC_CALCOM_USERNAME=molumen

# Kit newsletter form. The defaults in src/config/site.ts are the current
# MoLumen form, so these overrides normally can be left unset.
PUBLIC_KIT_FORM_UID=aa0e899cd0
PUBLIC_KIT_FORM_SCRIPT_URL=https://molumen.kit.com/aa0e899cd0/index.js

# YouTube channel ID (UC…) and optional uploads/featured playlist ID.
# The public channel URL itself is stored in src/config/site.ts.
PUBLIC_YOUTUBE_CHANNEL_ID=
PUBLIC_YOUTUBE_PLAYLIST_ID=

# Instagram profile handle (without @) for outbound video links.
PUBLIC_INSTAGRAM_HANDLE=mo.lumen

# Search-engine/site verification tokens — token value only, not the whole tag.
PUBLIC_GOOGLE_SITE_VERIFICATION=
PUBLIC_BING_SITE_VERIFICATION=
PUBLIC_PINTEREST_VERIFICATION=

# ------------------------------------------------------------
# NOTE: No Stripe secret keys belong in this static project.
# Stripe is connected inside Cal.com on their server-side integration.
# ------------------------------------------------------------

# Mo's ~60-second welcome video. Paste ONLY the YouTube video ID (the part
# after v= or youtu.be/), not the full URL. While this is empty, /about/ and
# the homepage render nothing at all rather than a dead player.
PUBLIC_WELCOME_VIDEO_ID=
# Optional locally hosted poster so no request reaches Google before the
# visitor presses play, e.g. /images/uploads/mo-welcome.webp
PUBLIC_WELCOME_VIDEO_POSTER=
